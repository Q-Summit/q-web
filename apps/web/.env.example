# Local Astro. Copy to .env (gitignored).
# Astro loads this automatically for `astro dev` / `astro build`.

CONTENT_SOURCE=cms
CMS_URL=http://localhost:3000
PUBLIC_CMS_URL=http://localhost:3000

# Optional JSON mode (builds from the committed fake fixture):
# CONTENT_SOURCE=

# PostHog (docs/dev/analytics.md). Leave unset locally: even with a key the
# client only collects on the production hostnames (fail-safe allowlist).
# PUBLIC_POSTHOG_KEY=
# PUBLIC_POSTHOG_HOST=
