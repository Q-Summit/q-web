---
// One audience section of the Why Q page: a centered .section-header
// (heading + intro) above a photo block, with alternating highlight items
// beside the photo where the source content has them. This deliberately
// departs from the live site's left/right-aligned why-q_feature-3
// (image right) and why-q_feature-4 (image left) heading placement, per
// the "centralize the whyq headings" request: the live page's alternating
// heading position reads as visually noisy, so the heading always centers
// while the image keeps its left/right rhythm below it.
import { Picture } from "../../lib/astro-assets";
import type { ImageMetadata } from "astro";
import Section from "../ui/Section.astro";
import Container from "../ui/Container.astro";

export interface FeatureItem {
  title: string;
  description: string;
}

export interface FeatureImage {
  /** Path prefix under /media, e.g. "/media/whyq-attendees" (legacy
   * plain-<img> fallback, used when `asset` below is undefined). */
  base: string;
  ext: "webp" | "jpg";
  /** Intrinsic size of the 800w variant, for layout-shift-free loading. */
  width: number;
  height: number;
  alt: string;
  /** astro:assets pipeline image (see src/lib/images.ts); when present,
   * this renders through <Picture> instead of the plain fallback <img>. */
  asset?: ImageMetadata;
}

interface Props {
  id: string;
  heading: string;
  paragraph: string;
  items?: FeatureItem[];
  image: FeatureImage;
  imageLeft?: boolean;
  /** This section's image is the page's LCP candidate (the first audience
   * section on /whyq): load eagerly at high priority instead of lazily. */
  eager?: boolean;
}

const {
  id,
  heading,
  paragraph,
  items = [],
  image,
  imageLeft = false,
  eager = false,
} = Astro.props;

const src = `${image.base}-800.${image.ext}`;
const srcset = [500, 800, 1080]
  .map((w) => `${image.base}-${w}.${image.ext} ${w}w`)
  .join(", ");
---

<Section small id={id}>
  <Container>
    <div class="section-header feature-header">
      <h2>{heading}</h2>
      <p>{paragraph}</p>
    </div>
    {
      items.length > 0 ? (
        <div class:list={["feature-grid", { "image-left": imageLeft }]}>
          <div class="feature-text">
            <ul class="feature-items" role="list">
              {items.map((item) => (
                <li>
                  <h3>{item.title}</h3>
                  <p>{item.description}</p>
                </li>
              ))}
            </ul>
          </div>
          <div class="feature-image-wrapper">
            {image.asset ? (
              <Picture
                src={image.asset}
                alt={image.alt}
                widths={[500, 800, 1080]}
                sizes="(max-width: 767px) 90vw, (max-width: 1360px) 44vw, 36.25rem"
                formats={["avif", "webp"]}
                fallbackFormat="jpg"
                quality={80}
                loading={eager ? "eager" : "lazy"}
                fetchpriority={eager ? "high" : undefined}
                decoding="async"
              />
            ) : (
              <img
                src={src}
                srcset={srcset}
                sizes="(max-width: 767px) 90vw, (max-width: 1360px) 44vw, 36.25rem"
                width={image.width}
                height={image.height}
                alt={image.alt}
                loading={eager ? "eager" : "lazy"}
                fetchpriority={eager ? "high" : undefined}
                decoding="async"
              />
            )}
          </div>
        </div>
      ) : image.asset ? (
        <div class="feature-image-wrapper feature-image-solo">
          <Picture
            src={image.asset}
            alt={image.alt}
            widths={[500, 800, 1080]}
            sizes="(max-width: 767px) 90vw, 40rem"
            formats={["avif", "webp"]}
            fallbackFormat="jpg"
            quality={80}
            loading={eager ? "eager" : "lazy"}
            fetchpriority={eager ? "high" : undefined}
            decoding="async"
          />
        </div>
      ) : (
        <div class="feature-image-wrapper feature-image-solo">
          <img
            src={src}
            srcset={srcset}
            sizes="(max-width: 767px) 90vw, 40rem"
            width={image.width}
            height={image.height}
            alt={image.alt}
            loading={eager ? "eager" : "lazy"}
            fetchpriority={eager ? "high" : undefined}
            decoding="async"
          />
        </div>
      )
    }
  </Container>
</Section>

<style>
  /* The page header above (whyq.astro's own .section-header) already sets
     the "why attend Q-Summit" intro at this size; matching it here keeps
     every intro paragraph on the page reading at one consistent scale. */
  .feature-header p {
    font-size: var(--text-size-medium);
  }

  .feature-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
    align-items: center;
  }

  @media (min-width: 768px) {
    .feature-grid {
      grid-template-columns: 1fr 1fr;
      gap: var(--space-xl);
    }

    .feature-grid.image-left .feature-image-wrapper {
      order: -1;
    }
  }

  @media (min-width: 992px) {
    .feature-grid {
      gap: 5rem;
    }
  }

  .feature-items {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-md);
    margin: 0;
    padding: var(--space-2xs) 0;
    list-style: none;
  }

  @media (max-width: 479px) {
    .feature-items {
      grid-template-columns: 1fr;
    }
  }

  /* The live layout renders these sub-labels ("Talent", "Trends") at h6
     scale rather than the default h3 size, so it is restated here. */
  .feature-items h3 {
    margin-bottom: var(--space-2xs);
    font-size: var(--heading-h6-size);
    line-height: var(--heading-line-height-loose);
  }

  .feature-items p {
    margin-bottom: 0;
  }

  .feature-image-wrapper {
    border-radius: var(--radius-card-large);
    overflow: hidden;
  }

  .feature-image-wrapper img,
  .feature-image-wrapper picture {
    display: block;
    width: 100%;
    height: auto;
  }

  .feature-image-wrapper img {
    object-fit: cover;
  }

  /* On mobile the grid image stacks above or below the items (DOM order),
     so a softer landscape crop reads better than the square desktop crop. */
  .feature-grid .feature-image-wrapper img,
  .feature-grid .feature-image-wrapper picture {
    aspect-ratio: 4 / 3;
  }

  @media (min-width: 768px) {
    .feature-grid .feature-image-wrapper img,
    .feature-grid .feature-image-wrapper picture {
      aspect-ratio: 1;
      height: 100%;
    }
  }

  /* No items to pair it with (e.g. the attendees section): the photo
     stands alone under the centered header, so it keeps its native
     landscape crop instead of the grid's square treatment and stays
     narrower than the full container for a calmer, text-measure-like
     width. */
  .feature-image-solo {
    max-width: var(--container-small);
    margin-inline: auto;
  }
</style>
