#!/bin/sh
# q-web pre-commit: fast local gate (docs + design).
# Activated by `pnpm run setup`.
#
# Runs `pnpm run check:fast` only so commits stay quick. App typecheck/build/
# tests run on pre-push (`pnpm run check`) and in CI. Agents must still run
# full `make check` / `pnpm run check` before finishing work.
#
# Known tradeoff: checks the WORKING TREE, not the staged snapshot.

pnpm run --silent check:fast || {
  echo "" >&2
  echo "pre-commit: check:fast failed. Run 'pnpm run format', then fix findings above." >&2
  exit 1
}
