---
// /job-listings/[slug]: static job detail pages, one per entry in the
// extracted jobs.json. Slugs come verbatim from the data so every legacy
// Webflow URL keeps working. On the 2027 navy (DESIGN.md NAVY-1): the
// company's logo on a white glass tile, company and role as the page's
// headline, location and workload, an Apply button; below, the job text on
// a sheet of white liquid glass with the "How to get in touch" block.
import Base from "../../layouts/Base.astro";
import JsonLd from "../../components/seo/JsonLd.astro";
import { getJobs, getPageContent, type Job } from "../../lib/content";
import { EVENTS } from "../../lib/analytics/events";
import { logoSrc } from "../../components/jobs/logo";
import IconMapPin from "../../components/icons/IconMapPin.astro";
import "../../components/ui/navy-glass.css";

export async function getStaticPaths() {
  const [jobs, { jobs: jobsPage }] = await Promise.all([
    getJobs(),
    getPageContent(),
  ]);
  // "<title> at <company>" is not unique across slugs: three partner listings
  // repost the same role (e.g. two Oliver Wyman "Consultant (m/f/d)" postings).
  // Count the base tags so we can disambiguate only the colliders and leave
  // every unique listing's title/description clean.
  const baseTagCounts = new Map<string, number>();
  for (const job of jobs) {
    const base = `${job.title} at ${job.company}`;
    baseTagCounts.set(base, (baseTagCounts.get(base) ?? 0) + 1);
  }
  return jobs.map((job) => {
    const baseTag = `${job.title} at ${job.company}`;
    // Prefer real location data; fall back to the (globally unique, self-
    // canonical) slug rather than inventing any facts, and only when the base
    // tag actually collides.
    const disambiguator =
      (baseTagCounts.get(baseTag) ?? 0) > 1 ? (job.location ?? job.slug) : null;
    return {
      params: { slug: job.slug },
      props: {
        job,
        howToContactHeading: jobsPage.detailHowToContactHeading,
        disambiguator,
      },
    };
  });
}

export interface Props {
  job: Job;
  howToContactHeading: string;
  disambiguator: string | null;
}

const { job, howToContactHeading, disambiguator } = Astro.props;

const baseTag = `${job.title} at ${job.company}`;
const metaTitle = disambiguator ? `${baseTag} (${disambiguator})` : baseTag;
const metaDescription = `${metaTitle}: a job listing from the Q-Summit partner network.`;

const isMailto = job.applyUrl.startsWith("mailto:");
const applyLabel = isMailto ? "Apply via Email" : "Apply Now";
const applyDisplay = isMailto
  ? job.applyUrl.slice("mailto:".length)
  : job.applyUrl;

// BreadcrumbList mirroring the visible breadcrumb. Item URLs are absolute and
// trailing-slashed to match canonicals/sitemap. All data is real (title,
// company, slug). No JobPosting: jobs.json has no datePosted and location is
// free-text/missing on most, so it would fail Google's required fields.
const breadcrumbLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: "Home",
      item: new URL("/", Astro.site).href,
    },
    {
      "@type": "ListItem",
      position: 2,
      name: "Job Listings",
      item: new URL("/job-listings/", Astro.site).href,
    },
    {
      "@type": "ListItem",
      position: 3,
      name: `${job.title} at ${job.company}`,
      item: new URL(`/job-listings/${job.slug}/`, Astro.site).href,
    },
  ],
};
---

{
  /* Base composes "<siteTitle> | <title>" centrally; this only supplies the
     page-specific half so job pages don't end up double-prefixed. */
}
<Base
  title={metaTitle}
  description={metaDescription}
  livePreviewGlobal="page-jobs"
  pageEvent={{
    name: EVENTS.job_listing_viewed,
    props: { job_title: job.title, company: job.company, slug: job.slug },
  }}
>
  <Fragment slot="jsonld">
    <JsonLd data={breadcrumbLd} />
  </Fragment>
  <div class="n-page">
    <div class="n-ground" aria-hidden="true"></div>
    <article class="job n-shell">
      <nav class="job-back" aria-label="Breadcrumb">
        <a class="h-btn back-btn" href="/job-listings/">
          <svg
            aria-hidden="true"
            width="14"
            height="14"
            viewBox="0 0 24 24"
            fill="none"
            xmlns="http://www.w3.org/2000/svg"
          >
            <path
              d="M15 19l-7-7 7-7"
              stroke="currentColor"
              stroke-width="2.5"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
          </svg>
          All job listings
        </a>
      </nav>

      <header class="job-header">
        <span class="logo-box n-white">
          <img
            src={logoSrc(job.logoFilename)}
            alt={`${job.company} logo`}
            width="480"
            height="240"
            loading="eager"
          />
        </span>
        <p class="job-company">{job.company}</p>
        <h1 class="job-title">{job.title}</h1>
        {
          (job.location || job.workload) && (
            <ul class="job-facts" role="list">
              {job.location && (
                <li class="fact">
                  <IconMapPin size={14} />
                  {job.location}
                </li>
              )}
              {job.workload && (
                <li>
                  <span class="fact-tag h-ice" data-workload={job.workload}>
                    {job.workload}
                  </span>
                </li>
              )}
            </ul>
          )
        }
        <a
          class="h-btn h-ice apply-btn"
          href={job.applyUrl}
          target={isMailto ? undefined : "_blank"}
          rel={isMailto ? undefined : "noopener noreferrer"}
          aria-label={isMailto
            ? undefined
            : `${applyLabel} (opens in a new tab)`}
          data-ph-event={EVENTS.job_application_started}
          data-ph-prop-job-title={job.title}
          data-ph-prop-company={job.company}
          data-ph-prop-apply-type={isMailto ? "email" : "url"}
        >
          {applyLabel}
          <svg
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            aria-hidden="true"
          >
            <path
              d="M5 12h14M13 6l6 6-6 6"
              stroke="currentColor"
              stroke-width="2.4"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
          </svg>
        </a>
      </header>

      <div class="job-sheet n-white">
        {
          /* The rich text (job.richTextHtml) opens with its own h3s
             ("What we do:", "About the role:", ...); without a heading
             between the h1 above and those h3s the outline skips a level
             (WCAG 1.3.1/2.4.6). This label is structural, not invented
             copy, and stays visually hidden. */
        }
        <h2 class="u-visually-hidden">About this role</h2>
        <div class="job-body" set:html={job.richTextHtml} />

        <footer class="job-apply">
          <h2>{howToContactHeading}</h2>
          <a
            class="h-btn h-ice apply-btn is-flat"
            href={job.applyUrl}
            target={isMailto ? undefined : "_blank"}
            rel={isMailto ? undefined : "noopener noreferrer"}
            aria-label={isMailto
              ? undefined
              : `${applyLabel} (opens in a new tab)`}
            data-ph-event={EVENTS.job_application_started}
            data-ph-prop-job-title={job.title}
            data-ph-prop-company={job.company}
            data-ph-prop-apply-type={isMailto ? "email" : "url"}
          >
            {applyLabel}
            <svg
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              aria-hidden="true"
            >
              <path
                d="M5 12h14M13 6l6 6-6 6"
                stroke="currentColor"
                stroke-width="2.4"
                stroke-linecap="round"
                stroke-linejoin="round"></path>
            </svg>
          </a>
          <p class="apply-target">{applyDisplay}</p>
        </footer>
      </div>
    </article>
    <div class="h-page-fade" aria-hidden="true"></div>
  </div>
</Base>

<style>
  /* DESIGN.md NAVY-1: a job's page on the 2027 navy. The page's own
     shell (LAYOUT-1, LAYOUT-3), display type above the heading scale
     (TYPE-1), glass depth instead of the --shadow-* steps (DEPTH-1), and
     the header's Tickets button (.h-btn .h-ice, COMP-6) for every button
     instead of .button (COMP-1). */
  .job {
    max-width: 54rem;
    padding-top: clamp(var(--space-lg), 5vw, 3.5rem);
    padding-bottom: clamp(6rem, 14vh, 10rem);
  }

  /* The Tickets button's shape and size (HomeHeader .hh-tickets). */
  .h-btn.back-btn,
  .h-btn.apply-btn {
    min-height: 2.75rem;
    padding: 0 1.25rem;
    font-size: var(--text-size-tiny);
  }

  /* "All job listings": the Tickets button in solid white glass: a white
     body, a lit top line, ice-grey shading in its foot and the same short
     drop shadow. Its chevron points back, so it never nudges forward. */
  .back-btn {
    --hg-fill: linear-gradient(
      180deg,
      var(--color-white) 0%,
      var(--color-white) 50%,
      color-mix(in srgb, var(--color-white) 82%, var(--color-ticket-ice)) 100%
    );
    --hg-ink: var(--color-navy);
    --hg-ink-shadow: none;
    --hg-icon-shadow: none;
    --hg-shadow:
      inset 0 1px 1px var(--color-white),
      inset 0 -1px 2px
        color-mix(in srgb, var(--color-ticket-sky) 30%, transparent),
      inset 0 -12px 18px -12px
        color-mix(
          in srgb,
          color-mix(in srgb, var(--color-ticket-sky) 40%, var(--color-white))
            85%,
          transparent
        ),
      0 14px 28px -16px var(--color-ticket-midnight);
    --hg-rim: linear-gradient(
      140deg,
      var(--color-white) 0%,
      color-mix(in srgb, var(--color-white) 55%, transparent) 30%,
      color-mix(in srgb, var(--color-ticket-ice) 70%, transparent) 60%,
      var(--color-white) 100%
    );
    --hg-sheen: color-mix(in srgb, var(--color-ticket-ice) 30%, transparent);
    --hg-backdrop: none;

    gap: var(--space-2xs);
  }

  @media (hover: hover) {
    .back-btn:hover svg {
      transform: translateX(-2px);
    }
  }

  /* Inside the white sheet the Apply button keeps only its own glass
     shading, no drop shadow. */
  .apply-btn.is-flat {
    --hg-shadow:
      inset 0 1px 1px var(--color-white),
      inset 0 -1px 2px
        color-mix(in srgb, var(--color-ticket-sky) 45%, transparent),
      inset 0 -12px 18px -14px
        color-mix(in srgb, var(--color-ticket-sky) 70%, transparent);
  }

  .job-header {
    display: grid;
    justify-items: center;
    gap: 0.85rem;
    margin: clamp(1.75rem, 4vw, 2.75rem) 0 clamp(var(--space-lg), 4vw, 2.75rem);
    text-align: center;
  }

  .logo-box {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 13rem;
    height: 6.5rem;
    padding: var(--space-sm) 1.6rem;
    border-radius: var(--radius-ticket-card);
  }

  .logo-box img {
    width: auto;
    height: auto;
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
  }

  .job-company {
    margin: 0.4rem 0 0;
    font-size: clamp(var(--text-size-tiny), 0.6rem + 0.3vw, 0.8125rem);
    font-weight: var(--heading-weight);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-ticket-ice);
  }

  .job-title {
    max-width: 22ch;
    margin: 0;
    font-size: clamp(1.9rem, 4.4vw, 3rem);
    font-weight: var(--heading-weight-home);
    line-height: 1.08;
    letter-spacing: -0.02em;
  }

  .job-facts {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: var(--space-xs);
    margin: 0.2rem 0 0;
    padding: 0;
    list-style: none;
  }

  .fact {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: clamp(var(--text-size-tiny), 0.6rem + 0.3vw, 0.8125rem);
    font-weight: var(--font-weight-medium);
    color: color-mix(in srgb, var(--color-white) 74%, transparent);
  }

  .fact-tag {
    display: inline-block;
    padding: 0.35rem 0.85rem;
    border-radius: var(--radius-ticket-pill);
    font-size: var(--text-size-tiny);
    font-weight: var(--heading-weight);
    white-space: nowrap;
    color: var(--color-white);
    background: color-mix(in srgb, var(--color-white) 10%, transparent);
    box-shadow: inset 0 0 0 1px
      color-mix(in srgb, var(--color-white) 26%, transparent);
  }

  .fact-tag[data-workload="Internship"] {
    color: var(--color-ticket-ice);
    box-shadow: inset 0 0 0 1px
      color-mix(in srgb, var(--color-ticket-ice) 55%, transparent);
  }

  .fact-tag[data-workload="Full Time"] {
    color: var(--color-navy);
    background: var(--hg-fill);
    box-shadow: inset 0 1px 1px var(--color-white);
  }

  .job-header .apply-btn {
    margin-top: var(--space-2xs);
  }

  /* The job text on one sheet of white liquid glass. */
  .job-sheet {
    padding: clamp(var(--space-md), 4.5vw, 3.25rem);
    border-radius: var(--radius-ticket-sheet);
  }

  .job-body {
    font-size: var(--text-size-regular);
    line-height: 1.7;
    color: color-mix(in srgb, var(--color-navy) 30%, var(--color-neutral-dark));
  }

  /* Rich text from the CMS: h3 section heads with a sky line after them. */
  .job-body :global(h3) {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    margin: 2.1rem 0 0.65rem;
    font-size: clamp(1rem, 0.95rem + 0.2vw, 1.0625rem);
    font-weight: var(--font-weight-extrabold);
    line-height: var(--heading-line-height-normal);
    color: var(--color-navy);
  }

  .job-body :global(h3)::after {
    content: "";
    flex: 1;
    height: 1px;
    background: linear-gradient(
      90deg,
      color-mix(in srgb, var(--color-ticket-sky) 45%, transparent),
      transparent
    );
  }

  .job-body :global(h3:first-child) {
    margin-top: 0;
  }

  .job-body :global(p) {
    margin: 0 0 0.85rem;
  }

  .job-body :global(ul),
  .job-body :global(ol) {
    margin: 0 0 0.85rem;
    padding-left: 1.25rem;
  }

  .job-body :global(li) {
    margin-bottom: 0.3rem;
  }

  .job-body :global(li)::marker {
    color: var(--color-ticket-sky);
  }

  .job-body :global(strong),
  .job-body :global(b) {
    color: var(--color-navy);
  }

  .job-body :global(a) {
    font-weight: var(--font-weight-semibold);
    color: var(--color-ticket-sky);
  }

  .job-apply {
    display: grid;
    justify-items: center;
    gap: 0.95rem;
    margin-top: 2.25rem;
    padding-top: 2.1rem;
    border-top: 1px solid color-mix(in srgb, var(--color-navy) 12%, transparent);
    text-align: center;
  }

  .job-apply h2 {
    margin: 0;
    font-size: clamp(1rem, 0.95rem + 0.2vw, 1.0625rem);
    font-weight: var(--font-weight-extrabold);
    line-height: var(--heading-line-height-normal);
    color: var(--color-navy);
  }

  .apply-target {
    max-width: 100%;
    margin: 0;
    font-size: var(--text-size-tiny);
    word-break: break-all;
    color: var(--n-ink-soft);
  }

  @media (max-width: 560px) {
    .logo-box {
      width: 10rem;
      height: 5rem;
      padding: 0.8rem 1.1rem;
    }

    .job-sheet {
      border-radius: var(--radius-ticket-card);
    }

    .job-body {
      font-size: clamp(0.9375rem, 0.9rem + 0.2vw, 1rem);
    }
  }
</style>
