---
// Homepage hero: background video behind a dark overlay, ported from the
// Webflow section_header7. The poster paints immediately so first paint
// never waits on video; HLS is then loaded lazily via an idle-time dynamic
// import (see the script below), and a single <video> element streams a
// 480p/720p/1080p ladder, stepping itself up to the best rendition the
// connection supports. The quality upgrade happens inside that one element
// via Media Source Extensions -- there is no second <video>, no
// currentTime handoff, and no cross-fade, so there is nothing for a seek
// or drift to desync. An earlier two-element (poster video + upgrade video)
// approach was dropped for exactly that reason: it could not be made
// seamless.
// Reduced-motion and data-saver users get the poster only; no video bytes
// are fetched for them. No-JS clients get the 480p progressive fallback.
//
// Copy (DESIGN.md HOME-1): a glass badge with the anniversary, dates and
// city, the headline, two short lead lines, the countdown, the glass
// Buy Now. The site tagline now heads the key figures below the hero
// (StatsBand.astro). The lead lines replace the older announcement
// lines when they are set; without them, and without countdown wording,
// the hero falls back to the announcement, so it builds on either content.
import type { HomeCountdown, PageLink } from "../../lib/content";
import { EVENTS } from "../../lib/analytics/events";
import Container from "../ui/Container.astro";
import IconArrowRight from "../icons/IconArrowRight.astro";
import HeroCountdown from "./HeroCountdown.astro";

interface Props {
  headline: string;
  /** Announcement lines shown under the headline when there are no lead lines. */
  announcement: string[];
  cta: PageLink | undefined;
  /** Pill above the headline. */
  badge?: string;
  /** Short lines under the headline. */
  leadLines?: string[];
  /** Countdown wording; the countdown shows only with it. */
  countdown?: HomeCountdown;
  /** First conference day (yyyy-mm-dd), the countdown's target. */
  startDate?: string;
}

const {
  headline,
  announcement,
  cta,
  badge,
  leadLines = [],
  countdown,
  startDate,
} = Astro.props;
---

<header class="section is-dark hero">
  <div class="hero-media" aria-hidden="true">
    <video
      id="hero-video"
      autoplay
      loop
      muted
      playsinline
      preload="metadata"
      poster="/media/hero-poster.jpg"
      width="1920"
      height="1080"
    >
      <noscript>
        <source src="/media/hero-480.mp4" type="video/mp4" />
      </noscript>
    </video>
    <div class="hero-overlay"></div>
  </div>
  <script>
    // Not is:inline: this script imports hls.js (bundled, no CDN -- see
    // AGENTS.md) and Astro/Vite only processes and bundles npm imports for
    // scripts it's allowed to transform.
    const video = document.getElementById(
      "hero-video",
    ) as HTMLVideoElement | null;

    if (video) {
      const reducedMotion = window.matchMedia(
        "(prefers-reduced-motion: reduce)",
      ).matches;
      const conn = (
        navigator as unknown as {
          connection?: { saveData?: boolean; effectiveType?: string };
        }
      ).connection;
      // Only restrict on an explicit signal; an unsupported API must not be
      // treated as "data saver on".
      const saveData = !!conn?.saveData;
      const slowConn = !!(
        conn && /^(slow-2g|2g|3g)$/.test(conn.effectiveType ?? "")
      );
      const reducedData = window.matchMedia(
        "(prefers-reduced-data: reduce)",
      ).matches;

      if (reducedMotion || saveData || slowConn || reducedData) {
        // Poster-only: remove the element so it can never fetch or autoplay.
        video.remove();
      } else {
        // Desktop viewports get the full ladder (480p/720p/1080p); mobile
        // gets a ladder capped at 720p (no 1080p variant listed at all, so
        // it can never be requested, on any HLS client -- native or MSE).
        const desktop = window.innerWidth >= 810;
        const masterUrl = desktop
          ? "/media/hero-hls/hero.m3u8"
          : "/media/hero-hls/hero-mobile.m3u8";

        const playWhenReady = () => {
          video.play().catch(() => {
            // Autoplay may be blocked; the poster stays visible, not an error.
          });
        };

        // hls.js (tuned ABR below) is preferred on EVERY browser with
        // MSE, including ones that also claim native HLS support: Linux
        // Chromium builds with system ffmpeg report native HLS but ramp
        // up with an untunably conservative ABR (several seconds of 480p
        // on broadband), which reads as "the video is low-res". Native
        // playback is only the fallback for MSE-less browsers -- in
        // practice iOS Safari, where native HLS is mandatory and fine.
        //
        // The import (and hls.js's parse/init) is deferred to browser idle
        // time: that work is ~700ms of long tasks under CPU throttling, and
        // the poster already paints, so starting this muted decorative loop a
        // few hundred ms later keeps that cost out of the interactivity window
        // with no perceptible delay. The timeout caps the wait so playback
        // still starts promptly on a busy or non-supporting browser.
        const startHls = () => {
          import("hls.js/light").then(({ default: Hls }) => {
            if (!Hls.isSupported()) {
              if (video.canPlayType("application/vnd.apple.mpegurl")) {
                // No MSE but native HLS (iOS Safari): the browser's own
                // decoder owns level selection inside this one element.
                video.src = masterUrl;
                video.addEventListener("loadedmetadata", playWhenReady, {
                  once: true,
                });
                return;
              }
              // No MSE and no native HLS: single progressive rendition,
              // the same fallback the pre-HLS implementation used.
              const webm = video.canPlayType(
                'video/webm; codecs="vp09.00.10.08"',
              );
              const src = desktop
                ? webm
                  ? "/media/hero-1080.webm"
                  : "/media/hero-1080.mp4"
                : "/media/hero-480.mp4";
              const source = document.createElement("source");
              source.src = src;
              source.type = src.endsWith(".webm") ? "video/webm" : "video/mp4";
              video.appendChild(source);
              video.load();
              playWhenReady();
              return;
            }

            const hls = new Hls({
              capLevelToPlayerSize: false, // let measured bandwidth alone drive level choice, unrestrained by the (small, cropped) on-screen player size
              // The poster already paints instantly, so there is no need to
              // deliberately start small and climb: startLevel -1 lets hls.js's
              // ABR pick the initial rendition itself, using an assumed 4
              // Mbps (comfortably above the 1080p rung's ~2.9 Mbps, rather
              // than hls.js's very conservative 500 Kbps default) until a
              // segment has actually been measured -- broadband/Wi-Fi clients
              // land on 1080p from the very first fragment.
              // testBandwidth: false turns off hls.js's default behavior of
              // always fetching one full lowest-quality segment first as a
              // deliberate bitrate probe -- without it, that forced low-res
              // segment added a whole segment duration (4s) of guaranteed
              // 480p before the real (already-accurate) estimate could take
              // over. Genuinely slow/constrained connections still
              // self-correct within a few segments: the per-fragment
              // abandon check (maxStarvationDelay, left at its default)
              // aborts and downshifts a fragment that's loading too slowly
              // to keep up, so recovery isn't gated on the bitrate test
              // either -- it just may cost one brief rebuffer on a
              // borderline connection instead of zero, in exchange for
              // broadband clients never seeing a deliberately-slow start.
              startLevel: -1,
              abrEwmaDefaultEstimate: 4_000_000,
              testBandwidth: false,
            });
            hls.loadSource(masterUrl);
            hls.attachMedia(video);
            hls.on(Hls.Events.MANIFEST_PARSED, playWhenReady);
          });
        };

        if ("requestIdleCallback" in window) {
          window.requestIdleCallback(startHls, { timeout: 2000 });
        } else {
          setTimeout(startHls, 1500);
        }
      }
    }
  </script>
  <Container>
    <div class="hero-content">
      {
        badge && (
          <p class="hero-badge" data-lp="hero.badge">
            {badge}
          </p>
        )
      }
      <h1 data-lp="hero.headline">{headline}</h1>
      {
        leadLines.length > 0 && (
          <p class="hero-lead" data-lp="hero.leadLines" data-lp-lines>
            {leadLines.map((line, i) => (
              <span>{line}</span>
            ))}
          </p>
        )
      }
      {
        leadLines.length === 0 && announcement.length > 0 && (
          <p
            class="hero-announcement"
            data-lp="hero.announcementLines"
            data-lp-lines
          >
            {announcement.map((line) => (
              <span>{line}</span>
            ))}
          </p>
        )
      }
      {
        countdown && startDate && (
          <HeroCountdown startDate={startDate} labels={countdown} />
        )
      }
      {
        cta && (
          <a
            class="button is-glass hero-cta"
            href={cta.href}
            data-lp="hero.cta"
            data-lp-href="hero.cta.href"
            data-ph-event={EVENTS.hero_cta_clicked}
            data-ph-prop-cta-label={cta.label}
            data-ph-prop-cta-href={cta.href}
            data-glass-press
          >
            <span class="glass-light" aria-hidden="true" />
            <span data-lp-label>{cta.label}</span>
            <span class="button-arrow" aria-hidden="true">
              <IconArrowRight />
            </span>
          </a>
        )
      }
    </div>
  </Container>
  <div class="hero-mist" aria-hidden="true"></div>
</header>

<style>
  /* .section.is-dark supplies the navy background, inverse text color, and
     standard section padding; this adds only what a video masthead needs
     on top (centering, min-height, layered video/overlay). */
  /* The video runs up under the floating glass header (DESIGN.md COMP-6):
     the hero pulls itself up by the header's height and grows by the same
     amount, and the copy steps down by it, so the copy stays centered in
     the part of the video below the bar. */
  .hero {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: calc(
      min(90svh, 52rem) + var(--site-header-height, 0px) +
        var(--hero-dissolve) * 0.5
    );
    margin-top: calc(-1 * var(--site-header-height, 0px));
    overflow: hidden;
  }

  .hero-media,
  .hero-media video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .hero-media video {
    object-fit: cover;
  }

  /* Legibility over any video frame without graying the film: no flat
     black veil (half-black over the whole video made every frame dull and
     gray), only a thin midnight tint, which keeps the colors, and a deeper
     pool of the same navy behind the copy, where the white type sits. */
  .hero-overlay {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(
        64% 58% at 50% 50%,
        color-mix(in srgb, var(--color-ticket-midnight) 70%, transparent) 0%,
        color-mix(in srgb, var(--color-ticket-midnight) 52%, transparent) 45%,
        transparent 100%
      ),
      color-mix(in srgb, var(--color-ticket-midnight) 20%, transparent);
  }

  /*
   * Into the page. The video stays fully opaque to its lower edge, so the
   * page ground never shows through it. Over its lower part lies a mist
   * (.hero-mist): a veil that grows from nothing to the solid ground color
   * at the hero's edge, with a blur that deepens the same way, so the video
   * melts away instead of ending. The section below starts on that same
   * solid color and lets it go (StatsBand.astro), so the edge between the
   * two is one color on both sides and cannot be seen.
   */
  .section.is-dark.hero {
    --hero-dissolve: clamp(10rem, 26vw, 20rem);
  }

  .hero-mist {
    position: absolute;
    inset: auto 0 0;
    height: var(--hero-dissolve);
    /* The veil follows a smoothstep curve in small steps, not two or three
       straight pieces: a straight piece changes its slope where it meets
       the next one, and the eye reads every such bend as a band. The
       curve starts and ends flat, and reaches the solid ground color well
       above the hero's edge, so the last stretch is one color. */
    background: linear-gradient(
      180deg,
      transparent 0%,
      color-mix(in srgb, var(--color-ticket-ground) 2%, transparent) 7%,
      color-mix(in srgb, var(--color-ticket-ground) 7%, transparent) 14%,
      color-mix(in srgb, var(--color-ticket-ground) 16%, transparent) 21%,
      color-mix(in srgb, var(--color-ticket-ground) 26%, transparent) 28%,
      color-mix(in srgb, var(--color-ticket-ground) 38%, transparent) 35%,
      color-mix(in srgb, var(--color-ticket-ground) 50%, transparent) 42%,
      color-mix(in srgb, var(--color-ticket-ground) 62%, transparent) 49%,
      color-mix(in srgb, var(--color-ticket-ground) 74%, transparent) 56%,
      color-mix(in srgb, var(--color-ticket-ground) 84%, transparent) 63%,
      color-mix(in srgb, var(--color-ticket-ground) 93%, transparent) 70%,
      color-mix(in srgb, var(--color-ticket-ground) 98%, transparent) 77%,
      var(--color-ticket-ground) 84%,
      var(--color-ticket-ground) 100%
    );
    pointer-events: none;
    -webkit-backdrop-filter: blur(22px);
    backdrop-filter: blur(22px);
    /* The blur fades in along the same kind of curve. */
    -webkit-mask: linear-gradient(
      180deg,
      transparent 0%,
      color-mix(in srgb, var(--color-black) 3%, transparent) 6.2%,
      color-mix(in srgb, var(--color-black) 10%, transparent) 12.4%,
      color-mix(in srgb, var(--color-black) 22%, transparent) 18.6%,
      color-mix(in srgb, var(--color-black) 35%, transparent) 24.8%,
      color-mix(in srgb, var(--color-black) 50%, transparent) 31%,
      color-mix(in srgb, var(--color-black) 65%, transparent) 37.2%,
      color-mix(in srgb, var(--color-black) 78%, transparent) 43.4%,
      color-mix(in srgb, var(--color-black) 90%, transparent) 49.6%,
      color-mix(in srgb, var(--color-black) 97%, transparent) 55.8%,
      var(--color-black) 62%,
      var(--color-black) 100%
    );
    mask: linear-gradient(
      180deg,
      transparent 0%,
      color-mix(in srgb, var(--color-black) 3%, transparent) 6.2%,
      color-mix(in srgb, var(--color-black) 10%, transparent) 12.4%,
      color-mix(in srgb, var(--color-black) 22%, transparent) 18.6%,
      color-mix(in srgb, var(--color-black) 35%, transparent) 24.8%,
      color-mix(in srgb, var(--color-black) 50%, transparent) 31%,
      color-mix(in srgb, var(--color-black) 65%, transparent) 37.2%,
      color-mix(in srgb, var(--color-black) 78%, transparent) 43.4%,
      color-mix(in srgb, var(--color-black) 90%, transparent) 49.6%,
      color-mix(in srgb, var(--color-black) 97%, transparent) 55.8%,
      var(--color-black) 62%,
      var(--color-black) 100%
    );
  }

  /* The page width stays .container's --container-large (DESIGN.md
     LAYOUT-1: no component defines its own page width); the hero copy is a
     measure block INSIDE that container, capped at --container-medium,
     which is what the medium token is for (LAYOUT-2). Sits above the video
     overlay, which is why it carries the stacking context. */
  .hero-content {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    /* The copy ends above the dissolve, where the video is still dark
       enough for white type. */
    padding-block: var(--site-header-height, 0px)
      calc(var(--hero-dissolve) * 0.8);
    max-width: var(--container-medium);
    margin-inline: auto;
    text-align: center;
  }

  /* Home-page-only oversized weight/size (DESIGN.md TYPE-1 exception);
     color is inherited from .section.is-dark, not restated here. */
  .hero h1 {
    font-size: var(--heading-h1-home-size);
    font-weight: var(--heading-weight-home);
    text-wrap: balance;
  }

  /*
   * Entrance: the copy sharpens out of a blur and settles, one part after
   * the other. Backwards fill, so nothing persists. The headline is never
   * transparent (only blurred), so the largest paint is not delayed.
   */
  @media (prefers-reduced-motion: no-preference) {
    .hero-content > * {
      animation: hero-in var(--duration-reveal) var(--ease-emphasized) backwards;
    }

    .hero-content > h1 {
      animation-name: hero-in-sharp;
    }

    .hero-content > :nth-child(2) {
      animation-delay: calc(var(--duration-glass-stagger) * 3);
    }

    .hero-content > :nth-child(3) {
      animation-delay: calc(var(--duration-glass-stagger) * 6);
    }

    .hero-content > :nth-child(4) {
      animation-delay: calc(var(--duration-glass-stagger) * 9);
    }

    .hero-content > :nth-child(5) {
      animation-delay: calc(var(--duration-glass-stagger) * 12);
    }

    .hero-content > :nth-child(6) {
      animation-delay: calc(var(--duration-glass-stagger) * 15);
    }
  }

  @keyframes hero-in {
    from {
      opacity: 0;
      filter: blur(12px);
      transform: translateY(0.75rem);
    }
  }

  @keyframes hero-in-sharp {
    from {
      filter: blur(12px);
      transform: translateY(0.75rem);
    }
  }

  /* The badge: a pill of clear glass, white type. */
  .hero-badge {
    margin: 0 0 var(--space-sm);
    padding: var(--space-2xs) var(--space-sm);
    border-radius: var(--radius-ticket-pill);
    background: linear-gradient(
      180deg,
      color-mix(in srgb, var(--color-white) 22%, transparent),
      color-mix(in srgb, var(--color-white) 8%, transparent)
    );
    box-shadow:
      inset 0 1px 1px color-mix(in srgb, var(--color-white) 80%, transparent),
      inset 0 0 0 1px color-mix(in srgb, var(--color-white) 22%, transparent),
      inset 0 -8px 12px -10px
        color-mix(in srgb, var(--color-ticket-cyan) 80%, transparent),
      0 8px 22px -14px
        color-mix(in srgb, var(--color-ticket-midnight) 70%, transparent);
    font-size: var(--text-size-tiny);
    font-weight: var(--font-weight-extrabold);
    letter-spacing: 0.14em;
    line-height: 1.35;
    text-transform: uppercase;
    text-wrap: balance;
    -webkit-backdrop-filter: blur(8px) saturate(130%);
    backdrop-filter: blur(8px) saturate(130%);
  }

  .hero-lead {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    max-width: 40rem;
    margin: var(--space-sm) 0 0;
    font-size: var(--text-size-large);
    font-weight: var(--font-weight-semibold);
    line-height: 1.4;
    text-wrap: balance;
  }

  .hero-announcement {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    margin: var(--space-md) 0 0;
    /* Both clamp endpoints are scale steps, so they are written as tokens
       (DESIGN.md TYPE-2): the floor is the large body step, the ceiling the
       h4 step. Both also shrink at the breakpoints, which keeps the
       announcement in step with the rest of the type on small screens. */
    font-size: clamp(var(--text-size-large), 3.5vw, var(--heading-h4-size));
    font-weight: var(--heading-weight);
    font-style: italic;
    line-height: var(--heading-line-height-tight);
  }

  /* The date line is its own upright, non-italic callout on the live site
     (not part of the italic announcement quote) and stays white, never
     orange: dates are a navy/neutral-only element per DESIGN.md COLOR-1. */
  .hero-announcement span:last-child {
    margin-top: var(--space-xs);
    font-size: var(--text-size-large);
    font-style: normal;
  }

  /*
   * The one thing to do on the page: a piece of transparent liquid glass.
   * The film stays visible through it, softened by a light blur; the glass
   * only tints it, in the light of the ticket page's cards
   * (tickets/ticket-theme.css .t-field): white pooling in its upper left,
   * Q27 blue in its lower right, a little cyan at the upper right. It
   * reads as glass from its edges: the specular rim of the shared glass
   * button (bright upper left, cyan lower right), a lit top edge, a cyan
   * line inside the lower edge and a soft shadow on the film. No halo. The
   * label is white with a navy shadow, so it holds on a bright frame. A
   * size up from the glass button.
   */
  .hero-cta.button.is-glass {
    min-height: 3.5rem;
    margin-top: var(--space-md);
    padding-inline: var(--space-lg);
    border-radius: var(--radius-ticket-button);
    background:
      radial-gradient(
        75% 120% at 12% 0%,
        color-mix(in srgb, var(--color-white) 34%, transparent),
        transparent 70%
      ),
      radial-gradient(
        85% 130% at 92% 110%,
        color-mix(in srgb, var(--color-ticket-sky) 42%, transparent),
        transparent 72%
      ),
      radial-gradient(
        50% 90% at 100% 0%,
        color-mix(in srgb, var(--color-ticket-cyan) 30%, transparent),
        transparent 70%
      ),
      linear-gradient(
        160deg,
        color-mix(in srgb, var(--color-white) 8%, transparent) 0%,
        color-mix(in srgb, var(--color-ticket-ice) 8%, transparent) 55%,
        color-mix(in srgb, var(--color-ticket-sky) 14%, transparent) 100%
      );
    box-shadow:
      inset 0 1px 1px color-mix(in srgb, var(--color-white) 85%, transparent),
      inset 0 -10px 14px -10px
        color-mix(in srgb, var(--color-ticket-cyan) 70%, transparent),
      0 14px 26px -14px
        color-mix(in srgb, var(--color-ticket-midnight) 80%, transparent);
    color: var(--color-white);
    font-size: var(--text-size-small);
    font-weight: var(--font-weight-extrabold);
    text-shadow:
      0 1px 2px
        color-mix(in srgb, var(--color-ticket-midnight) 75%, transparent),
      0 0 10px color-mix(in srgb, var(--color-ticket-midnight) 50%, transparent);
    -webkit-backdrop-filter: blur(6px) saturate(150%);
    backdrop-filter: blur(6px) saturate(150%);
  }

  /* The arrow gets the label's shadow. */
  .hero-cta :global(svg) {
    filter: drop-shadow(
      0 1px 2px
        color-mix(in srgb, var(--color-ticket-midnight) 75%, transparent)
    );
  }

  /* Hover, focus and press: the glass brightens a little; no halo. */
  .hero-cta.button.is-glass::before {
    background: color-mix(in srgb, var(--color-white) 14%, transparent);
    box-shadow: none;
  }

  @media (hover: hover) {
    .hero-cta.button.is-glass:hover {
      background:
        radial-gradient(
          75% 120% at 12% 0%,
          color-mix(in srgb, var(--color-white) 34%, transparent),
          transparent 70%
        ),
        radial-gradient(
          85% 130% at 92% 110%,
          color-mix(in srgb, var(--color-ticket-sky) 42%, transparent),
          transparent 72%
        ),
        radial-gradient(
          50% 90% at 100% 0%,
          color-mix(in srgb, var(--color-ticket-cyan) 30%, transparent),
          transparent 70%
        ),
        linear-gradient(
          160deg,
          color-mix(in srgb, var(--color-white) 8%, transparent) 0%,
          color-mix(in srgb, var(--color-ticket-ice) 8%, transparent) 55%,
          color-mix(in srgb, var(--color-ticket-sky) 14%, transparent) 100%
        );
      color: var(--color-white);
    }
  }

  /* Without backdrop blur the tint alone carries the label. */
  @supports not (
    (backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))
  ) {
    .hero-cta.button.is-glass {
      background: color-mix(in srgb, var(--color-navy) 55%, transparent);
    }
  }

  @media (max-width: 767px) {
    /* tokens.css only overrides --heading-h1-home-size at the 479px
       (mobile-portrait) breakpoint, so between 767px and 991px it still
       resolves to the 4rem desktop value; that wraps the headline onto two
       lines here where the live site keeps it on one. Sized to match the
       live hero at this breakpoint, which is why this one stays a raw value
       (DESIGN.md TYPE-2): 2.75rem is not a step of the scale, and the two
       nearest steps at this breakpoint (--heading-h1-size 2.5rem,
       --heading-h2-size 2.25rem) both undersize the headline against the
       live site. */
    .hero h1 {
      font-size: 2.75rem;
    }
  }
</style>
