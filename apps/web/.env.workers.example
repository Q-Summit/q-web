# Paste into Cloudflare Workers Builds → q-web variables. Copy to .env.workers.
# Committed example only; no secrets.

CONTENT_SOURCE=cms
CMS_URL=https://YOUR_CMS.vercel.app
PUBLIC_CMS_URL=https://YOUR_CMS.vercel.app

# Cookieless analytics (docs/dev/analytics.md). Project API key, public by
# design; privacy policy must name PostHog before this is set in production.
PUBLIC_POSTHOG_KEY=phc_YOUR_PROJECT_KEY
