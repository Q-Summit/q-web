---
// Previous Speakers carousel, rendered at build time from getSpeakers().
// The Webflow site built this section as a client-side JS carousel with
// the speaker data inlined in a script tag; that JS is gone and the same
// people now come from the content layer.
//
// This used to render as a 4-column grid, which for the current 5-speaker
// set wrapped 4+1 (a near-empty last row). A compact horizontal scroll-snap
// carousel reads correctly at any speaker count instead.
//
// The track (<div>/<div>, image, name, roleLine, bio) is a native
// scroll-snap container, keyboard- and touch-usable with zero JS. Track and
// slides are plain <div>s, not <ul>/<li>: each slide carries
// role="group" + aria-roledescription="slide" per the WAI-ARIA APG carousel
// pattern, and a list ancestor would conflict with that (a <ul> requires
// listitem children; overriding a child to role="group" instead breaks the
// list semantics the <ul> claims -- axe's list / aria-allowed-role rules,
// WCAG 1.3.1). Plain <div>s claim no role at all, so nothing conflicts.
// The prev/next arrows and position dots are a progressive enhancement layered
// on top by the inline script and stay hidden without JS (gated on
// `.speakers-carousel[data-js]`), so there is never a dead control on
// screen. The infinite loop is done with head/tail clone slides plus an
// idle seam recentre: the clones are created in JS only (never in this
// markup) so the no-JS DOM stays at exactly N real slides.
import { Picture } from "../../lib/astro-assets";
import type { PageLink, Speaker } from "../../lib/content";
import { photoSrc } from "../../lib/media-filename";
import { resolveContentImage } from "../../lib/images";
import Button from "../ui/Button.astro";
import Container from "../ui/Container.astro";
import Section from "../ui/Section.astro";
import SectionHeader from "../ui/SectionHeader.astro";

interface Props {
  heading: string;
  intro: string;
  speakers: Speaker[];
  cta: PageLink | undefined;
}

const { heading, intro, speakers, cta } = Astro.props;

const speakerImages = await Promise.all(
  speakers.map((speaker) =>
    resolveContentImage(speaker.photoFilename, `home speaker ${speaker.name}`),
  ),
);

const total = speakers.length;
---

<Section variant="alternate" small class="speakers">
  <Container>
    <SectionHeader>
      <h2 data-lp="previousSpeakers.heading">{heading}</h2>
      <p data-lp="previousSpeakers.intro">{intro}</p>
    </SectionHeader>
    <div
      class="speakers-carousel"
      id="speakers-carousel"
      role="region"
      aria-roledescription="carousel"
      aria-label={heading}
    >
      <div class="speakers-viewport">
        <div class="speakers-list" id="speakers-list" tabindex="0">
          {
            speakers.map((speaker, i) => (
              <div
                class="speaker-card"
                role="group"
                aria-roledescription="slide"
                aria-label={`${i + 1} of ${total}: ${speaker.name}`}
              >
                {speakerImages[i] ? (
                  <Picture
                    src={speakerImages[i]!}
                    alt={`Portrait of ${speaker.name}`}
                    widths={[400, 600, 800]}
                    sizes="(max-width: 767px) 76vw, 18rem"
                    formats={["avif", "webp"]}
                    fallbackFormat="jpg"
                    quality={80}
                    loading="lazy"
                  />
                ) : (
                  <img
                    src={photoSrc(speaker.photoFilename)}
                    alt={`Portrait of ${speaker.name}`}
                    width="800"
                    height="800"
                    loading="lazy"
                  />
                )}
                <div class="speaker-meta">
                  <h3>{speaker.name}</h3>
                  <p class="role">{speaker.roleLine}</p>
                  {speaker.bio && <p class="bio">{speaker.bio}</p>}
                </div>
              </div>
            ))
          }
        </div>
      </div>
      {
        total > 1 && (
          <>
            <button
              type="button"
              class="speakers-nav is-prev"
              data-dir="-1"
              aria-label="Previous speaker"
            >
              <svg
                viewBox="0 0 24 24"
                width="20"
                height="20"
                fill="none"
                aria-hidden="true"
              >
                <path
                  d="M15 5l-7 7 7 7"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
              </svg>
            </button>
            <button
              type="button"
              class="speakers-nav is-next"
              data-dir="1"
              aria-label="Next speaker"
            >
              <svg
                viewBox="0 0 24 24"
                width="20"
                height="20"
                fill="none"
                aria-hidden="true"
              >
                <path
                  d="M9 5l7 7-7 7"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
              </svg>
            </button>
            <div class="speakers-dots" role="group" aria-label="Choose speaker">
              {speakers.map((speaker, i) => (
                <button
                  type="button"
                  class="speakers-dot"
                  data-index={i}
                  aria-label={`Go to ${speaker.name}`}
                  aria-current={i === 0 ? "true" : "false"}
                />
              ))}
            </div>
          </>
        )
      }
    </div>
    {
      cta && (
        <div class="u-section-cta">
          <Button variant="secondary" href={cta.href}>
            {cta.label}
          </Button>
        </div>
      )
    }
  </Container>
</Section>

<style>
  .speakers-carousel {
    position: relative;
  }

  .speakers-viewport {
    overflow: hidden;
    /* Edge fade masks, same technique as the home partner marquee. */
    mask-image: linear-gradient(
      to right,
      transparent,
      black 2%,
      black 98%,
      transparent
    );
    -webkit-mask-image: linear-gradient(
      to right,
      transparent,
      black 2%,
      black 98%,
      transparent
    );
  }

  .speakers-list {
    display: flex;
    gap: var(--space-md);
    margin: 0;
    padding: var(--space-2xs) var(--space-xl) var(--space-sm);
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
  }

  @media (pointer: coarse) {
    .speakers-list {
      scroll-behavior: auto;
    }
  }

  .speakers-list::-webkit-scrollbar {
    display: none;
  }

  /* Desktop drag-to-scroll affordance. The pointer handler adds .is-dragging
     for the life of a mouse drag; snap is suspended so the row tracks the
     cursor 1:1, then re-enabled on release to settle on a card. Coarse
     pointers pan natively and never get a grab cursor. */
  @media (pointer: fine) {
    .speakers-carousel[data-js] .speakers-list {
      cursor: grab;
    }

    .speakers-carousel[data-js] .speakers-list.is-dragging {
      cursor: grabbing;
      user-select: none;
      scroll-snap-type: none;
      scroll-behavior: auto;
    }
  }

  /* Fixed card width (not a viewport-relative one on desktop): a compact,
     consistent card in line with the "modern carousel" brief. Three ~18rem
     cards plus gaps fit inside --container-large with a peek of the clones
     either side. Flat hairline border per DESIGN.md COMP-2 (a soft shadow
     gives the same "cloudy halo" the hackathon benefit cards avoided). */
  .speaker-card {
    display: flex;
    flex-direction: column;
    flex: 0 0 18rem;
    background-color: var(--color-white);
    border: 1px solid var(--color-neutral-lighter);
    border-radius: var(--radius-card);
    overflow: hidden;
    scroll-snap-align: center;
  }

  .speaker-card img,
  .speaker-card picture {
    width: 100%;
  }

  .speaker-card img {
    aspect-ratio: 1;
    height: auto;
    object-fit: cover;
    object-position: center top;
    background-color: var(--color-neutral-lightest);
  }

  .speaker-meta {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding: var(--space-sm) 1.25rem 1.25rem;
  }

  /* A speaker's name is a card caption on the live site, not a section
     heading; sized well below the global h3 scale per DESIGN.md TYPE-1. */
  .speaker-meta h3 {
    font-size: var(--text-size-medium);
    line-height: var(--heading-line-height-normal);
    color: var(--color-heading);
  }

  .speaker-meta .role {
    margin: 0.2rem 0 0;
    font-size: var(--text-size-small);
    color: var(--color-neutral);
  }

  /* Clamped to a fixed number of lines so every card in the row settles
     at the same height regardless of how long a given bio is. */
  .speaker-meta .bio {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
    line-clamp: 3;
    overflow: hidden;
    margin: 0.6rem 0 0;
    font-size: var(--text-size-small);
    line-height: var(--heading-line-height-loose);
    color: var(--color-neutral-dark);
  }

  /* Prev/next: navy/neutral only (DESIGN.md COLOR-1), matching the card
     radius/border tokens. Hidden until the enhancement script confirms it
     can drive them (a no-JS visit never shows an inert control), and hidden
     on coarse pointers where swiping is the natural interaction. */
  .speakers-nav {
    display: none;
    position: absolute;
    top: 36%;
    z-index: 1;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    padding: 0;
    background-color: var(--color-background);
    color: var(--color-primary);
    border: 1px solid var(--color-neutral-lighter);
    border-radius: var(--radius-circle);
    cursor: pointer;
    transform: translateY(-50%);
    transition: background-color var(--duration-icon) var(--ease-snappy);
  }

  .speakers-carousel[data-js] .speakers-nav {
    display: flex;
  }

  @media (hover: hover) {
    .speakers-nav:hover {
      background-color: var(--color-background-alternate);
    }
  }

  .speakers-nav.is-prev {
    left: -0.25rem;
  }

  .speakers-nav.is-next {
    right: -0.25rem;
  }

  /* Fine-pointer only: on touch, the swipe gesture is primary and the
     arrows just clutter the edges. */
  @media (pointer: coarse) {
    .speakers-carousel[data-js] .speakers-nav {
      display: none;
    }
  }

  .speakers-dots {
    display: none;
    justify-content: center;
    margin-top: var(--space-md);
  }

  .speakers-carousel[data-js] .speakers-dots {
    display: flex;
  }

  /* Visual dot is a 0.5rem circle, but the button carries transparent
     padding so its hit area clears the 44x44px minimum; a small negative
     margin pulls the boxes back together so the dots still read as a tight
     row. content-box + background-clip keeps the painted circle at 0.5rem. */
  .speakers-dot {
    box-sizing: content-box;
    width: 0.5rem;
    height: 0.5rem;
    margin: 0 -0.625rem;
    padding: calc((44px - var(--space-2xs)) / 2);
    background-color: var(--color-neutral-lighter);
    background-clip: content-box;
    border: none;
    border-radius: var(--radius-circle);
    cursor: pointer;
    transition: background-color var(--duration-icon) var(--ease-snappy);
  }

  .speakers-dot[aria-current="true"] {
    background-color: var(--color-primary);
  }

  @media (prefers-reduced-motion: reduce) {
    .speakers-list {
      scroll-behavior: auto;
    }
  }

  @media (max-width: 767px) {
    /* One centered card + a ~12% peek of each neighbour ((100-76)/2), per
       the mobile carousel brief. */
    .speaker-card {
      flex: 0 0 76vw;
    }

    .speakers-list {
      padding-inline: var(--space-md);
    }

    .speakers-nav {
      width: 2rem;
      height: 2rem;
    }
  }
</style>

<script>
  import { initSpeakerCarousels } from "./speaker-carousel.client";
  initSpeakerCarousels();
</script>
