{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "tsBuildInfoFile": "node_modules/.cache/tsconfig.tsbuildinfo",
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@payload-config": [
        "./src/payload.config.ts"
      ],
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  // .next/dev/** is dev-server scaffolding, not build output. Its generated
  // validator.ts does not parse under a standalone `tsc --noEmit` (TS1434),
  // so once anyone had run `make dev` the CMS typecheck failed until they
  // deleted .next -- a confusing failure that had nothing to do with their
  // change. Next's own route-type checking still runs, in `check:cms:build`
  // (`next build` reports "Running TypeScript"), which is the context those
  // generated types are written for.
  "exclude": [
    "node_modules",
    ".next/dev"
  ]
}
