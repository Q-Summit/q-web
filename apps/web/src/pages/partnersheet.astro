---
// /partnersheet: the form where interested companies reach the partner
// team (DESIGN.md INQUIRY-1). No server yet: a complete form opens the
// visitor's email app with the inquiry to the partner team (see
// InquiryForm.astro). The URL is written once, as PARTNER_INQUIRY_PATH in
// lib/partner-inquiry.ts; `?type=company`, `media`, `initiative` or `speaker`
// preselects the matching tile, and `&topic=hackathon` (comma separated)
// ticks topic chips of that type.
//
// The header is the shared floating glass bar from Base.astro (COMP-6).
import Base from "../layouts/Base.astro";
import InquiryForm from "../components/inquiry/InquiryForm.astro";
import InquiryIntro from "../components/inquiry/InquiryIntro.astro";
import InquiryPage from "../components/inquiry/InquiryPage.astro";
---

<Base
  title="Partner inquiry"
  description="Tell the Q-Summit partner team what matters to you, and we get back to you personally."
  noindex
>
  {
    /* noindex while the form only hands over to the visitor's email app:
       the page is reached from the site's partner buttons, not from search.
       Remove this prop once form handling is decided; the sitemap and the
       route table in lib/llms.ts follow then too. */
  }
  <InquiryPage>
    <InquiryIntro />
    <InquiryForm />
  </InquiryPage>
</Base>
