# Agent tools → deployed CMS / R2. Copied by `pnpm setup` when missing.
# Not read by local Payload/`make dev`. Docs: docs/dev/content-sync.md
#
# .env        = local Docker (required for day-to-day)
# .env.remote = only for remote scripts: make pull, remote propose,
#               pnpm dev:web:remote, ops:mirror-media
#
# Those scripts fail closed on empty / CHANGEME / REPLACE_WITH_* / YOUR_*.
# Local-only work can leave placeholders as-is.

REMOTE_CMS_URL=https://YOUR_CMS.vercel.app
CONTENT_SYNC_TOKEN=same-as-vercel-CONTENT_SYNC_TOKEN
# EXAMPLE ONLY: replace `dev` with your Workspace username (not agent.*).
CONTENT_SYNC_USER_EMAIL=dev@q-summit.com

REMOTE_S3_BUCKET=qweb-media
REMOTE_S3_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
REMOTE_S3_ACCESS_KEY_ID=
REMOTE_S3_SECRET_ACCESS_KEY=
