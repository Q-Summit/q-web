---
// The living violet ground behind the whole /hackathon page (DESIGN.md
// HACK-1): soft, continuously folding waves of light in the Hack CI violet
// ramp, with bright crests and darker depths, after the ElevenLabs brand
// reference (organic light, not a copy of its palette).
//
// One fixed layer, rendered by a ~100-line first-party WebGL fragment
// shader (ground-gl.ts). It is not an animation runtime or a dependency
// (DESIGN.md MOTION-4): no library, no network request, one canvas. Cost is
// kept low on purpose: where the browser allows it, the shader runs in a
// worker on an OffscreenCanvas (ground.worker.ts), so its frames never
// wake the main thread; it renders at half resolution (the light is soft
// anyway, at most about one megapixel), about 24 fps, and only while a
// violet part of the page is on screen (hero, facts, film, closing band).
// Hidden tabs stop it.
//
// Before the shader draws, and for good without WebGL or JavaScript, the
// layer shows a still poster of the shader's own start frame (wide and
// tall variants, rendered by `pnpm ground:poster`; regenerate them when the
// shader or its colors change). A tiny copy of each is inlined into the
// CSS, so even the very first paint shows the same waves. The canvas then
// fades in over the identical frame, so nothing visibly changes but the
// start of the motion. With reduced motion the shader draws that one still
// frame and stops; the pause button freezes the ground, the falling
// fragments and the light in the cutouts together.
---

<div class="ground" aria-hidden="true" data-hack-ground>
  <canvas class="ground-canvas"></canvas>
</div>

<button
  class="motion-toggle"
  type="button"
  aria-pressed="false"
  data-hack-motion-toggle
  hidden
>
  <svg
    class="motion-icon is-pause"
    viewBox="0 0 24 24"
    width="18"
    height="18"
    aria-hidden="true"
  >
    <rect x="6" y="5" width="4" height="14" rx="1"></rect>
    <rect x="14" y="5" width="4" height="14" rx="1"></rect>
  </svg>
  <svg
    class="motion-icon is-play"
    viewBox="0 0 24 24"
    width="18"
    height="18"
    aria-hidden="true"
  >
    <path
      d="M8 5.5v13a1 1 0 0 0 1.5.86l10.5-6.5a1 1 0 0 0 0-1.72L9.5 4.64A1 1 0 0 0 8 5.5Z"
    ></path>
  </svg>
  <span class="u-visually-hidden" data-motion-label
    >Pause background motion</span
  >
</button>

<style>
  /* Campaign ground (DESIGN.md HACK-1). Fixed behind everything on the
     page; the page shell's clip-path keeps it out of the nav and footer. */
  .ground {
    position: fixed;
    inset: 0;
    z-index: -3;
    pointer-events: none;
    /* Still poster of the shader's start frame (see the component
       comment), over its inlined tiny copy. Cover matches the shader's
       scaling: the wide poster fits the height of a landscape screen. */
    background:
      url("./ground-poster-wide.webp") center / cover no-repeat,
      url("./ground-poster-wide-lqip.webp") center / cover no-repeat,
      var(--color-hack-violet);
  }

  /* Taller than wide: the portrait poster (the shader scales its field
     down there, ground-gl.ts fieldFor), fitted to the width. */
  @media (max-aspect-ratio: 999/1000) {
    .ground {
      background:
        url("./ground-poster-tall.webp") center / cover no-repeat,
        url("./ground-poster-tall-lqip.webp") center / cover no-repeat,
        var(--color-hack-violet);
    }
  }

  .ground-canvas {
    display: block;
    width: 100%;
    height: 100%;
    opacity: 0;
  }

  .ground-canvas[data-live] {
    opacity: 1;
  }

  @media (prefers-reduced-motion: no-preference) {
    .ground-canvas {
      transition: opacity var(--duration-hack-reveal) var(--ease-emphasized);
    }
  }

  /* Pause control: small, fixed in the lower left, readable on violet
     and on white. Only shown when there is motion to pause. */
  .motion-toggle {
    position: fixed;
    left: var(--padding-global);
    bottom: var(--space-sm);
    z-index: 5;
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    padding: 0;
    border: 1px solid color-mix(in srgb, var(--color-white) 35%, transparent);
    border-radius: var(--radius-circle);
    background-color: color-mix(
      in srgb,
      var(--color-hack-ink) 78%,
      transparent
    );
    color: var(--color-white);
    cursor: pointer;
    backdrop-filter: blur(6px);
    transition: background-color var(--duration-hover) var(--ease-snappy);
  }

  .motion-toggle:hover {
    background-color: var(--color-hack-ink);
  }

  .motion-icon {
    fill: currentColor;
    grid-area: 1 / 1;
  }

  .motion-toggle .is-play,
  .motion-toggle[aria-pressed="true"] .is-pause {
    display: none;
  }

  .motion-toggle[aria-pressed="true"] .is-play {
    display: block;
  }

  /* Phones: a fixed corner control would sit on top of copy, so it rests
     in the free top-left corner of the hero instead (the page shell is
     its containing block). */
  @media (max-width: 767px) {
    .motion-toggle {
      position: absolute;
      top: var(--space-sm);
      bottom: auto;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .motion-toggle {
      display: none;
    }
  }
</style>

<script>
  import {
    CONTEXT_OPTIONS,
    createGround,
    FRAME_MS,
    START_TIME,
    hexToRgb,
    renderSize,
    type GroundColors,
  } from "./ground-gl";

  const ground = document.querySelector<HTMLElement>("[data-hack-ground]");
  const canvas = ground?.querySelector<HTMLCanvasElement>("canvas");
  const toggle = document.querySelector<HTMLButtonElement>(
    "[data-hack-motion-toggle]",
  );
  const shell = ground?.closest<HTMLElement>("[data-hack-world]") ?? null;
  const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

  const setPaused = (paused: boolean) => {
    shell?.setAttribute("data-motion", paused ? "paused" : "running");
    if (toggle) {
      toggle.setAttribute("aria-pressed", String(paused));
      const label = toggle.querySelector("[data-motion-label]");
      if (label) {
        label.textContent = paused
          ? "Play background motion"
          : "Pause background motion";
      }
    }
  };

  let userPaused = false;
  // Re-evaluates the ground; replaced once a renderer is up.
  let onMotionChange = () => {};
  if (toggle) {
    toggle.hidden = false;
    setPaused(false);
    toggle.addEventListener("click", () => {
      userPaused = !userPaused;
      setPaused(userPaused);
      onMotionChange();
    });
  }

  // Is any violet part of the page on screen? The ground only renders then,
  // and the falling fragments rest while only the white surface shows
  // (they sit behind it anyway). Works with or without WebGL.
  let zonesVisible = true;
  const zones = document.querySelectorAll("[data-hack-ground-zone]");
  if (shell && zones.length && "IntersectionObserver" in window) {
    const visible = new Set<Element>();
    const zoneWatch = new IntersectionObserver((entries) => {
      for (const entry of entries) {
        if (entry.isIntersecting) visible.add(entry.target);
        else visible.delete(entry.target);
      }
      zonesVisible = visible.size > 0;
      shell.setAttribute("data-ground", zonesVisible ? "visible" : "hidden");
      onMotionChange();
    });
    zones.forEach((zone) => zoneWatch.observe(zone));
  }

  const shouldRun = () =>
    !reduceMotion.matches &&
    !userPaused &&
    zonesVisible &&
    document.visibilityState === "visible";

  const readColors = (): GroundColors => {
    const css = getComputedStyle(document.documentElement);
    const token = (name: string) => hexToRgb(css.getPropertyValue(name));
    return {
      ink: token("--color-hack-ink"),
      deep: token("--color-hack-deep"),
      violet: token("--color-hack-violet"),
      mid: token("--color-hack-mid"),
      glow: token("--color-hack-glow"),
      haze: token("--color-hack-haze"),
    };
  };

  const size = () =>
    canvas
      ? renderSize(
          canvas.clientWidth,
          canvas.clientHeight,
          window.devicePixelRatio,
        )
      : { w: 1, h: 1 };

  // Preferred: draw in a worker (OffscreenCanvas), so ground frames never
  // wake the main thread. The data-live flag (and with it the canvas over
  // the CSS fallback) is set once, when the first frame is up.
  const startWorker = (target: HTMLCanvasElement) => {
    if (
      !("transferControlToOffscreen" in target) ||
      typeof Worker === "undefined"
    ) {
      return false;
    }
    try {
      const worker = new Worker(
        new URL("./ground.worker.ts", import.meta.url),
        {
          type: "module",
        },
      );
      const offscreen = target.transferControlToOffscreen();
      worker.addEventListener("message", (event: MessageEvent) => {
        if (event.data?.type === "drawn") target.setAttribute("data-live", "");
        if (event.data?.type === "lost") target.removeAttribute("data-live");
      });
      worker.postMessage(
        {
          type: "init",
          canvas: offscreen,
          colors: readColors(),
          ...size(),
          run: shouldRun(),
        },
        [offscreen],
      );
      onMotionChange = () =>
        worker.postMessage({ type: "state", ...size(), run: shouldRun() });
      return true;
    } catch {
      return false;
    }
  };

  // Fallback: the same shader on the main thread.
  const startMainThread = (target: HTMLCanvasElement) => {
    const gl = target.getContext("webgl", CONTEXT_OPTIONS);
    const renderer = gl ? createGround(gl, readColors()) : null;
    if (!renderer) return;

    let elapsed = START_TIME;
    let last = 0;
    let frame = 0;
    let lost = false;
    let shown = false;

    target.addEventListener("webglcontextlost", (event) => {
      event.preventDefault();
      lost = true;
      if (frame) cancelAnimationFrame(frame);
      frame = 0;
      target.removeAttribute("data-live");
    });

    const draw = () => {
      if (lost) return;
      renderer.draw(elapsed);
      // Once only: touching the DOM every frame would force a style pass
      // over every running animation.
      if (!shown) {
        target.setAttribute("data-live", "");
        shown = true;
      }
    };

    const resize = () => {
      const { w, h } = size();
      if (target.width !== w || target.height !== h) {
        target.width = w;
        target.height = h;
        renderer.resize(w, h);
      }
    };

    const tick = (now: number) => {
      frame = 0;
      if (lost || !shouldRun()) return;
      if (!last) last = now;
      const dt = now - last;
      if (dt >= FRAME_MS) {
        elapsed += Math.min(dt, 100) / 1000;
        last = now;
        draw();
      }
      frame = requestAnimationFrame(tick);
    };

    const sync = () => {
      resize();
      if (!lost && shouldRun()) {
        if (!frame) {
          last = 0;
          frame = requestAnimationFrame(tick);
        }
      } else {
        if (frame) cancelAnimationFrame(frame);
        frame = 0;
        draw();
      }
    };

    onMotionChange = sync;
    sync();
  };

  if (canvas) {
    if (!startWorker(canvas)) startMainThread(canvas);
    window.addEventListener("resize", () => onMotionChange());
    document.addEventListener("visibilitychange", () => onMotionChange());
    reduceMotion.addEventListener("change", () => onMotionChange());
  }
</script>
