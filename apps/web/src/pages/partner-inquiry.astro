---
// /partner-inquiry: the form where interested companies reach the partner
// team (DESIGN.md INQUIRY-1). Frontend only for now: the form validates and
// reports, it does not send (see InquiryForm.astro). The URL is written once,
// as PARTNER_INQUIRY_PATH in lib/partner-inquiry.ts; `?type=company`,
// `media`, `initiative` or `speaker` preselects the matching tile.
//
// The header is the shared floating glass bar from Base.astro (COMP-6).
import Base from "../layouts/Base.astro";
import InquiryForm from "../components/inquiry/InquiryForm.astro";
import InquiryIntro from "../components/inquiry/InquiryIntro.astro";
import InquiryPage from "../components/inquiry/InquiryPage.astro";
---

<Base
  title="Partner inquiry"
  description="Tell the Q-Summit partner team what matters to you, and we get back to you personally."
  noindex
>
  {
    /* noindex while the form is not connected: a page that cannot send must
       not appear in search. Remove this prop when the mail hand-off ships;
       the sitemap and the route table in lib/llms.ts follow then too. */
  }
  <InquiryPage>
    <InquiryIntro />
    <InquiryForm />
  </InquiryPage>
</Base>
