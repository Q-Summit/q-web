---
// Site navigation. Link targets keep the live site's URL paths so existing
// inbound links keep working at cutover. Matches the live nav exactly: 7
// items, home reachable via the logo only (no Home/Tickets/Contact entries).
//
// Sticky on all viewports -> replaced by position:fixed + spacer: sticky
// reflows against mobile browser chrome and vibrates the hamburger on scroll.
// Below 768px: disclosure hamburger (WAI APG) via nav-menu.client.ts.
// Without JS the mobile list stays visible and stacked.
import { logoHeight, logoSrc, logoWidth } from "../../assets/media/brand";
import { getSiteSettings } from "../../lib/content";
import { normalizeInternalHref } from "../../lib/href";
import IconClose from "../icons/IconClose.astro";
import IconMenu from "../icons/IconMenu.astro";

interface Props {
  /**
   * Neutral liquid glass bar (DESIGN.md TICKETS-1): translucent white, a
   * measured backdrop blur, a lit edge and a soft shadow, plus a light
   * material on the logo that never changes its drawing. Opt-in; only the
   * ticket page sets it.
   */
  glass?: boolean;
}

const { glass = false } = Astro.props;
const { nav } = await getSiteSettings();

// Nav lockup: ~3rem tall reads as a normal header mark. Taller than that
// dominates the bar; much shorter and Mannheim becomes a blur.
const logoDisplayHeight = 48;
const logoDisplayWidth = Math.round(
  (logoWidth / logoHeight) * logoDisplayHeight,
);

// link.href comes from getSiteSettings() already run through
// normalizeInternalHref (astro.config.mjs pins trailingSlash: "always"), so
// this side has to go through the same normalization or the comparison below
// never matches (e.g. "/whyq" !== "/whyq/").
const currentPath = normalizeInternalHref(Astro.url.pathname);

// Exact match plus section prefix so sub-routes keep their parent highlighted
// (job detail pages under /job-listings/). Hrefs are trailing-slashed, so the
// prefix test cannot cross-match sibling paths ("/job" vs "/jobs").
const isCurrent = (href: string): boolean =>
  currentPath === href ||
  (href !== "/" && href.startsWith("/") && currentPath.startsWith(href));
---

<header class:list={["site-header", { "is-glass": glass }]} id="site-header">
  <div class="container nav-inner">
    <a class="brand" href="/">
      {
        glass && (
          <span
            class="brand-gloss"
            aria-hidden="true"
            style={`--brand-mask: url(${logoSrc})`}
          />
        )
      }
      <img
        src={logoSrc}
        alt="Q-Summit home"
        width={logoDisplayWidth}
        height={logoDisplayHeight}
        loading="eager"
        decoding="async"
      />
    </a>
    <button
      type="button"
      class="nav-toggle"
      aria-expanded="false"
      aria-controls="site-nav"
      aria-label="Open menu"
    >
      <span class="nav-toggle__icon nav-toggle__icon--menu">
        <IconMenu />
      </span>
      <span class="nav-toggle__icon nav-toggle__icon--close">
        <IconClose />
      </span>
    </button>
    <nav id="site-nav" aria-label="Main">
      <ul>
        {
          nav.map((link) => (
            <li>
              <a
                href={link.href}
                aria-current={isCurrent(link.href) ? "page" : undefined}
                data-astro-prefetch="hover"
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>
{/* Holds document flow under the fixed bar so content is not covered. */}
<div class="site-header-spacer" aria-hidden="true"></div>

{
  /* Runs before paint so mobile does not flash the full stacked list while
     the deferred module script loads. No-JS: this never runs -> list stays
     visible (progressive enhancement). */
}
<script is:inline>
  (() => {
    const header = document.getElementById("site-header");
    if (!header || !window.matchMedia("(max-width: 767px)").matches) return;
    header.setAttribute("data-js", "true");
    const nav = document.getElementById("site-nav");
    if (nav) nav.hidden = true;
  })();
</script>

<script>
  import { initNavMenu } from "./nav-menu.client";

  document
    .querySelectorAll<HTMLElement>(".site-header:not([data-nav-ready])")
    .forEach((header) => {
      header.setAttribute("data-nav-ready", "true");
      initNavMenu(header);
    });
</script>

<style is:global>
  /* Reserve scrollbar space so locking overflow does not shift the fixed
     header sideways when the menu opens. */
  html {
    scrollbar-gutter: stable;
  }

  /* Scroll lock while the mobile disclosure is open. */
  html.is-nav-open,
  html.is-nav-open body {
    overflow: hidden;
  }
</style>

<style>
  /*
    Fixed header (not sticky). Sticky + mobile URL-bar show/hide makes the
    bar/hamburger vibrate on scroll. Fixed pins to the viewport; the spacer
    below keeps page content from sliding under it.
  */
  .site-header {
    /* Compact bar: 3rem logo + 0.5rem pad each side ~ 4rem total - a normal
       site header, not a billboard. */
    --site-header-pad-block: var(--space-2xs);
    --site-header-logo-height: 3rem;
    --site-header-height: calc(
      var(--site-header-logo-height) + 2 * var(--site-header-pad-block) + 1px
    );

    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    height: var(--site-header-height);
    background-color: var(--color-background);
    border-bottom: 1px solid var(--color-neutral-lighter);
  }

  .site-header-spacer {
    flex-shrink: 0;
    height: var(--site-header-height, 4.01rem);
  }

  /* Mirror header height tokens onto the spacer (sibling, not child). */
  .site-header + .site-header-spacer {
    --site-header-pad-block: var(--space-2xs);
    --site-header-logo-height: 3rem;
    --site-header-height: calc(
      var(--site-header-logo-height) + 2 * var(--site-header-pad-block) + 1px
    );
    height: var(--site-header-height);
  }

  .nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-md);
    height: 100%;
    padding-block: var(--site-header-pad-block);
  }

  .brand {
    flex: 0 0 auto;
    display: block;
    line-height: 0;
    text-decoration: none;
  }

  .brand img {
    display: block;
    height: var(--site-header-logo-height);
    width: auto;
  }

  @media (max-width: 767px) {
    .site-header,
    .site-header + .site-header-spacer {
      /* Slightly smaller on phones so logo + hamburger share the row. */
      --site-header-logo-height: 2.75rem;
    }

    /* No-JS: stay in normal flow so the stacked link list is not clipped
       by the fixed bar height. Inline script sets data-js before paint. */
    .site-header:not([data-js]) {
      position: relative;
      height: auto;
    }

    .site-header:not([data-js]) + .site-header-spacer {
      display: none;
    }
  }

  .nav-toggle {
    /* Hidden until JS enhances on small viewports (see [data-js] below). */
    display: none;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: 2.75rem;
    height: 2.75rem;
    margin: 0;
    padding: 0;
    border: none;
    background: transparent;
    color: var(--color-text);
    cursor: pointer;
    border-radius: var(--radius-button-small);
    -webkit-tap-highlight-color: transparent;
    touch-action: manipulation;
  }

  .nav-toggle:focus-visible {
    outline: 2px solid var(--color-focus);
    outline-offset: 2px;
  }

  .nav-toggle__icon {
    display: flex;
    width: 1.5rem;
    height: 1.5rem;
  }

  .nav-toggle__icon :global(svg) {
    width: 100%;
    height: 100%;
  }

  .nav-toggle__icon--close {
    display: none;
  }

  .site-header[data-open] .nav-toggle__icon--menu {
    display: none;
  }

  .site-header[data-open] .nav-toggle__icon--close {
    display: flex;
  }

  nav ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs) 1.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  nav a {
    color: var(--color-text);
    text-decoration: none;
    font-size: var(--text-size-regular);
    font-weight: var(--font-weight-medium);
  }

  nav a[aria-current="page"] {
    color: var(--color-primary);
  }

  @media (hover: hover) {
    nav a:hover {
      color: var(--color-primary);
    }
  }

  /* Mobile: without JS the list stacks under the logo (usable). With JS the
     hamburger appears and the list becomes a disclosure panel. */
  @media (max-width: 767px) {
    .nav-inner {
      flex-wrap: wrap;
    }

    .site-header[data-js] .nav-toggle {
      display: inline-flex;
      margin-left: auto;
    }

    .site-header[data-js] .nav-inner {
      flex-wrap: nowrap;
    }

    .site-header[data-js]:not([data-open]) #site-nav[hidden] {
      display: none;
    }

    .site-header[data-js][data-open] #site-nav {
      display: block;
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      z-index: 1;
      background-color: var(--color-background);
      border-bottom: 1px solid var(--color-neutral-lighter);
      padding: var(--space-sm) var(--padding-global) var(--space-md);
      max-height: min(70svh, calc(100svh - var(--site-header-height)));
      overflow-y: auto;
      overscroll-behavior: contain;
    }

    nav ul {
      flex-direction: column;
      flex-wrap: nowrap;
      gap: 0;
      width: 100%;
    }

    nav a {
      display: flex;
      align-items: center;
      min-height: 2.75rem;
      padding-block: 0.625rem;
    }
  }

  @media (min-width: 768px) {
    .nav-toggle {
      display: none;
    }

    nav {
      display: block;
    }

    nav ul {
      flex-wrap: wrap;
      flex-direction: row;
      width: auto;
    }
  }
  /*
    Glass variant (DESIGN.md TICKETS-1), the ticket page only: a floating
    bar inset from the viewport edges, after the reference header the team
    picked. Liquid glass with no tint of its own: mostly clear, a strong
    blur that lifts brightness and color from what lies behind, and a still
    specular rim (no light ever sweeps across the menu). Links are small
    chips with a faint fill; the current page is a raised white chip.
  */
  .site-header.is-glass,
  .site-header.is-glass + .site-header-spacer {
    --site-header-inset: var(--space-xs);
    --site-header-bar: 3.75rem;
    --site-header-logo-height: 2.25rem;
    --site-header-height: calc(
      var(--site-header-bar) + var(--site-header-inset)
    );
  }

  .site-header.is-glass {
    padding: var(--site-header-inset) var(--site-header-inset) 0;
    border-bottom: 0;
    background-color: transparent;
    /* The gutter around the bar is see-through; clicks pass to the page. */
    pointer-events: none;
  }

  .is-glass .nav-inner {
    position: relative;
    height: var(--site-header-bar);
    padding-block: 0;
    padding-inline: var(--space-md) var(--space-2xs);
    border-radius: var(--radius-ticket-panel);
    /* Clear light-grey glass, one flat tone with no gradient of its own:
       the page's moving light shows through, softened by the blur. Depth
       comes only from its edges: a lit top rim, a faint lower edge and
       thin side lights, the way a slab of glass catches light. */
    background: color-mix(
      in srgb,
      var(--color-neutral-lightest) 22%,
      transparent
    );
    box-shadow:
      inset 0 1px 1px color-mix(in srgb, var(--color-white) 95%, transparent),
      inset 0 -1px 1px color-mix(in srgb, var(--color-black) 8%, transparent),
      inset 1px 0 0 color-mix(in srgb, var(--color-white) 35%, transparent),
      inset -1px 0 0 color-mix(in srgb, var(--color-white) 35%, transparent),
      0 10px 30px -18px color-mix(in srgb, var(--color-black) 22%, transparent);
    pointer-events: auto;
    -webkit-backdrop-filter: blur(14px) saturate(140%);
    backdrop-filter: blur(14px) saturate(140%);
  }

  /* The specular rim: bright where light meets the edge, never moving. */
  .is-glass .nav-inner::after {
    content: "";
    position: absolute;
    inset: 0;
    padding: 1px;
    border-radius: inherit;
    background: linear-gradient(
      150deg,
      color-mix(in srgb, var(--color-white) 95%, transparent) 0%,
      color-mix(in srgb, var(--color-white) 25%, transparent) 25%,
      transparent 45%,
      transparent 60%,
      color-mix(in srgb, var(--color-white) 45%, transparent) 85%,
      color-mix(in srgb, var(--color-white) 90%, transparent) 100%
    );
    pointer-events: none;
    -webkit-mask:
      linear-gradient(var(--color-black) 0 0) content-box,
      linear-gradient(var(--color-black) 0 0);
    -webkit-mask-composite: xor;
    mask:
      linear-gradient(var(--color-black) 0 0) content-box exclude,
      linear-gradient(var(--color-black) 0 0);
  }

  /* Without backdrop blur, near-opaque so text never sits on raw light. */
  @supports not (
    (backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))
  ) {
    .is-glass .nav-inner {
      background: color-mix(in srgb, var(--color-white) 95%, transparent);
    }
  }

  .is-glass nav a {
    border-radius: var(--radius-ticket-button);
    color: var(--color-neutral-darkest);
    font-size: var(--text-size-tiny);
    font-weight: var(--font-weight-semibold);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    transition: background-color var(--duration-hover) var(--ease-snappy);
  }

  .is-glass nav a[aria-current="page"] {
    color: var(--color-neutral-darkest);
    background-color: color-mix(in srgb, var(--color-white) 85%, transparent);
    box-shadow:
      inset 0 1px 0 var(--color-white),
      0 0 0 1px color-mix(in srgb, var(--color-black) 6%, transparent);
  }

  @media (hover: hover) {
    .is-glass nav a:hover {
      color: var(--color-neutral-darkest);
      background-color: color-mix(in srgb, var(--color-black) 5%, transparent);
    }
  }

  .is-glass nav a:active {
    background-color: color-mix(in srgb, var(--color-black) 9%, transparent);
  }

  .is-glass .nav-toggle {
    border-radius: var(--radius-ticket-button);
    background-color: color-mix(in srgb, var(--color-black) 4%, transparent);
    color: var(--color-neutral-darkest);
    transition: background-color var(--duration-hover) var(--ease-snappy);
  }

  .is-glass .nav-toggle:active {
    background-color: color-mix(in srgb, var(--color-black) 9%, transparent);
  }

  /*
    Logo material: the original lockup, unchanged in drawing. A soft
    shadow lifts it off the glass and a gloss masked by the logo itself
    catches light on the upper half. At header size both stay faint so the
    Q and the wordmark keep their crisp edges.
  */
  .is-glass .brand {
    position: relative;
  }

  .is-glass .brand img {
    filter: drop-shadow(
      0 1px 2px
        color-mix(in srgb, var(--color-ticket-midnight) 22%, transparent)
    );
  }

  .brand-gloss {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background: linear-gradient(
      172deg,
      color-mix(in srgb, var(--color-white) 50%, transparent) 0%,
      color-mix(in srgb, var(--color-white) 10%, transparent) 42%,
      transparent 48%
    );
    -webkit-mask: var(--brand-mask) center / contain no-repeat;
    mask: var(--brand-mask) center / contain no-repeat;
  }

  @media (max-width: 767px) {
    .site-header.is-glass,
    .site-header.is-glass + .site-header-spacer {
      --site-header-inset: var(--space-2xs);
      --site-header-bar: 3.5rem;
      --site-header-logo-height: 2rem;
    }

    .is-glass .nav-inner {
      padding-inline: var(--space-sm) 0.375rem;
    }

    /*
     * The open menu is a second floating sheet under the bar: an opaque
     * liquid surface in the Q27 blues, like the ticket cards. Its base is
     * solid, so no page text ever shows through behind the links; on it,
     * pools of ice, cyan and Q27 blue light turn and stretch (transform
     * only), lit by a glass rim and a cyan glow along the lower edge.
     */
    .site-header.is-glass[data-js][data-open] #site-nav {
      top: calc(100% + var(--space-2xs));
      right: var(--site-header-inset);
      left: var(--site-header-inset);
      isolation: isolate;
      overflow: hidden;
      padding: var(--space-2xs);
      border-bottom: 0;
      border-radius: var(--radius-ticket-panel);
      background:
        radial-gradient(80% 60% at 12% 0%, var(--color-white), transparent 70%),
        linear-gradient(
          165deg,
          var(--color-ticket-ground) 0%,
          var(--color-ticket-ice) 62%,
          color-mix(
              in srgb,
              var(--color-ticket-sky) 28%,
              var(--color-ticket-ice)
            )
            100%
        );
      box-shadow:
        inset 0 1px 1px var(--color-white),
        inset 0 0 0 1px color-mix(in srgb, var(--color-white) 65%, transparent),
        inset 0 -26px 36px -26px
          color-mix(in srgb, var(--color-ticket-cyan) 80%, transparent),
        0 0 0 1px color-mix(in srgb, var(--color-navy) 6%, transparent),
        0 22px 44px -20px color-mix(in srgb, var(--color-navy) 40%, transparent);
      pointer-events: auto;
      animation: nav-sheet-in var(--duration-open) var(--ease-emphasized);
    }

    /* The moving light: two oversized layers behind the links. */
    .site-header.is-glass[data-js][data-open] #site-nav::before,
    .site-header.is-glass[data-js][data-open] #site-nav::after {
      content: "";
      position: absolute;
      z-index: -1;
      pointer-events: none;
    }

    .site-header.is-glass[data-js][data-open] #site-nav::before {
      inset: -45%;
      background:
        radial-gradient(
          30% 20% at 34% 38%,
          color-mix(in srgb, var(--color-ticket-cyan) 60%, transparent),
          transparent
        ),
        radial-gradient(
          26% 32% at 68% 64%,
          color-mix(in srgb, var(--color-white) 85%, transparent),
          transparent
        ),
        radial-gradient(
          22% 16% at 60% 28%,
          color-mix(in srgb, var(--color-ticket-sky) 30%, transparent),
          transparent
        );
    }

    .site-header.is-glass[data-js][data-open] #site-nav::after {
      inset: -40%;
      background:
        radial-gradient(
          30% 22% at 62% 72%,
          color-mix(in srgb, var(--color-ticket-sky) 34%, transparent),
          transparent
        ),
        radial-gradient(
          20% 28% at 28% 66%,
          color-mix(in srgb, var(--color-ticket-cyan) 40%, transparent),
          transparent
        );
    }

    /* The sheet clips the moving light; the link list scrolls instead,
       so a short landscape screen still reaches every link. */
    .site-header.is-glass[data-js][data-open] #site-nav ul {
      position: relative;
      z-index: 1;
      max-height: calc(
        min(70svh, 100svh - var(--site-header-height)) - 2 * var(--space-2xs)
      );
      overflow-y: auto;
      overscroll-behavior: contain;
    }

    .is-glass nav a {
      padding-inline: var(--space-sm);
      color: var(--color-navy);
      font-size: var(--text-size-small);
    }

    .is-glass nav a[aria-current="page"] {
      color: var(--color-navy);
    }
  }

  @media (max-width: 767px) and (prefers-reduced-motion: no-preference) {
    .site-header.is-glass[data-js][data-open] #site-nav::before {
      animation: nav-liquid var(--duration-ticket-drift) ease-in-out infinite
        alternate;
    }

    .site-header.is-glass[data-js][data-open] #site-nav::after {
      animation: nav-liquid-alt var(--duration-ticket-drift-alt) ease-in-out
        infinite alternate;
    }
  }

  @keyframes nav-sheet-in {
    from {
      opacity: 0;
      transform: translateY(-6px) scale(0.98);
    }
  }

  @keyframes nav-liquid {
    0% {
      transform: translate3d(-5%, -3%, 0) rotate(0deg) scale(1.08, 0.94);
    }

    50% {
      transform: translate3d(4%, 5%, 0) rotate(70deg) scale(0.94, 1.1);
    }

    100% {
      transform: translate3d(6%, -4%, 0) rotate(140deg) scale(1.06, 0.96);
    }
  }

  @keyframes nav-liquid-alt {
    0% {
      transform: translate3d(5%, 4%, 0) rotate(0deg) scale(0.95, 1.08);
    }

    50% {
      transform: translate3d(-4%, -2%, 0) rotate(-60deg) scale(1.1, 0.92);
    }

    100% {
      transform: translate3d(-6%, 5%, 0) rotate(-120deg) scale(0.98, 1.04);
    }
  }

  @media (min-width: 768px) {
    .is-glass nav ul {
      gap: var(--space-2xs) 0.25rem;
    }

    .is-glass nav a {
      display: inline-flex;
      align-items: center;
      min-height: 2.25rem;
      padding-inline: var(--space-xs);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .is-glass nav a,
    .is-glass .nav-toggle {
      transition: none;
    }

    .site-header.is-glass[data-js][data-open] #site-nav {
      animation: none;
    }
  }
</style>
