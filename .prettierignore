apps/cms/src/migrations/*.json

# Next.js rewrites this file on every `next build`, re-adding its required
# `include` entries and reformatting as it goes. Since `pnpm run check` now
# runs `next build` (check:cms:build), letting prettier own it meant the gate
# dirtied the tree and the NEXT run failed format:check. Next owns it.
apps/cms/tsconfig.json

# Generated by tooling, not hand-formatted. Reformatting them would fight the
# generator on the next `payload generate:types` / `generate:migrations` /
# `cf-typegen` run and produce a diff nobody authored.
apps/cms/src/payload-types.ts
apps/cms/src/migrations/*.ts
apps/cms/src/app/(payload)/importMap.js
apps/web/worker-configuration.d.ts
apps/web/.astro
apps/web/src/env.d.ts
