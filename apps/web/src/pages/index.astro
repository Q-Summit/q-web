---
// Homepage for the 10th edition (DESIGN.md HOME-1): video hero with the
// anniversary message, a countdown and Buy Now, then key figures,
// partner rows, the four audience tiles, speaker highlights and the
// LinkedIn / Instagram section, on a ground of light with clear glass
// panes and glass Q objects.
// All content loads at build time from the content layer
// (src/lib/content.ts). The page is complete without JavaScript; scripts
// only add the video stream, the countdown and the motion
// (components/home/home.client.ts).
import Base from "../layouts/Base.astro";
import Hero from "../components/home/Hero.astro";
import StatsBand from "../components/home/StatsBand.astro";
import PartnerLogos from "../components/home/PartnerLogos.astro";
import SpeakerGrid from "../components/home/SpeakerGrid.astro";
import WhyCards from "../components/home/WhyCards.astro";
import SocialSection from "../components/home/SocialSection.astro";
import HomeGround from "../components/home/HomeGround.astro";
import JsonLd from "../components/seo/JsonLd.astro";
import logoManifest from "../components/partner/logo-manifest.json";
import {
  getPageContent,
  getPartners,
  getSiteSettings,
  getSpeakers,
  speakersForEdition,
} from "../lib/content";
import type { PageStat, Partner } from "../lib/content";
import {
  resolvePartnerLogoDisplay,
  type PartnerLogoMeta,
} from "../lib/partner-logos";

const { kickoff } = await getSiteSettings();
if (kickoff.pageEnabled && kickoff.redirectRoot) {
  return Astro.redirect("/kickoff/", 308);
}

const partnerLogoManifest = logoManifest as Record<string, PartnerLogoMeta>;

const [pageContent, allSpeakers, allPartners, { siteTitle, footer }] =
  await Promise.all([
    getPageContent(),
    getSpeakers(),
    getPartners(),
    getSiteSettings(),
  ]);
const { home, contact } = pageContent;

// The partner band stores each logo as the partner name shown on the live
// site's slider; match those (case/punctuation-insensitive) against the real
// partner records so the strip can reuse the same logo files and links as
// the /partner page. Exact normalized equality only: a substring fallback
// used to also accept e.g. "Uber" matching "Zauber" ('zauber'.includes('uber')
// is true), silently substituting one partner's logo/link for the other's
// depending on array order. If partner names ever need genuine fuzzy
// matching, reference the partner by a stable id/slug instead.
function normalizePartnerName(name: string): string {
  return name.toLowerCase().replace(/[^a-z0-9]/g, "");
}

function findPartner(name: string): Partner | undefined {
  const target = normalizePartnerName(name);
  return allPartners.find(
    (partner) => normalizePartnerName(partner.name) === target,
  );
}

function resolvePartnerLogoGroups(stats: PageStat[]) {
  return stats
    .map((stat) => ({
      label: stat.label,
      description: stat.description,
      logos: (stat.logos ?? []).flatMap((name) => {
        const partner = findPartner(name);
        if (!partner) {
          console.warn(
            `[index] partner band: no partner named "${name}" found; skipped`,
          );
          return [];
        }
        const logo = resolvePartnerLogoDisplay(
          partner,
          partnerLogoManifest,
          "[index] partner band",
        );
        return logo ? [logo] : [];
      }),
    }))
    .filter((group) => group.logos.length > 0);
}

const partnerLogoGroups = resolvePartnerLogoGroups(home.partnerBand.items);

// Past speakers: the names the content lists, in that order, looked up in
// the speakers collection (photo and role come from there, never from this
// page). A name with no published speaker is skipped with a warning.
// Without a list, the "panel" group (the main stage highlights) is shown.
const speakerHighlights = home.previousSpeakers.highlights;
const alumni = speakerHighlights
  ? speakerHighlights.flatMap((name) => {
      const speaker =
        allSpeakers.find((s) => s.name === name && s.group === "panel") ??
        allSpeakers.find((s) => s.name === name);
      if (!speaker) {
        console.warn(
          `[index] speaker highlights: no speaker named "${name}" found; skipped`,
        );
      }
      return speaker ? [speaker] : [];
    })
  : allSpeakers.filter((s) => s.group === "panel");

// The next edition's lineup: its published "current" speakers. While it
// has none, the content may name earlier speakers to show in its place
// (stand-ins); they keep their own badge and are never shown as booked.
const lineupConfig = home.previousSpeakers.lineup;
const booked = lineupConfig
  ? speakersForEdition(allSpeakers, "current", lineupConfig.year)
  : [];
const standIns =
  booked.length === 0
    ? (home.previousSpeakers.standIns ?? []).flatMap((name) => {
        // The same person may be listed under several groups; take the
        // edition entry first (it carries the current role and photo).
        const speaker =
          allSpeakers.find((s) => s.name === name && s.group === "current") ??
          allSpeakers.find((s) => s.name === name && s.group === "panel") ??
          allSpeakers.find((s) => s.name === name);
        if (!speaker) {
          console.warn(
            `[index] lineup stand-ins: no speaker named "${name}" found; skipped`,
          );
        }
        return speaker ? [speaker] : [];
      })
    : [];
const lineup = booked.length > 0 ? booked : standIns;
const lineupLabel =
  booked.length > 0 ? lineupConfig?.label : home.previousSpeakers.standInLabel;

// Profile links are the ones Site Settings already holds.
const socialHref = (platform: string) =>
  footer.socialLinks.find((link) => link.platform === platform)?.href;

/* Structured data (homepage only; see SEO spec s4). Every value traces to a
 * content field: no invented facts. URLs are absolute, built from Astro.site
 * (already trailing-slashed to match canonicals/sitemap). @id anchors let the
 * WebSite and Event reference the Organization across the separate blocks. */
const orgId = new URL("#organization", Astro.site).href;
const websiteId = new URL("#website", Astro.site).href;
const siteHref = new URL("/", Astro.site).href;
const logoUrl = new URL("/media/q-summit-logo-lockup.webp", Astro.site).href;
const heroPosterUrl = new URL("/media/hero-poster.jpg", Astro.site).href;

// contact.reachOut.items: the registered-association entry (the one with no
// email) carries the legal name; the "Email" entry carries the public address.
const legalEntity = contact.reachOut.items.find((item) => !item.email);
const contactEmail = contact.reachOut.items.find(
  (item) => item.label === "Email",
)?.email;

const organizationLd = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "@id": orgId,
  name: siteTitle,
  ...(legalEntity ? { legalName: legalEntity.label } : {}),
  url: siteHref,
  logo: logoUrl,
  description: footer.tagline,
  ...(contactEmail ? { email: contactEmail } : {}),
  // Hardcoded from the contact address "L1, 1; 68161; Mannheim; Germany"
  // (and the imprint) rather than split at build; addressCountry is ISO 3166.
  address: {
    "@type": "PostalAddress",
    streetAddress: "L1, 1",
    postalCode: "68161",
    addressLocality: "Mannheim",
    addressCountry: "DE",
  },
  sameAs: footer.socialLinks.map((link) => link.href),
};

const websiteLd = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "@id": websiteId,
  name: siteTitle,
  url: siteHref,
  publisher: { "@id": orgId },
};

// Event dates come from the dedicated home.event fields in the CMS, not from
// parsing hero.announcementLines. That parsing was the bug: announcementLines
// is display copy an editor rewrites freely, and the regex only accepted one
// same-month shape ("April 1-2, 2027"). A cross-month span, an en dash, a
// German format, or simply deleting the line threw here at build time, which
// failed `astro build` and so blocked every subsequent deploy of the entire
// site until someone changed code. Editors now set real dates in a date
// picker, and the banner copy is free text again.
//
// Date-only (no time/timezone in content). No offers (only past-2026 ticket
// URLs exist) and no venue name/street (absent from all content), so both
// are omitted per spec. The city-level location IS sourced: the footer
// tagline (site-settings) states the conference is "organized in Mannheim
// since 2017" as a standing claim, and the organization's registered address
// is Mannheim.
const eventDates = {
  name: `Q-Summit ${home.event.startDate.slice(0, 4)}`,
  startDate: home.event.startDate,
  endDate: home.event.endDate,
};

const eventLd = {
  "@context": "https://schema.org",
  "@type": "Event",
  name: eventDates.name,
  startDate: eventDates.startDate,
  endDate: eventDates.endDate,
  eventStatus: "https://schema.org/EventScheduled",
  eventAttendanceMode: "https://schema.org/OfflineEventAttendanceMode",
  location: {
    "@type": "Place",
    address: {
      "@type": "PostalAddress",
      addressLocality: "Mannheim",
      addressCountry: "DE",
    },
  },
  image: heroPosterUrl,
  description: home.metaDescription,
  url: siteHref,
  organizer: { "@id": orgId },
};
---

<Base
  title={home.title}
  description={home.metaDescription}
  preloadImage="/media/hero-poster.jpg"
  livePreviewGlobal="page-home"
>
  <Fragment slot="jsonld">
    <JsonLd data={organizationLd} />
    <JsonLd data={websiteLd} />
    <JsonLd data={eventLd} />
  </Fragment>
  <Hero
    headline={home.hero.headline}
    announcement={home.hero.announcementLines}
    cta={home.hero.cta}
    badge={home.hero.badge}
    leadLines={home.hero.leadLines}
    countdown={home.countdown}
    startDate={home.event.startDate}
  />
  <div class="home-page">
    <HomeGround />
    <StatsBand
      tagline={home.hero.tagline}
      heading={home.stats.heading}
      stats={home.stats.items}
    />
    <PartnerLogos
      eyebrow={home.partnerBand.eyebrow}
      heading={home.partnerBand.heading}
      groups={partnerLogoGroups}
      cta={home.partnerBand.cta}
    />
    <WhyCards
      eyebrow={home.whyAttend.eyebrow}
      heading={home.whyAttend.heading}
      intro={home.whyAttend.intro}
      cards={home.whyAttend.cards}
    />
    <SpeakerGrid
      eyebrow={home.previousSpeakers.eyebrow}
      heading={home.previousSpeakers.heading}
      cta={home.previousSpeakers.cta}
      alumni={alumni}
      alumniLabel={home.previousSpeakers.alumniLabel}
      lineup={lineup}
      lineupLabel={lineupLabel}
      lineupSlots={Math.max(lineupConfig?.slots ?? 0, standIns.length)}
      placeholders={standIns.length === 0 && lineupConfig?.showPlaceholders}
      placeholderName={lineupConfig?.placeholderName}
      placeholderRole={lineupConfig?.placeholderRole}
    />
    {
      home.social && (
        <SocialSection
          social={home.social}
          linkedinHref={socialHref("linkedin")}
          instagramHref={socialHref("instagram-qsummit")}
        />
      )
    }
    <div class="h-page-fade" aria-hidden="true"></div>
  </div>
</Base>

<script>
  import { initHomePage } from "../components/home/home.client";

  initHomePage();
</script>
