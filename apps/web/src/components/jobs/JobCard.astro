---
// One job listing card, ported from the Webflow ".job-card" row: white
// logo box, role, location with a pin icon, and a workload badge. The
// whole card links to the static detail page under /job-listings/[slug].
import type { Job } from "../../lib/content";
import { logoSrc } from "./logo";
import IconMapPin from "../icons/IconMapPin.astro";

interface Props {
  job: Job;
}

const { job } = Astro.props;

// The card is one big link built from adjacent <span>s (company, title,
// location, workload); with no punctuation between them the accessible
// name algorithm runs the text together (e.g. "AndercoreEntrepreneur in
// Resid..."). An explicit aria-label supplies the same real data with
// proper separation (2.4.4/1.3.1) instead of relying on DOM text order.
const accessibleName = [job.company, job.title, job.location, job.workload]
  .filter((part): part is string => Boolean(part))
  .join(", ");
---

<a
  class="job-card"
  href={`/job-listings/${job.slug}/`}
  aria-label={accessibleName}
>
  <span class="logo-box">
    <img
      src={logoSrc(job.logoFilename)}
      alt={`${job.company} logo`}
      width="240"
      height="120"
      loading="lazy"
    />
  </span>
  <span class="job-main">
    <span class="job-company">{job.company}</span>
    <span class="job-title">{job.title}</span>
  </span>
  <span class="job-meta">
    {
      job.location && (
        <span class="job-location">
          <IconMapPin />
          {job.location}
        </span>
      )
    }
    {job.workload && <span class="job-workload">{job.workload}</span>}
  </span>
</a>

<style>
  .job-card {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    width: 100%;
    padding: var(--space-sm) var(--space-md);
    background-color: var(--color-white);
    border-radius: var(--radius-card);
    box-shadow: var(--shadow-card);
    text-decoration: none;
    transition:
      box-shadow var(--duration-hover) var(--ease-snappy),
      transform var(--duration-hover) var(--ease-snappy);
  }

  @media (hover: hover) {
    .job-card:hover {
      box-shadow: var(--shadow-card-hover);
      transform: translateY(-2px);
    }
  }

  .logo-box {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: 8.75rem;
    height: 4.375rem;
    padding: 0.25rem var(--space-2xs);
    background-color: var(--color-white);
    border: 1px solid var(--color-neutral-lighter);
    border-radius: var(--radius-button);
  }

  .logo-box img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .job-main {
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
    flex: 1;
    min-width: 0;
    padding-left: var(--space-md);
    border-left: 2px solid var(--color-primary);
  }

  .job-company {
    font-size: var(--text-size-small);
    font-weight: var(--font-weight-semibold);
    color: var(--color-neutral-dark);
  }

  .job-title {
    font-size: var(--text-size-medium);
    font-weight: var(--font-weight-semibold);
    color: var(--color-heading);
    line-height: var(--heading-line-height-normal);
  }

  .job-meta {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    flex-shrink: 0;
  }

  .job-location {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    font-size: var(--text-size-small);
    color: var(--color-neutral-dark);
  }

  /* :global, because the svg is rendered by IconMapPin and so carries that
     component's scope, not this one's (DESIGN.md COMP-3). */
  .job-location :global(svg) {
    flex-shrink: 0;
    color: var(--color-neutral-dark);
  }

  .job-workload {
    padding: 0.3rem 0.9rem;
    background-color: var(--color-primary);
    color: var(--color-text-inverse);
    border-radius: var(--radius-pill);
    font-size: var(--text-size-small);
    font-weight: var(--font-weight-semibold);
    white-space: nowrap;
  }

  @media (max-width: 767px) {
    .job-card {
      flex-direction: column;
      gap: 0.875rem;
      padding: var(--space-md) 1.25rem;
      text-align: center;
    }

    .job-main {
      align-items: center;
      padding-left: 0;
      padding-top: 0.875rem;
      border-left: none;
      border-top: 2px solid var(--color-primary);
      width: 100%;
      max-width: 16rem;
    }

    .job-meta {
      flex-direction: column;
      gap: var(--space-xs);
    }
  }

  /* Reduced motion means no transition at all, and no lift left behind
     (DESIGN.md MOTION-2). */
  @media (prefers-reduced-motion: reduce) {
    .job-card {
      transition: none;
    }

    @media (hover: hover) {
      .job-card:hover {
        transform: none;
      }
    }
  }
</style>
