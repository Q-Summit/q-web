---
// Numbered glass application steps (DESIGN.md KICKOFF-1). Not ui/Timeline.
import "./kickoff-theme.css";
import type { KickoffContent } from "../../lib/content";

interface Props {
  content: KickoffContent["application"];
}

const { content } = Astro.props;
---

<section
  id="application-flow"
  class="kickoff-section application-section kickoff-reveal"
  aria-labelledby="application-title"
>
  <div class="application-header">
    <p class="kickoff-eyebrow" data-lp="application.eyebrow">
      {content.eyebrow}
    </p>
    <h2
      id="application-title"
      class="kickoff-section-title"
      data-lp="application.heading"
    >
      {content.heading}
    </h2>
    <p class="kickoff-section-copy" data-lp="application.intro">
      {content.intro}
    </p>
  </div>

  <div class="application-flow">
    {
      content.steps.map((step, index) => (
        <article
          class="application-step kickoff-reveal"
          style={`--kickoff-step-delay: ${index}`}
        >
          <div class="step-number">{String(index + 1).padStart(2, "0")}</div>
          <div>
            <p>{step.date}</p>
            <h3>{step.title}</h3>
            <span>{step.text}</span>
          </div>
        </article>
      ))
    }
  </div>
</section>

<style>
  /* DESIGN.md KICKOFF-1: numbered ice cards, not the conference timeline. */
  .application-section {
    text-align: center;
  }

  .application-flow {
    display: grid;
    gap: var(--space-sm);
    width: min(850px, 100%);
    margin: 2.5rem auto 0;
    text-align: left;
  }

  .application-step {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--space-sm);
    align-items: start;
    padding: var(--space-sm);
    border: 1px solid color-mix(in srgb, var(--color-navy) 12%, transparent);
    border-radius: var(--radius-kickoff-copy);
    background:
      radial-gradient(
        circle at 12% 12%,
        color-mix(in srgb, var(--color-kickoff-ice) 34%, transparent),
        transparent 12rem
      ),
      color-mix(in srgb, var(--color-white) 72%, transparent);
    box-shadow: 0 18px 44px
      color-mix(in srgb, var(--color-navy) 7%, transparent);
    transition-delay: calc(
      var(--kickoff-step-delay, 0) * var(--duration-hover)
    );
  }

  .step-number {
    display: grid;
    width: 3rem;
    height: 3rem;
    place-items: center;
    border-radius: var(--radius-kickoff-step-num);
    background: var(--color-navy);
    color: var(--color-white);
    font-weight: var(--heading-weight-home);
  }

  .application-step p {
    margin: 0 0 0.3rem;
    color: var(--color-kickoff-mid);
    font-size: clamp(0.82rem, 0.82rem, 0.82rem);
    font-weight: var(--heading-weight-home);
  }

  .application-step h3 {
    margin: 0;
    color: var(--color-navy);
    font-size: clamp(1.35rem, 1.35rem, 1.35rem);
  }

  .application-step span {
    display: block;
    margin-top: 0.45rem;
    color: color-mix(in srgb, var(--color-navy) 70%, transparent);
    line-height: 1.55;
  }

  @media (max-width: 640px) {
    .application-step {
      grid-template-columns: 1fr;
    }
  }
</style>
