---
// Check mark glyph for an included ticket benefit (DESIGN.md COMP-3). One
// copy of the 24-grid path the Webflow port pasted inline into both places
// the ticket-categories page prints an inclusion: the feature list on each
// plan card (tickets/TicketTierCards.astro) and the included cells of the
// comparison table (tickets/PricingComparisonTable.astro). Single path,
// fill=currentColor, so the caller's wrapper decides the color (navy on the
// cards, success green in the table); the wrapper is aria-hidden and the
// table pairs each cell with visually hidden "Included" text, so the glyph
// itself is decorative (aria-hidden here), like IconChevron.
//
// The svg is rendered by THIS component, so it carries this component's
// scope, not the caller's: a caller that needs to style it selects
// `:global(svg)` inside its own wrapper, the same way layout/Footer.astro
// and the four accordions do with IconChevron.
interface Props {
  /** Rendered box in px. 20 on the plan cards, 22 in the table. */
  size?: number;
}

const { size = 20 } = Astro.props;
---

<svg
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="currentColor"
  aria-hidden="true"
  focusable="false"
>
  <path
    d="M20.3479 7.56384L9.7479 18.1638C9.65402 18.2585 9.52622 18.3117 9.3929 18.3117C9.25958 18.3117 9.13178 18.2585 9.0379 18.1638L3.6479 12.7738C3.55324 12.68 3.5 12.5522 3.5 12.4188C3.5 12.2855 3.55324 12.1577 3.6479 12.0638L4.3479 11.3638C4.44178 11.2692 4.56958 11.2159 4.7029 11.2159C4.83622 11.2159 4.96402 11.2692 5.0579 11.3638L9.3879 15.6938L18.9379 6.14384C19.1357 5.95205 19.4501 5.95205 19.6479 6.14384L20.3479 6.85384C20.4426 6.94772 20.4958 7.07552 20.4958 7.20884C20.4958 7.34216 20.4426 7.46995 20.3479 7.56384Z"
  ></path>
</svg>
