# Local CMS only (Docker Postgres + MinIO). Copy to .env
# Runtime: Payload/Next reads this file. Never put Neon/R2/prod secrets here.

DATABASE_URI=postgresql://postgres:localdev@localhost:5433/qweb
PAYLOAD_SECRET=replace-with-a-long-random-string
CMS_SERVER_URL=http://localhost:3000
SITE_URL=http://localhost:4321

CONTENT_SYNC_TOKEN=local-dev-content-sync-token-change-me
# EXAMPLE ONLY: replace `dev` with your Workspace local-part (CMS rejects "dev").
# Bare username works (lukas.strickler → lukas.strickler@q-summit.com).
# Prod: that person must Google-login to the CMS once first. Local: seed creates them.
CONTENT_SYNC_USER_EMAIL=dev@q-summit.com

S3_BUCKET=qweb-media
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY_ID=qweb-local
S3_SECRET_ACCESS_KEY=qweb-local-secret
S3_REGION=auto
S3_FORCE_PATH_STYLE=true

# Optional: enable Google login locally (otherwise password seed users work).
# Redirect URI: http://localhost:3000/api/users/oauth/google/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_WORKSPACE_DOMAIN=q-summit.com
# GOOGLE_SA_CLIENT_EMAIL=
# GOOGLE_SA_PRIVATE_KEY=
# GOOGLE_GROUP_MAP={"it@q-summit.com":{"roles":["admin"]}}

# Schema push is intentionally NOT disabled here. Local dev relies on it to
# create the schema in the empty docker-compose Postgres, and nothing local
# runs migrations before seeding, so setting this to "false" makes a fresh
# clone fail on `make dev` with `relation "users" does not exist`. It is
# ops:cms-remote that sets PAYLOAD_DB_PUSH=false, to keep the admin UI from
# schema-pushing against the real database; Payload also skips push whenever
# NODE_ENV=production, so the deployed CMS is never pushed to either
# (src/payload.config.ts, docs/dev/go-live.md).
# PAYLOAD_DB_PUSH=false
