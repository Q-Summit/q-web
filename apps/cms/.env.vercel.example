# Paste into Vercel → CMS project → Environment Variables (Production + Preview).
# Copy to .env.vercel and fill real values (gitignored). This example is safe to commit.
#
# Build: pnpm --filter cms run migrate && pnpm --filter cms run build
#
# Vercel production boot (assertProductionHardening) requires: CMS_SERVER_URL,
# SITE_URL, CONTENT_SYNC_TOKEN, CLOUDFLARE_DEPLOY_HOOK_URL, all S3_* below
# (except region), and all GOOGLE_* below (except optional GROUP_PREFIX/MAP).

DATABASE_URI=postgresql://USER:PASS@HOST/neondb?sslmode=require
PAYLOAD_SECRET=

# After first deploy, set to your *.vercel.app host, then redeploy.
# Later: https://cms.q-summit.de
CMS_SERVER_URL=https://YOUR_CMS.vercel.app

# After Workers preview exists. Later: https://q-summit.com
SITE_URL=https://q-web.YOUR_SUBDOMAIN.workers.dev

S3_BUCKET=qweb-media
S3_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto
# Do NOT set S3_FORCE_PATH_STYLE here. It is `true` in apps/cms/.env for local
# MinIO, which needs path-style addressing; R2 uses virtual-hosted addressing
# and uploads fail if it is forced on. Unset (the default) is correct for R2.

CONTENT_SYNC_TOKEN=
# CONTENT_SYNC_USER_EMAIL is deliberately NOT set here. The HTTP endpoint
# always requires the X-Content-Sync-Actor header and rejects a request
# without it, so the server-side fallback is unreachable in production;
# setting it would only suggest there is a server-side identity. The actor is
# whoever runs `make propose`, from their own client .env.

# Workers Builds deploy hook URL (Settings > Builds > Deploy Hooks).
# Same URL as the GitHub CLOUDFLARE_DEPLOY_HOOK_URL secret.
# POST only; Cloudflare dedupes bursts. Unset skips the POST (local/dev).
CLOUDFLARE_DEPLOY_HOOK_URL=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_WORKSPACE_DOMAIN=q-summit.com
GOOGLE_SA_CLIENT_EMAIL=
GOOGLE_SA_PRIVATE_KEY=
# Optional. Defaults to "cms-", so roles come from cms-admins@, cms-approvers@,
# and cms-<division>@ groups. Only set this if your Workspace groups use a
# different prefix; the groups must already exist or every login is refused.
# GOOGLE_GROUP_PREFIX=cms-
# LEAVE THIS COMMENTED OUT unless you are deliberately NOT using the `cms-`
# group convention. Setting it REPLACES the convention entirely: `cms-admins`,
# `cms-approvers`, and every `cms-<division>` group stop mapping, so on go-live
# day every editor is refused with "user is in no mapped Workspace group" while
# everyone in the listed group becomes an unscoped admin. It passes boot
# validation, so the only symptom is that nobody can log in.
#
# Q-Summit production uses an explicit map (it@ admin, board@ approver,
# ct-2027@ editor+all divisions) instead of nine cms-* groups - see go-live.md.
# Example shape only; put the real JSON in Vercel / .env.vercel:
# GOOGLE_GROUP_MAP={"it@q-summit.com":{"roles":["admin"]},"board@q-summit.com":{"roles":["approver"]},"ct-2027@q-summit.com":{"roles":["editor"],"divisions":["chair","pr","partner","finance","operations","concept","it"]}}
