---
// "What to expect" facts on the violet ground, directly under the hero.
// Content is the CMS benefits block (title + one-line description each).
// Deliberately not cards: short facts in a quiet grid, each marked with a
// three-square pixel cluster in the campaign accents, so the hero stays the
// loudest thing on the page. The section id keeps the old `#join-hack`
// anchor alive for any CTA that still points at it.
import type { FeatureCard } from "../../lib/content";
import "./hack-light.css";

interface Props {
  id?: string;
  heading: string;
  cards: FeatureCard[];
}

const { id, heading, cards } = Astro.props;

// Accent per fact, cycling. Decorative only.
const accents = ["is-yellow", "is-coral", "is-sky"] as const;
---

<section
  id={id}
  class="facts"
  aria-labelledby="facts-heading"
  data-hack-ground-zone
>
  <div class="container">
    <h2 id="facts-heading" class="facts-heading">{heading}</h2>
    <ul class="facts-grid" data-reveal="rise">
      {
        cards.map((card, index) => (
          <li class="fact">
            <svg
              class:list={["fact-mark", accents[index % accents.length]]}
              viewBox="0 0 3 2"
              width="24"
              height="16"
              aria-hidden="true"
              shape-rendering="crispEdges"
            >
              <rect x="0" y="0" width="1" height="1" />
              <rect x="1" y="1" width="1" height="1" />
              <rect x="2" y="0" width="1" height="1" />
            </svg>
            <h3 class="fact-title">{card.title}</h3>
            <p class="fact-text">{card.description}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  /* On the campaign ground, not a .section band (DESIGN.md HACK-1 deviating
     from LAYOUT-3 and TYPE-1): the facts continue the hero, so they keep
     its violet and white type and a tighter rhythm. */
  /* Bottom padding leaves room for the seam into the white surface
     (--hack-seam, set on the page shell). The seam's faint violet start
     reaches further up, under the facts; the content sits above it (the
     seam belongs to the later surface and would otherwise paint over the
     white type). */
  .facts {
    position: relative;
    padding-block: var(--space-lg)
      calc(var(--hack-seam, 14rem) * 0.6 + var(--space-lg));
    color: var(--color-text-inverse);
  }

  .facts > .container {
    position: relative;
    z-index: 1;
  }

  .facts-heading {
    margin: 0 0 var(--space-lg);
    color: var(--color-text-inverse);
    font-size: var(--heading-h5-size);
  }

  .facts-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-xl) var(--space-lg);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .fact {
    display: grid;
    align-content: start;
    gap: var(--space-2xs);
    padding-top: var(--space-sm);
    border-top: 1px solid
      color-mix(in srgb, var(--color-white) 22%, transparent);
  }

  .fact-mark {
    margin-bottom: var(--space-2xs);
    fill: currentColor;
  }

  .fact-mark.is-yellow {
    color: var(--color-hack-yellow);
  }

  .fact-mark.is-coral {
    color: var(--color-hack-coral);
  }

  .fact-mark.is-sky {
    color: var(--color-hack-sky);
  }

  .fact-title {
    margin: 0;
    color: var(--color-text-inverse);
    font-size: var(--text-size-large);
    line-height: var(--heading-line-height-normal);
  }

  .fact-text {
    max-width: 30ch;
    margin: 0;
    color: color-mix(in srgb, var(--color-white) 80%, transparent);
  }

  @media (max-width: 991px) {
    .facts-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 479px) {
    .facts-grid {
      grid-template-columns: 1fr;
      gap: var(--space-md);
    }
  }
</style>
