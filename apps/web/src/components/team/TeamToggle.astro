---
// Segmented "Current Team | History" switch between /our-team and
// /past-teams. Real, always-present <a href> tabs (so the page works with
// JS off, or in a browser predating this markup) enhanced by
// TeamPanels.astro's script into an instant, no-navigation toggle: a
// sliding drop of icy glass behind the active label on a white glass track
// (DESIGN.md NAVY-1). role="tablist"/"tab" gives it
// tab-like semantics for assistive tech without removing either link from
// the normal tab order (both stay real, reachable links either way).
interface Props {
  active: "current" | "past";
  /** The two labels from the CMS (Our Team / Past Teams tabLabel). */
  currentLabel: string;
  pastLabel: string;
}

const { active, currentLabel, pastLabel } = Astro.props;

const tabs = [
  { key: "current", label: currentLabel, href: "/our-team/" },
  { key: "past", label: pastLabel, href: "/past-teams/" },
] as const;
---

<div class="team-toggle-wrap">
  <div class="team-toggle n-white h-ice" role="tablist" aria-label="Team pages">
    <span class="team-toggle__thumb n-drop" aria-hidden="true"></span>
    {
      tabs.map((tab) => (
        <a
          role="tab"
          id={`team-tab-${tab.key}`}
          aria-selected={tab.key === active ? "true" : "false"}
          aria-controls={`team-panel-${tab.key}`}
          class:list={[
            "team-toggle__link",
            { "is-active": tab.key === active },
          ]}
          href={tab.href}
          data-team-tab={tab.key}
        >
          {tab.label}
        </a>
      ))
    }
  </div>
</div>

<style>
  /* DESIGN.md NAVY-1: a track of white liquid glass (the job page's
     search and filter) with the Tickets button's icy glass as the drop
     under the chosen tab. TeamPanels' script measures the active tab and
     slides the drop there; until then (and without JS) the active tab
     carries the ice itself. */
  .team-toggle-wrap {
    display: flex;
    justify-content: center;
  }

  .team-toggle {
    display: inline-flex;
    padding: 0.4rem;
    border-radius: var(--radius-ticket-pill);
  }

  .team-toggle__thumb {
    top: 0.4rem;
    bottom: 0.4rem;
  }

  .team-toggle__link {
    position: relative;
    z-index: 1;
    padding: 0.8rem 1.7rem;
    border-radius: var(--radius-ticket-pill);
    font-size: clamp(var(--text-size-tiny), 0.5rem + 0.4vw, 0.8125rem);
    font-weight: var(--heading-weight);
    letter-spacing: 0.08em;
    text-align: center;
    text-decoration: none;
    text-transform: uppercase;
    white-space: nowrap;
    color: var(--n-ink-soft);
    -webkit-tap-highlight-color: transparent;
    user-select: none;
    transition: color var(--duration-open) var(--ease-snappy);
  }

  .team-toggle__link.is-active {
    color: var(--color-navy);
    text-shadow: 0 1px 0 color-mix(in srgb, var(--color-white) 60%, transparent);
  }

  .team-toggle:not(:has(.n-drop.is-placed)) .team-toggle__link.is-active {
    background: var(--hg-fill);
    box-shadow: var(--hg-shadow);
  }

  .team-toggle__link:focus:not(:focus-visible) {
    outline: none;
  }

  .team-toggle__link:focus-visible {
    outline: 2px solid var(--color-ticket-sky);
    outline-offset: 3px;
  }

  @media (hover: hover) {
    .team-toggle__link:hover {
      color: var(--color-navy);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .team-toggle__link {
      transition: none;
    }
  }

  @media (max-width: 479px) {
    .team-toggle__link {
      padding: 0.7rem 1.2rem;
    }
  }
</style>
