{
  "name": "q-web",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "Q-Summit website: Astro static site + Payload CMS.",
  "engines": {
    "node": ">=22.19",
    "pnpm": ">=10"
  },
  "scripts": {
    "setup": "pnpm install && node scripts/local/setup.mjs",
    "setup:chrome": "node scripts/local/ensure-chrome.mjs",
    "db:up": "docker compose up -d --wait postgres minio && docker compose up minio-init",
    "db:down": "docker compose down",
    "reset:local": "node scripts/local/reset.mjs",
    "dev": "node scripts/local/dev.mjs",
    "dev:web": "CONTENT_SOURCE=json pnpm --filter web run dev",
    "dev:web:remote": "node scripts/local/web-remote.mjs",
    "ops:cms-remote": "node scripts/ops/cms-remote.mjs",
    "seed": "node scripts/local/assert-db.mjs && pnpm --filter cms exec payload run seed/preflight.ts && pnpm --filter cms exec payload run seed/users.ts && pnpm --filter cms exec payload run seed/media.ts && pnpm --filter cms exec payload run seed/site-settings.ts && pnpm --filter cms exec payload run seed/page-content.ts && pnpm --filter cms exec payload run seed/legal.ts && pnpm --filter cms exec payload run seed/partners.ts && pnpm --filter cms exec payload run seed/testimonials.ts && pnpm --filter cms exec payload run seed/jobs.ts && pnpm --filter cms exec payload run seed/speakers.ts && pnpm --filter cms exec payload run seed/team.ts && pnpm --filter cms exec payload run seed/past-teams.ts && pnpm --filter cms exec payload run seed/faqs.ts",
    "content:export": "node scripts/content/export.mjs",
    "content:import": "node scripts/content/import.mjs",
    "content:fixture": "node scripts/content/make-fixture.mjs",
    "content:pull": "node scripts/content/pull.mjs",
    "content:propose": "node scripts/content/propose.mjs",
    "ops:mirror-db": "node scripts/ops/mirror-db.mjs",
    "ops:mirror-media": "node scripts/ops/mirror-media.mjs",
    "r2:sync": "node scripts/preview/r2-sync.mjs",
    "seed:local-r2": "node scripts/preview/seed-local-r2.mjs",
    "picture:sync": "node scripts/preview/sync-picture-assets.mjs",
    "preview:cf": "node scripts/preview/cf.mjs",
    "lighthouse": "node scripts/check/lighthouse.mjs",
    "check": "pnpm run check:fast && node scripts/check/run-parallel.mjs check:lint check:web check:cms",
    "check:lint": "eslint . --max-warnings 0 --cache --cache-location node_modules/.cache/eslint/",
    "check:fast": "node scripts/check/fast.mjs",
    "check:docs": "node scripts/check/docs.mjs",
    "check:design": "node scripts/check/design.mjs",
    "check:cms-styles": "node scripts/check/cms-styles.mjs",
    "check:scripts": "node --test scripts/check/scripts.test.mjs scripts/check/vrt-report.test.mjs",
    "check:web": "pnpm --filter web run check && node scripts/check/run-parallel.mjs check:web:build check:web:test",
    "check:web:build": "node scripts/check/build-web.mjs && node scripts/check/budgets.mjs",
    "check:web:test": "pnpm --filter web run test",
    "check:cms": "pnpm run check:cms:types && node scripts/check/run-parallel.mjs check:cms:test check:cms:build",
    "check:cms:types": "pnpm --filter cms run check",
    "check:cms:test": "pnpm --filter cms run test",
    "check:cms:build": "DATABASE_URI=postgresql://ci:ci@127.0.0.1:1/ci PAYLOAD_SECRET=ci-only-not-a-secret pnpm --filter cms run build",
    "check:md": "markdownlint-cli2",
    "check:spell": "cspell --no-progress --cache --cache-location node_modules/.cache/cspell/.cspellcache .",
    "test": "pnpm --filter web run test && pnpm --filter cms run test",
    "format": "prettier --write \"**/*.{md,json,jsonc,yml,yaml,mjs,ts,tsx,astro,css}\"",
    "format:check": "prettier --check \"**/*.{md,json,jsonc,yml,yaml,mjs,ts,tsx,astro,css}\""
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@google/design.md": "0.3.0",
    "@puppeteer/browsers": "^3.0.6",
    "@vitest/eslint-plugin": "^1.6.23",
    "chrome-launcher": "^1.2.1",
    "cspell": "^10.0.1",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.7.0",
    "lighthouse": "^13.4.1",
    "markdownlint-cli2": "^0.23.1",
    "prettier": "^3.9.5",
    "prettier-plugin-astro": "^0.14.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0"
  },
  "packageManager": "pnpm@10.32.0+sha512.9b2634bb3fed5601c33633f2d92593f506270a3963b8c51d2b2d6a828da615ce4e9deebef9614ccebbc13ac8d3c0f9c9ccceb583c69c8578436fa477dbb20d70"
}
