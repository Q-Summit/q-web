---
// Partner rows on the home page (DESIGN.md HOME-1): one logo strip per
// group (Startups, Corporates, Network), running from one edge of the
// window to the other, straight and on no surface of its own. Only the
// row's name sits on glass: a milky pane at the left, opaque behind the
// words and clearing only to their right, so the logos pass under it and
// dissolve into it. Every logo
// sits on a small slab of glass with a visible lower edge.
//
// Built to stay smooth:
//   - a strip is two identical groups moving by translate3d(-50%), on its
//     own compositor layer (will-change), so a frame only moves a texture
//     and never repaints or lays out;
//   - nothing filters or masks the moving strips: the milky pane is a
//     plain gradient fill, not a backdrop blur, so it costs nothing per
//     frame;
//   - logos load eagerly, and home.client.ts swaps every logo for a copy
//     scaled to its drawn size once the page is idle: the partner files
//     are several hundred pixels wide, and decoding one each time it
//     slid into view is what made the strips stutter;
//   - a group repeats its logos only until it covers a wide window;
//   - motion stops on hover and keyboard focus, with the Pause button and
//     while the section is off screen (home.client.ts).
// The repeats are decorative (aria-hidden, no link), so keyboard and
// screen reader users meet every partner once. Reduced motion shows the
// strips as plain rows that scroll sideways by hand.
//
// Logos keep their proportions and get the same optical size: every logo
// is scaled to the same area inside a fixed slab, so a wide wordmark and a
// square mark carry the same weight.
import "./home-theme.css";
import IconArrowRight from "../icons/IconArrowRight.astro";

export interface PartnerLogo {
  name: string;
  href: string;
  src: string;
  width: number;
  height: number;
}

export interface PartnerLogoGroup {
  label: string;
  description?: string;
  logos: PartnerLogo[];
}

interface Props {
  eyebrow?: string;
  heading?: string;
  groups: PartnerLogoGroup[];
  cta?: { label: string; href: string };
}

const { eyebrow, heading, groups, cta } = Astro.props;

// Mirrors the CSS below (rem = 16px): slab 10rem wide, 0.75rem gap.
const SLAB_PX = 160;
const GAP_PX = 12;
// One group must cover a wide window (the strips run edge to edge).
const GROUP_MIN_PX = 2600;
// Every strip moves this many pixels per second.
const SPEED_PX_S = 30;

// Same optical size for every logo: equal area, capped to the slab.
const LOGO_AREA = 2600;
const LOGO_MAX_W = 118;
const LOGO_MAX_H = 46;

function logoBox(logo: PartnerLogo): { width: number; height: number } {
  const ratio = logo.width / logo.height;
  let width = Math.sqrt(LOGO_AREA * ratio);
  let height = Math.sqrt(LOGO_AREA / ratio);
  const fit = Math.min(1, LOGO_MAX_W / width, LOGO_MAX_H / height);
  width *= fit;
  height *= fit;
  return { width: Math.round(width), height: Math.round(height) };
}

const rows = groups.map((group, index) => {
  const setWidth = group.logos.length * (SLAB_PX + GAP_PX);
  const repeats =
    setWidth > 0 ? Math.max(1, Math.ceil(GROUP_MIN_PX / setWidth)) : 1;
  return {
    ...group,
    repeats,
    reverse: index % 2 === 1,
    seconds: Math.round((setWidth * repeats) / SPEED_PX_S),
    logos: group.logos.map((logo) => ({ ...logo, box: logoBox(logo) })),
  };
});
---

{
  rows.length > 0 && (
    <section
      class="h-section h-partners"
      aria-labelledby={heading ? "home-partners-title" : undefined}
      aria-label={heading ? undefined : "Partners"}
      data-marquee
    >
      <div class="h-shell">
        <div class="h-head">
          <div>
            {eyebrow && (
              <p class="h-eyebrow" data-lp="partnerBand.eyebrow">
                {eyebrow}
              </p>
            )}
            {heading && (
              <h2
                id="home-partners-title"
                class="h-title"
                data-lp="partnerBand.heading"
                data-h-reveal
              >
                {heading}
              </h2>
            )}
          </div>
          {cta && (
            <a
              class="h-more"
              href={cta.href}
              data-lp="partnerBand.cta"
              data-lp-href="partnerBand.cta.href"
            >
              <span data-lp-label>{cta.label}</span>
              <IconArrowRight />
            </a>
          )}
        </div>
      </div>

      <div class="h-partner-band">
        {rows.map((row) => (
          <div class="h-partner-row">
            <div class="h-partner-label">
              <h3>{row.label}</h3>
              {row.description && <p>{row.description}</p>}
            </div>
            <div class="h-partner-viewport">
              <div
                class:list={["h-partner-track", { "is-reverse": row.reverse }]}
                style={`--marquee-seconds: ${row.seconds}s`}
              >
                {[0, 1].map((half) => (
                  <div class="h-partner-group" aria-hidden={half === 1}>
                    {Array.from({ length: row.repeats }).map((_, repeat) => {
                      const real = half === 0 && repeat === 0;
                      return (
                        <ul
                          class="h-partner-logos"
                          aria-label={
                            real ? `${row.label} partners` : undefined
                          }
                          aria-hidden={!real && half === 0 ? "true" : undefined}
                        >
                          {row.logos.map((logo) => {
                            const image = (
                              <img
                                src={logo.src}
                                alt=""
                                width={logo.box.width}
                                height={logo.box.height}
                                style={`--w: ${logo.box.width}; --h: ${logo.box.height}`}
                                decoding="async"
                              />
                            );
                            return (
                              <li>
                                {real ? (
                                  <a
                                    class="h-partner-slab"
                                    href={logo.href}
                                    target="_blank"
                                    rel="noopener noreferrer"
                                    aria-label={`${logo.name} (opens in a new tab)`}
                                  >
                                    {image}
                                  </a>
                                ) : (
                                  <span class="h-partner-slab">{image}</span>
                                )}
                              </li>
                            );
                          })}
                        </ul>
                      );
                    })}
                  </div>
                ))}
              </div>
            </div>
          </div>
        ))}
      </div>

      <div class="h-shell">
        <button
          type="button"
          class="h-marquee-toggle"
          aria-pressed="false"
          data-marquee-toggle
          data-glass-press
        >
          <span class="glass-light" aria-hidden="true" />
          <span class="h-marquee-icon" aria-hidden="true" />
          <span
            data-marquee-label
            data-pause="Pause logos"
            data-play="Play logos"
          >
            Pause logos
          </span>
        </button>
      </div>
    </section>
  )
}

<style>
  /* DESIGN.md HOME-1 */
  /* Edge to edge: the band is not inside the page width. */
  .h-partner-band {
    --band-gutter: max(
      clamp(1rem, 5vw, 2.5rem),
      (100% - var(--container-large)) / 2
    );

    display: grid;
    /* One column no wider than the window, however long a strip is. */
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-2xs);
  }

  .h-partner-row {
    position: relative;
    min-width: 0;
  }

  /*
   * The row's name on milky glass: opaque from the window's left edge to
   * just past the name, then clearing toward the right until it is gone, so
   * the logos seem to slide under frosted glass. A plain gradient (no
   * backdrop blur): it lies over a moving layer and must cost nothing per
   * frame. The name starts at the page's left edge (--band-gutter).
   */
  .h-partner-label {
    position: absolute;
    inset: 0 auto 0 0;
    z-index: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    width: calc(var(--band-gutter) + 20rem);
    padding-left: var(--band-gutter);
    /* Opaque behind the name, so no logo ever shows through the words;
       it starts to clear only to the right of them. Its lit upper edge
       and cool lower edge are two more gradients that fade with it, so
       the pane needs no mask (a mask over a moving layer costs a blend
       every frame). */
    background:
      linear-gradient(
          90deg,
          var(--color-white) calc(var(--band-gutter) + 10.5rem),
          transparent
        )
        top / 100% 1px no-repeat,
      linear-gradient(
          90deg,
          color-mix(in srgb, var(--color-ticket-cyan) 60%, transparent)
            calc(var(--band-gutter) + 10.5rem),
          transparent
        )
        bottom / 100% 1px no-repeat,
      linear-gradient(
        90deg,
        var(--color-ticket-ground) 0%,
        var(--color-white) calc(var(--band-gutter) + 10.5rem),
        color-mix(in srgb, var(--color-white) 55%, transparent)
          calc(var(--band-gutter) + 14.5rem),
        transparent 100%
      );
    pointer-events: none;
  }

  /* The right end: the strip dissolves into the ground instead of being
     cut by the window edge. A plain gradient again, no mask. */
  .h-partner-row::after {
    content: "";
    position: absolute;
    inset: 0 0 0 auto;
    z-index: 1;
    width: clamp(3rem, 9vw, 9rem);
    background: linear-gradient(
      270deg,
      var(--color-ticket-ground) 0%,
      color-mix(in srgb, var(--color-ticket-ground) 70%, transparent) 35%,
      transparent 100%
    );
    pointer-events: none;
  }

  .h-partner-label h3 {
    margin: 0;
    color: var(--color-navy);
    font-size: var(--heading-h5-size);
    font-weight: var(--font-weight-extrabold);
    letter-spacing: -0.02em;
    line-height: 1.15;
  }

  .h-partner-label p {
    margin: var(--space-2xs) 0 0;
    color: color-mix(in srgb, var(--color-navy) 76%, transparent);
    font-size: var(--text-size-small);
    line-height: 1.3;
  }

  /* Clips the strip; no mask, so a frame never has to re-blend it. */
  .h-partner-viewport {
    overflow: hidden;
    contain: layout paint;
  }

  .h-partner-track {
    display: flex;
    width: max-content;
    padding-block: var(--space-2xs) var(--space-xs);
    /* Its own layer: the loop only moves this texture. */
    will-change: transform;
    backface-visibility: hidden;
  }

  .h-partner-group,
  .h-partner-logos {
    display: flex;
    flex: 0 0 auto;
  }

  .h-partner-logos {
    gap: var(--space-xs);
    margin: 0;
    padding: 0 var(--space-xs) 0 0;
    list-style: none;
  }

  /* A slab of glass under each logo: a calm, light face, a lit upper
     edge, a visible lower edge (its thickness) and a soft shadow on the
     plane. No blur of its own: it moves. */
  .h-partner-slab {
    display: grid;
    place-items: center;
    width: 10rem;
    height: 4.25rem;
    border-radius: var(--radius-ticket-panel);
    background: linear-gradient(
      180deg,
      color-mix(in srgb, var(--color-white) 86%, transparent),
      color-mix(in srgb, var(--color-white) 64%, transparent)
    );
    box-shadow:
      inset 0 1px 0 var(--color-white),
      inset 0 -3px 0
        color-mix(in srgb, var(--color-ticket-ice) 85%, transparent),
      0 3px 0 color-mix(in srgb, var(--color-ticket-sky) 26%, transparent),
      0 12px 14px -10px color-mix(in srgb, var(--color-navy) 50%, transparent);
  }

  /* The build-time box (equal area for every logo), scaled with the slab. */
  .h-partner-slab img {
    display: block;
    width: calc(var(--w) * var(--logo-scale, 1) * 1px);
    height: calc(var(--h) * var(--logo-scale, 1) * 1px);
    object-fit: contain;
  }

  /* Pause control: a small pill of glass. */
  .h-marquee-toggle {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: var(--space-2xs);
    min-height: 2.75rem;
    margin-top: var(--space-sm);
    padding: 0 var(--space-sm);
    border: 0;
    border-radius: var(--radius-ticket-pill);
    background: color-mix(in srgb, var(--color-white) 30%, transparent);
    box-shadow:
      inset 0 1px 0 color-mix(in srgb, var(--color-white) 90%, transparent),
      inset 0 0 0 1px color-mix(in srgb, var(--color-white) 55%, transparent);
    color: var(--color-navy);
    font: inherit;
    font-size: var(--text-size-tiny);
    font-weight: var(--font-weight-semibold);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
    transition: transform var(--duration-glass-release) var(--ease-glass-spring);
  }

  .h-marquee-toggle:active,
  .h-marquee-toggle.is-pressed {
    transform: scale(0.96);
    transition-duration: var(--duration-glass-press);
  }

  /* Two bars (pause) that become a triangle (play). */
  .h-marquee-icon {
    width: 0.625rem;
    height: 0.75rem;
    border-inline: 0.2rem solid currentcolor;
  }

  .h-marquee-toggle[aria-pressed="true"] .h-marquee-icon {
    width: 0;
    border-block: 0.375rem solid transparent;
    border-left: 0.625rem solid currentcolor;
    border-right: 0;
  }

  @media (prefers-reduced-motion: no-preference) {
    .h-partner-track {
      animation: h-marquee var(--marquee-seconds) linear infinite;
    }

    .h-partner-track.is-reverse {
      animation-direction: reverse;
    }

    /* Hover, keyboard focus, the Pause button, or off screen. */
    .h-partner-viewport:hover .h-partner-track,
    .h-partner-viewport:focus-within .h-partner-track,
    .h-partners[data-paused] .h-partner-track,
    .h-partners[data-offscreen] .h-partner-track {
      animation-play-state: paused;
    }
  }

  @keyframes h-marquee {
    to {
      transform: translate3d(-50%, 0, 0);
    }
  }

  /* Reduced motion: no loop, one set, scrolled by hand, on a flat plane;
     no control needed. */
  @media (prefers-reduced-motion: reduce) {
    .h-partner-viewport {
      overflow-x: auto;
      overscroll-behavior-x: contain;
    }

    .h-partner-track {
      will-change: auto;
    }

    .h-partner-group[aria-hidden="true"],
    .h-partner-logos[aria-hidden="true"],
    .h-marquee-toggle {
      display: none;
    }

    .h-marquee-toggle {
      transition: none;
    }
  }

  /* Phones: the name stands above its strip, on the same milky glass,
     now a short bar that clears toward the right. */
  @media (max-width: 767px) {
    .h-partner-band {
      gap: var(--space-xs);
    }

    .h-partner-label {
      position: relative;
      inset: auto;
      flex-direction: row;
      align-items: baseline;
      justify-content: flex-start;
      gap: var(--space-xs);
      width: auto;
      padding-block: var(--space-2xs);
    }

    .h-partner-label p {
      margin: 0;
    }

    .h-partner-slab {
      --logo-scale: 0.82;

      width: 8.25rem;
      height: 3.75rem;
    }
  }
</style>
