---
// /job-listings: the job board on the 2027 navy (DESIGN.md NAVY-1). Header
// copy and meta description come from the page-jobs global; all listings
// load at build time via src/lib/content.ts.
import Base from "../../layouts/Base.astro";
import JobBoard from "../../components/jobs/JobBoard.astro";
import { getJobs, getPageContent } from "../../lib/content";
import "../../components/ui/navy-glass.css";

const [{ jobs: page }, jobs] = await Promise.all([getPageContent(), getJobs()]);
---

<Base
  title={page.title}
  description={page.metaDescription}
  livePreviewGlobal="page-jobs"
>
  <div class="n-page">
    <div class="n-ground" aria-hidden="true"></div>
    <JobBoard jobs={jobs} heading={page.heading} intro={page.intro} />
    <div class="h-page-fade" aria-hidden="true"></div>
  </div>
</Base>
