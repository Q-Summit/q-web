---
// Site navigation, shared by every page (DESIGN.md COMP-6). Link targets
// keep the live site's URL paths so existing inbound links keep working at
// cutover: 7 items, home reachable via the logo only.
//
// The header is the floating liquid glass bar first built for the 2027
// ticket page (DESIGN.md TICKETS-1), now the one header of the site. It is
// position:fixed with a spacer (not sticky): sticky reflows against mobile
// browser chrome and vibrates the hamburger on scroll.
// Below 768px: disclosure hamburger (WAI APG) via nav-menu.client.ts.
// Without JS the mobile list stays visible and stacked.
// nav-tone.client.ts sets data-tone="dark" while the bar floats over a
// dark ground (the home video, .section.is-dark) so its glass turns more
// opaque and the navy text keeps its contrast.
import { logoHeight, logoSrc, logoWidth } from "../../assets/media/brand";
import { getSiteSettings } from "../../lib/content";
import { normalizeInternalHref } from "../../lib/href";
import IconClose from "../icons/IconClose.astro";
import IconMenu from "../icons/IconMenu.astro";

const { nav } = await getSiteSettings();

// Nav lockup: the intrinsic size is only the aspect ratio for layout; the
// rendered height comes from --site-header-logo-height below.
const logoDisplayHeight = 48;
const logoDisplayWidth = Math.round(
  (logoWidth / logoHeight) * logoDisplayHeight,
);

// link.href comes from getSiteSettings() already run through
// normalizeInternalHref (astro.config.mjs pins trailingSlash: "always"), so
// this side has to go through the same normalization or the comparison below
// never matches (e.g. "/whyq" !== "/whyq/").
const currentPath = normalizeInternalHref(Astro.url.pathname);

// Exact match plus section prefix so sub-routes keep their parent highlighted
// (job detail pages under /job-listings/). Hrefs are trailing-slashed, so the
// prefix test cannot cross-match sibling paths ("/job" vs "/jobs").
const isCurrent = (href: string): boolean =>
  currentPath === href ||
  (href !== "/" && href.startsWith("/") && currentPath.startsWith(href));
---

<header class="site-header" id="site-header">
  <div class="container nav-inner">
    <span class="nav-bar-glass" aria-hidden="true"></span>
    <a class="brand" href="/">
      <span
        class="brand-gloss"
        aria-hidden="true"
        style={`--brand-mask: url(${logoSrc})`}></span>
      <img
        src={logoSrc}
        alt="Q-Summit home"
        width={logoDisplayWidth}
        height={logoDisplayHeight}
        loading="eager"
        decoding="async"
      />
    </a>
    <button
      type="button"
      class="nav-toggle"
      aria-expanded="false"
      aria-controls="site-nav"
      aria-label="Open menu"
      data-glass-press
    >
      <span class="glass-light" aria-hidden="true"></span>
      <span class="nav-toggle__icon nav-toggle__icon--menu">
        <IconMenu />
      </span>
      <span class="nav-toggle__icon nav-toggle__icon--close">
        <IconClose />
      </span>
    </button>
    <nav id="site-nav" aria-label="Main">
      <span class="nav-glass" aria-hidden="true">
        <span class="nav-sheen"></span>
      </span>
      <ul>
        {
          nav.map((link, i) => (
            <li style={`--i: ${i}`}>
              <a
                href={link.href}
                aria-current={isCurrent(link.href) ? "page" : undefined}
                data-astro-prefetch="hover"
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>
{/* Holds document flow under the fixed bar so content is not covered. */}
<div class="site-header-spacer" aria-hidden="true"></div>

{
  /* Runs before paint so mobile does not flash the full stacked list while
     the deferred module script loads. No-JS: this never runs -> list stays
     visible (progressive enhancement). */
}
<script is:inline>
  (() => {
    const header = document.getElementById("site-header");
    if (!header || !window.matchMedia("(max-width: 767px)").matches) return;
    header.setAttribute("data-js", "true");
    const nav = document.getElementById("site-nav");
    if (nav) nav.hidden = true;
  })();
</script>

<script>
  import { initNavMenu } from "./nav-menu.client";
  import { initNavTone } from "./nav-tone.client";

  document
    .querySelectorAll<HTMLElement>(".site-header:not([data-nav-ready])")
    .forEach((header) => {
      header.setAttribute("data-nav-ready", "true");
      initNavMenu(header);
      initNavTone(header);
    });
</script>

<style is:global>
  /*
    Header geometry, on :root so a page section that runs under the
    floating bar (the home hero video) can pull itself up by exactly the
    header's height. Bar plus the inset gap above it.
  */
  :root {
    --site-header-inset: var(--space-xs);
    --site-header-bar: 3.75rem;
    --site-header-logo-height: 2.25rem;
    --site-header-height: calc(
      var(--site-header-bar) + var(--site-header-inset)
    );
  }

  @media (max-width: 767px) {
    :root {
      --site-header-inset: var(--space-2xs);
      --site-header-bar: 3.5rem;
      --site-header-logo-height: 2rem;
    }
  }

  /* Reserve scrollbar space so locking overflow does not shift the fixed
     header sideways when the menu opens. */
  html {
    scrollbar-gutter: stable;
  }

  /* Scroll lock while the mobile disclosure is open. */
  html.is-nav-open,
  html.is-nav-open body {
    overflow: hidden;
  }

  /* In-page anchors land below the floating bar, not under it. */
  html {
    scroll-padding-top: calc(var(--site-header-height) + var(--space-xs));
  }
</style>

<style>
  /*
    DESIGN.md COMP-6: the floating liquid glass bar from TICKETS-1, on every
    page. It may use the ticket-* tokens (radius, Q27 blues) it was built
    with. A floating bar inset from the viewport edges: liquid glass with
    no tint of its own, mostly clear, a strong blur that lifts brightness
    and color from what lies behind, and a still specular rim (no light
    ever sweeps across the menu). Links are small chips with a faint fill;
    the current page is a raised white chip.
  */
  .site-header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    height: var(--site-header-height);
    padding: var(--site-header-inset) var(--site-header-inset) 0;
    /* The gutter around the bar is see-through; clicks pass to the page. */
    pointer-events: none;
  }

  .site-header-spacer {
    flex-shrink: 0;
    height: var(--site-header-height);
  }

  .nav-inner {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-md);
    height: var(--site-header-bar);
    padding-block: 0;
    padding-inline: var(--space-md) var(--space-2xs);
    border-radius: var(--radius-ticket-panel);
    /* Lift and halo; the glass itself is .nav-bar-glass below. */
    box-shadow:
      0 10px 30px -18px color-mix(in srgb, var(--color-black) 22%, transparent),
      0 0 24px -10px
        color-mix(in srgb, var(--color-ticket-cyan) 45%, transparent);
    pointer-events: auto;
    isolation: isolate;
  }

  /*
    The bar's glass, in the home Buy Now's material: a thin white fill, so
    what lies behind stays visible as color, shape and movement, and a
    strong blur that lifts brightness and saturation, so nothing behind
    reads as a second line of text and the navy links keep their contrast.
    Depth from light only: a lit top edge, a caustic cyan glow inside the
    lower edge, thin side lights, the specular rim (.nav-inner::after) and
    the halo on .nav-inner.

    It is a layer of its own, not .nav-inner's background, on purpose: an
    element with backdrop-filter is a backdrop root, and the phone menu's
    glass (a child of .nav-inner) could then only blur the bar's own
    content instead of the page behind it.
  */
  .nav-bar-glass {
    position: absolute;
    inset: 0;
    z-index: -2;
    border-radius: inherit;
    background: linear-gradient(
      180deg,
      color-mix(in srgb, var(--color-white) 36%, transparent),
      color-mix(in srgb, var(--color-white) 18%, transparent)
    );
    box-shadow:
      inset 0 1px 1px color-mix(in srgb, var(--color-white) 95%, transparent),
      inset 0 -12px 18px -16px
        color-mix(in srgb, var(--color-ticket-cyan) 75%, transparent),
      inset 1px 0 0 color-mix(in srgb, var(--color-white) 40%, transparent),
      inset -1px 0 0 color-mix(in srgb, var(--color-white) 40%, transparent);
    pointer-events: none;
    -webkit-backdrop-filter: blur(18px) saturate(180%) brightness(1.1);
    backdrop-filter: blur(18px) saturate(180%) brightness(1.1);
  }

  /*
    Over a dark ground (the home video, navy sections) the same glass turns
    frosted: a light layer under the links fades in (opacity only, MOTION-3)
    so the navy logo and links keep their contrast. Before the tone script
    runs, a page that opens on a dark section gets the frosted state from
    CSS, so the first paint is already right.
  */
  .nav-inner::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    border-radius: inherit;
    background-color: color-mix(in srgb, var(--color-white) 32%, transparent);
    opacity: 0;
    pointer-events: none;
    transition: opacity var(--duration-ticket-color) var(--ease-snappy);
  }

  .site-header[data-tone="dark"] .nav-inner::before,
  :global(
    html:has(#main-content > .section.is-dark:first-child)
      .site-header:not([data-tone])
      .nav-inner::before
  ) {
    opacity: 1;
  }

  /* The specular rim: bright where light meets the edge, never moving. */
  .nav-inner::after {
    content: "";
    position: absolute;
    inset: 0;
    padding: 1px;
    border-radius: inherit;
    background: linear-gradient(
      150deg,
      color-mix(in srgb, var(--color-white) 95%, transparent) 0%,
      color-mix(in srgb, var(--color-white) 25%, transparent) 25%,
      transparent 45%,
      transparent 60%,
      color-mix(in srgb, var(--color-white) 45%, transparent) 85%,
      color-mix(in srgb, var(--color-white) 90%, transparent) 100%
    );
    pointer-events: none;
    -webkit-mask:
      linear-gradient(var(--color-black) 0 0) content-box,
      linear-gradient(var(--color-black) 0 0);
    -webkit-mask-composite: xor;
    mask:
      linear-gradient(var(--color-black) 0 0) content-box exclude,
      linear-gradient(var(--color-black) 0 0);
  }

  /* Without backdrop blur, near-opaque so text never sits on raw light. */
  @supports not (
    (backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))
  ) {
    .nav-bar-glass {
      background: color-mix(in srgb, var(--color-white) 95%, transparent);
    }
  }

  /*
    Logo material: the original lockup, unchanged in drawing. A soft
    shadow lifts it off the glass and a gloss masked by the logo itself
    catches light on the upper half. At header size both stay faint so the
    Q and the wordmark keep their crisp edges.
  */
  .brand {
    position: relative;
    flex: 0 0 auto;
    display: block;
    line-height: 0;
    text-decoration: none;
  }

  .brand img {
    display: block;
    height: var(--site-header-logo-height);
    width: auto;
    filter: drop-shadow(
      0 1px 2px
        color-mix(in srgb, var(--color-ticket-midnight) 22%, transparent)
    );
  }

  .brand-gloss {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background: linear-gradient(
      172deg,
      color-mix(in srgb, var(--color-white) 50%, transparent) 0%,
      color-mix(in srgb, var(--color-white) 10%, transparent) 42%,
      transparent 48%
    );
    -webkit-mask: var(--brand-mask) center / contain no-repeat;
    mask: var(--brand-mask) center / contain no-repeat;
  }

  .nav-toggle {
    /* Hidden until JS enhances on small viewports (see [data-js] below). */
    display: none;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: 2.75rem;
    height: 2.75rem;
    margin: 0;
    padding: 0;
    border: none;
    border-radius: var(--radius-ticket-button);
    background-color: color-mix(in srgb, var(--color-black) 4%, transparent);
    color: var(--color-neutral-darkest);
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
    touch-action: manipulation;
    position: relative;
    transition:
      background-color var(--duration-hover) var(--ease-snappy),
      transform var(--duration-glass-release) var(--ease-glass-spring);
  }

  .nav-toggle:active,
  .nav-toggle.is-pressed {
    background-color: color-mix(in srgb, var(--color-black) 9%, transparent);
    transform: scale(0.92);
    transition-duration: var(--duration-hover), var(--duration-glass-press);
  }

  .nav-toggle__icon {
    position: absolute;
    top: 50%;
    left: 50%;
    display: flex;
    width: 1.5rem;
    height: 1.5rem;
    margin: -0.75rem 0 0 -0.75rem;
    /* Closing: turns back together with the folding glass (same delay). */
    transition:
      opacity var(--duration-glass-fold) var(--ease-emphasized)
        calc(var(--duration-glass-fold) * 0.35),
      transform var(--duration-glass-fold) var(--ease-emphasized)
        calc(var(--duration-glass-fold) * 0.35);
  }

  .nav-toggle__icon :global(svg) {
    width: 100%;
    height: 100%;
  }

  .nav-toggle__icon--close {
    opacity: 0;
    transform: rotate(-90deg) scale(0.6);
  }

  .site-header[data-open] .nav-toggle__icon {
    transition:
      opacity calc(var(--duration-glass-unfold) * 0.6) var(--ease-emphasized),
      transform calc(var(--duration-glass-unfold) * 0.6) var(--ease-emphasized);
  }

  .site-header[data-open] .nav-toggle__icon--menu {
    opacity: 0;
    transform: rotate(90deg) scale(0.6);
  }

  .site-header[data-open] .nav-toggle__icon--close {
    opacity: 1;
    transform: none;
  }

  nav ul {
    display: flex;
    flex-wrap: wrap;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  nav a {
    border-radius: var(--radius-ticket-button);
    color: var(--color-neutral-darkest);
    font-size: var(--text-size-tiny);
    font-weight: var(--font-weight-semibold);
    letter-spacing: 0.08em;
    text-decoration: none;
    text-transform: uppercase;
    transition: background-color var(--duration-hover) var(--ease-snappy);
  }

  nav a[aria-current="page"] {
    background-color: color-mix(in srgb, var(--color-white) 85%, transparent);
    box-shadow:
      inset 0 1px 0 var(--color-white),
      0 0 0 1px color-mix(in srgb, var(--color-black) 6%, transparent);
  }

  /* On the frosted (dark-ground) bar the white chip needs a firmer edge
     to stand apart from the denser fill. */
  .site-header[data-tone="dark"] nav a[aria-current="page"] {
    background-color: var(--color-white);
    box-shadow:
      inset 0 1px 0 var(--color-white),
      0 0 0 1px color-mix(in srgb, var(--color-navy) 14%, transparent),
      0 2px 6px -2px color-mix(in srgb, var(--color-navy) 25%, transparent);
  }

  @media (hover: hover) {
    nav a:hover {
      background-color: color-mix(in srgb, var(--color-black) 5%, transparent);
    }

    .nav-toggle:hover {
      background-color: color-mix(in srgb, var(--color-black) 7%, transparent);
    }
  }

  nav a:active {
    background-color: color-mix(in srgb, var(--color-black) 9%, transparent);
  }

  @media (min-width: 768px) {
    nav ul {
      gap: var(--space-2xs) 0.25rem;
    }

    nav a {
      display: inline-flex;
      align-items: center;
      min-height: 2.25rem;
      padding-inline: var(--space-xs);
    }
  }

  /* Mobile: without JS the list stacks under the logo (usable). With JS the
     hamburger appears and the list becomes a disclosure panel. */
  @media (max-width: 767px) {
    .nav-inner {
      flex-wrap: wrap;
      padding-inline: var(--space-sm) 0.375rem;
    }

    /* No-JS: stay in normal flow so the stacked link list is not clipped
       by the fixed bar height. Inline script sets data-js before paint. */
    .site-header:not([data-js]) {
      position: relative;
      height: auto;
    }

    .site-header:not([data-js]) .nav-inner {
      height: auto;
      padding-block: var(--space-2xs);
    }

    .site-header:not([data-js]) + .site-header-spacer {
      display: none;
    }

    .site-header[data-js] .nav-toggle {
      display: inline-flex;
      margin-left: auto;
    }

    .site-header[data-js] .nav-inner {
      flex-wrap: nowrap;
    }

    .site-header[data-js] #site-nav[hidden] {
      display: none;
    }

    /*
     * The open menu: a floating sheet of blue-tinted clear liquid glass
     * under the bar (MOTION-6), one timeline for glass, links and icon.
     *
     *   #site-nav   the positioned box; no paint of its own and never
     *               scaled or clipped, so link text is never cut or skewed
     *   .nav-glass  the glass: Q27 blue light over a blur, so the page
     *               behind shows as color and shape but never as a second
     *               line of text; it unfolds out of the menu button
     *
     * Open: the glass springs from the button's box to full size; the
     * links only start once it is about 95 percent open (the spring is
     * front-loaded), a few frames apart, so no text ever sits outside the
     * glass or on an empty-looking sheet. Close: the links leave first,
     * then the glass folds back into the button and fades at the very end;
     * the icon turns with it. All transitions, so a tap mid-way reverses
     * from where everything is; nav-menu.client.ts hides the box only once
     * the fold has played.
     */
    .site-header[data-js] #site-nav:not([hidden]) {
      display: block;
      position: absolute;
      top: calc(100% + var(--space-2xs));
      right: var(--site-header-inset);
      left: var(--site-header-inset);
      z-index: 1;
      isolation: isolate;
      padding: var(--space-2xs);
      border-radius: var(--radius-ticket-panel);
      pointer-events: auto;
    }

    .site-header[data-js] #site-nav:not([hidden]) .nav-glass {
      display: block;
      position: absolute;
      inset: 0;
      z-index: -1;
      overflow: hidden;
      border-radius: inherit;
      background:
        radial-gradient(
          80% 60% at 12% 0%,
          color-mix(in srgb, var(--color-white) 55%, transparent),
          transparent 70%
        ),
        linear-gradient(
          165deg,
          color-mix(in srgb, var(--color-ticket-ground) 62%, transparent) 0%,
          color-mix(in srgb, var(--color-ticket-ice) 64%, transparent) 60%,
          color-mix(
              in srgb,
              color-mix(
                  in srgb,
                  var(--color-ticket-sky) 44%,
                  var(--color-ticket-ice)
                )
                72%,
              transparent
            )
            100%
        );
      box-shadow:
        inset 0 1px 1px var(--color-white),
        inset 0 0 0 1px color-mix(in srgb, var(--color-white) 55%, transparent),
        inset 0 -26px 36px -26px
          color-mix(in srgb, var(--color-ticket-cyan) 85%, transparent),
        0 0 0 1px color-mix(in srgb, var(--color-navy) 6%, transparent),
        0 22px 44px -20px color-mix(in srgb, var(--color-navy) 40%, transparent),
        0 0 30px -12px
          color-mix(in srgb, var(--color-ticket-cyan) 60%, transparent);
      -webkit-backdrop-filter: blur(22px) saturate(180%) brightness(1.06);
      backdrop-filter: blur(22px) saturate(180%) brightness(1.06);
      /* Folded: the menu button's box, at the bar's right edge. */
      transform-origin: calc(100% - 1.4rem) -0.75rem;
      opacity: 0;
      transform: translateY(-0.5rem) scale(0.14, 0.1);
      transition:
        transform var(--duration-glass-fold) var(--ease-emphasized)
          calc(var(--duration-glass-fold) * 0.35),
        opacity calc(var(--duration-glass-fold) * 0.5) var(--ease-snappy)
          calc(var(--duration-glass-fold) * 0.85);
    }

    .site-header[data-js] #site-nav[data-sheet="open"] .nav-glass {
      opacity: 1;
      transform: none;
      transition:
        transform var(--duration-glass-unfold) var(--ease-glass-spring),
        opacity var(--duration-hover) var(--ease-snappy);
    }

    /* The light that runs across the glass as it unfolds. */
    .site-header[data-js] #site-nav:not([hidden]) .nav-sheen {
      display: block;
      position: absolute;
      inset: 0;
      z-index: 1;
      background: linear-gradient(
        172deg,
        transparent 0% 30%,
        color-mix(in srgb, var(--color-white) 75%, transparent) 50%,
        transparent 70% 100%
      );
      opacity: 0;
      transform: translateY(-70%);
      pointer-events: none;
    }

    .site-header[data-js] #site-nav[data-sheet="open"] .nav-sheen {
      animation: nav-sheen var(--duration-glass-light) var(--ease-emphasized)
        var(--duration-glass-stagger) both;
    }

    /* Links: in once the glass is open, out before it folds. */
    .site-header[data-js] #site-nav li {
      opacity: 0;
      transform: translateY(-0.35rem);
      transition:
        opacity calc(var(--duration-glass-fold) * 0.35) var(--ease-snappy),
        transform calc(var(--duration-glass-fold) * 0.35) var(--ease-snappy);
    }

    .site-header[data-js] #site-nav[data-sheet="open"] li {
      opacity: 1;
      transform: none;
      transition-duration: calc(var(--duration-glass-unfold) * 0.5);
      transition-timing-function: var(--ease-emphasized);
      transition-delay: calc(
        var(--duration-glass-unfold) * 0.4 + var(--duration-glass-stagger) *
          0.6 * var(--i, 0)
      );
    }

    /* The moving light inside the glass: two oversized layers. */
    .site-header[data-js] #site-nav:not([hidden]) .nav-glass::before,
    .site-header[data-js] #site-nav:not([hidden]) .nav-glass::after {
      content: "";
      position: absolute;
      pointer-events: none;
    }

    .site-header[data-js] #site-nav:not([hidden]) .nav-glass::before {
      inset: -45%;
      background:
        radial-gradient(
          30% 20% at 34% 38%,
          color-mix(in srgb, var(--color-ticket-cyan) 45%, transparent),
          transparent
        ),
        radial-gradient(
          26% 32% at 68% 64%,
          color-mix(in srgb, var(--color-white) 45%, transparent),
          transparent
        ),
        radial-gradient(
          22% 16% at 60% 28%,
          color-mix(in srgb, var(--color-ticket-sky) 30%, transparent),
          transparent
        );
    }

    .site-header[data-js] #site-nav:not([hidden]) .nav-glass::after {
      inset: -40%;
      background:
        radial-gradient(
          30% 22% at 62% 72%,
          color-mix(in srgb, var(--color-ticket-sky) 34%, transparent),
          transparent
        ),
        radial-gradient(
          20% 28% at 28% 66%,
          color-mix(in srgb, var(--color-ticket-cyan) 35%, transparent),
          transparent
        );
    }

    /* The link list scrolls inside the sheet on a short landscape screen. */
    .site-header[data-js] #site-nav:not([hidden]) ul {
      position: relative;
      z-index: 1;
      max-height: calc(
        min(70svh, 100svh - var(--site-header-height)) - 2 * var(--space-2xs)
      );
      overflow-y: auto;
      overscroll-behavior: contain;
    }

    nav ul {
      flex-direction: column;
      flex-wrap: nowrap;
      gap: 0;
      width: 100%;
    }

    nav a {
      display: flex;
      align-items: center;
