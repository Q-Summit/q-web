---
// Chevron glyph for the native <details>/<summary> accordions (DESIGN.md
// COMP-3, COMP-4). One copy of the 32-grid path the Webflow port pasted
// inline into all four accordions (home + program FAQ, hackathon FAQ,
// ticket categories). Single path, fill=currentColor, so it takes the
// summary's color; the summary text carries the accessible name, so the
// icon is decorative (aria-hidden here), like the four social icons.
// Rotation on [open] stays with each accordion, which owns its own
// chevron box.
interface Props {
  /** Rendered box in px. 32 everywhere except the home FAQ, which ships 24. */
  size?: number;
}

const { size = 32 } = Astro.props;
---

<svg
  width={size}
  height={size}
  viewBox="0 0 32 32"
  fill="currentColor"
  aria-hidden="true"
  focusable="false"
>
  <path
    fill-rule="evenodd"
    clip-rule="evenodd"
    d="M16.5303 20.8839C16.2374 21.1768 15.7626 21.1768 15.4697 20.8839L7.82318 13.2374C7.53029 12.9445 7.53029 12.4697 7.82318 12.1768L8.17674 11.8232C8.46963 11.5303 8.9445 11.5303 9.2374 11.8232L16 18.5858L22.7626 11.8232C23.0555 11.5303 23.5303 11.5303 23.8232 11.8232L24.1768 12.1768C24.4697 12.4697 24.4697 12.9445 24.1768 13.2374L16.5303 20.8839Z"
  ></path>
</svg>
