---
// Partners on the white surface. The section opens with a giant cut-out
// "Partners": the white looks cut open and the violet light of the page
// shines through the letters (hack-light.css). Below it the three roles from
// the CMS ("Presented by", "Powered by", "Local Tool Partner") sit side by
// side like the poster's partner strip, stacked on phones.
//
// Logos are the official files, unmodified: no recoloring, no effects, no
// part in the fragment animation. Each gets its optical height and the
// clear space its own brand guide asks for (registry below). When the strip
// scrolls in, a short pass of light runs behind each mark; the mark itself
// only fades in.
//
// Logos come from the code-side registry keyed by the CMS `logoFile`
// select. An unregistered key renders a clearly marked placeholder in local
// dev builds and is skipped in production builds (every partner of the
// 2026 event is registered).
import type { PartnerGroup } from "../../lib/content";
import "./hack-light.css";

interface Props {
  heading: string;
  groups: PartnerGroup[];
}

const { heading, groups } = Astro.props;

// Build-time lookup from the CMS logoFile key to the R2 media copy and its
// intrinsic size (avoids layout shift). Webflow-era keys are the extracted
// Webflow filenames; the 2026 keys name the official brand-kit file.
// `mark` is the optical display height in rem (logos differ wildly in
// aspect ratio) and `space` the clear space each brand guide asks for, as a
// multiple of that height. Keep the keys in sync with
// HACKATHON_LOGO_FILE_OPTIONS in apps/cms/src/globals/PageHackathon.ts.
interface LogoAsset {
  src: string;
  width: number;
  height: number;
  mark?: number;
  space?: number;
}

const logoAssets: Record<string, LogoAsset> = {
  "69bfc230ceecbebceff708fc_new-logo.webp": {
    src: "/media/hackathon/partners/spherecast.webp",
    width: 1436,
    height: 1436,
  },
  "69b17a0e089f34c65a5e14a2_Picnic_logo.svg": {
    src: "/media/hackathon/partners/picnic.svg",
    width: 240,
    height: 240,
  },
  "69bfc037724d038aa2ba26bc_image.png": {
    src: "/media/hackathon/partners/exxeta.png",
    width: 719,
    height: 146,
  },
  "69c25665fc7b9cf5fb7a2889_f6961aac836f-Logo__2_.webp": {
    src: "/media/hackathon/partners/cloover.webp",
    width: 1500,
    height: 310,
  },
  "69d00444ac69243eaf2b4f4f_istari-logo.svg": {
    src: "/media/hackathon/partners/istari.svg",
    width: 131,
    height: 22,
  },
  "69c255cf7613b98e497cf289_OpenAI-black-wordmark(1).webp": {
    src: "/media/hackathon/partners/openai.webp",
    width: 2306,
    height: 688,
  },
  "69b2e8289e0d3b7dd0ae9529_lovable_logo.svg": {
    src: "/media/hackathon/partners/lovable.svg",
    width: 911,
    height: 155,
  },
  "69c99a0acf960a512107bc95_Anthropic_logo.svg": {
    src: "/media/hackathon/partners/anthropic.svg",
    width: 1024,
    height: 115,
  },
  "69c256c8d3ff156cf6877066_elevenlabs-logo-black.webp": {
    src: "/media/hackathon/partners/elevenlabs.webp",
    width: 2082,
    height: 270,
  },
  "69ccf786df18a395b3fee7fd_n8n_pink%2Bblack_logo.svg": {
    src: "/media/hackathon/partners/n8n.svg",
    width: 576,
    height: 160,
  },
  "69d40a60aa0c813fdc6344eb_featherlessai-transparent.webp": {
    src: "/media/hackathon/partners/featherless.webp",
    width: 912,
    height: 191,
  },
  "69d675fef0b853cb5df97e4e_liveavatar_logo_vertical_dark.webp": {
    src: "/media/hackathon/partners/liveavatar.webp",
    width: 1799,
    height: 685,
  },
  "69b458c74be9d2023714bcbf_itmx_logo.webp": {
    src: "/media/hackathon/partners/itmx.webp",
    width: 2128,
    height: 829,
  },
  "69d00453416ddd4a45dad964_mlh-logo-color-dark.svg": {
    src: "/media/hackathon/partners/mlh.svg",
    width: 311,
    height: 131,
    mark: 3.4,
    space: 0.35,
  },
  // DigitalOcean horizontal logo, blue, from "DO Logo Assets.zip" on
  // digitalocean.com/press. Safe space: half the icon height.
  "digitalocean-logo-horizontal-blue.svg": {
    src: "/media/hackathon/partners/digitalocean.svg",
    width: 603,
    height: 103,
    mark: 2.5,
    space: 0.5,
  },
  // DEV badge, black, from hacktoberfest.com/brand (partners/dev-logo-black.svg).
  "dev-logo-black.svg": {
    src: "/media/hackathon/partners/dev.svg",
    width: 448,
    height: 512,
    mark: 4.25,
    space: 0.25,
  },
  // ElevenLabs logo, black, from elevenlabs.io/brand. Clear space: at least
  // the logo height on every side.
  "elevenlabs-logo-black.svg": {
    src: "/media/hackathon/partners/elevenlabs.svg",
    width: 694,
    height: 90,
    mark: 1.7,
    space: 1,
  },
};

const showPlaceholders = import.meta.env.DEV;

type RoleLogo =
  | ({ kind: "logo"; name: string; href: string } & LogoAsset)
  | { kind: "missing"; name: string; href: string };

const roles = groups
  .map((group) => ({
    heading: group.group,
    logos: group.partners.flatMap((partner): RoleLogo[] => {
      const asset = logoAssets[partner.logoFile];
      if (asset) {
        return [
          { kind: "logo", name: partner.name, href: partner.href, ...asset },
        ];
      }
      return showPlaceholders
        ? [{ kind: "missing", name: partner.name, href: partner.href }]
        : [];
    }),
  }))
  .filter((role) => role.logos.length > 0);

// Partner footnotes (e.g. DigitalOcean's trademark line) come from the
// optional CMS `note` field and are listed once under the strip.
const notes = groups
  .flatMap((group) => group.partners.map((partner) => partner.note))
  .filter((note): note is string => Boolean(note));
---

{
  roles.length > 0 && (
    <section class="partners" aria-labelledby="partners-heading">
      <div class="container">
        <h2
          id="partners-heading"
          class="hack-giant hack-cut hack-cut-text"
          data-reveal="text"
        >
          {heading}
        </h2>
        <ul class="roles">
          {roles.map((role) => (
            <li class="role">
              <h3 class="role-heading">{role.heading}</h3>
              <ul class="role-logos">
                {role.logos.map((logo) => (
                  <li>
                    {logo.kind === "logo" ? (
                      <a
                        class="role-logo"
                        href={logo.href}
                        target="_blank"
                        rel="noopener noreferrer"
                        aria-label={`${logo.name} (opens in a new tab)`}
                        data-reveal="logo"
                        style={[
                          `--mark:${logo.mark ?? 3}rem`,
                          `--space:${logo.space ?? 0.4}`,
                        ].join(";")}
                      >
                        <img
                          src={logo.src}
                          alt=""
                          width={logo.width}
                          height={logo.height}
                          loading="lazy"
                          decoding="async"
                        />
                      </a>
                    ) : (
                      <span class="role-missing">
                        <strong>{logo.name}</strong>
                        <span>Logo not registered</span>
                      </span>
                    )}
                  </li>
                ))}
              </ul>
            </li>
          ))}
        </ul>
        {notes.length > 0 && (
          <div class="notes">
            {notes.map((note) => (
              <p>{note}</p>
            ))}
          </div>
        )}
      </div>
    </section>
  )
}

<style>
  /* Partner strip in the campaign system (DESIGN.md HACK-1 deviating from
     LAYOUT-3 and TYPE-1): its own rhythm on the white surface, a giant
     cut-out heading instead of the navy h2. */
  .partners {
    padding-block: clamp(var(--space-xl), 8vh, 5.5rem)
      clamp(var(--space-xl), 7vh, 5rem);
  }

  .roles {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
    margin: 0 auto;
    padding: 0;
    max-width: var(--container-medium);
    list-style: none;
  }

  .role {
    display: grid;
    justify-items: center;
    align-content: start;
    gap: var(--space-xs);
    padding: var(--space-sm) var(--space-lg);
  }

  .role + .role {
    border-left: 1px solid var(--color-hack-mist);
  }

  .role-heading {
    margin: 0;
    color: var(--color-hack-mid);
    font-size: var(--text-size-small);
    font-weight: var(--font-weight-semibold);
    letter-spacing: 0.02em;
  }

  .role-logos {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* Height-normalized marks with their brand's clear space as padding. */
  .role-logo {
    display: grid;
    place-items: center;
    height: calc(var(--mark) * (1 + 2 * var(--space)));
    padding: calc(var(--mark) * var(--space));
    border-radius: var(--radius-card);
    --hack-sweep-color: var(--color-hack-haze);
  }

  .role-logo img {
    display: block;
    width: auto;
    height: var(--mark);
    max-width: 100%;
  }

  .role-logo:focus-visible {
    outline-offset: -2px;
  }

  /* Local preview only (never rendered in a production build). */
  .role-missing {
    display: grid;
    place-items: center;
    gap: 0.25rem;
    min-width: 10rem;
    padding: var(--space-xs) var(--space-sm);
    border: 2px dashed var(--color-hack-red);
    border-radius: var(--radius-card);
    color: var(--color-hack-ink);
    font-size: var(--text-size-small);
  }

  .role-missing span {
    color: var(--color-hack-red);
    font-size: var(--text-size-tiny);
    font-weight: var(--font-weight-semibold);
  }

  .notes {
    max-width: var(--container-small);
    margin: var(--space-lg) auto 0;
    color: var(--color-neutral);
    font-size: var(--text-size-tiny);
    text-align: center;
  }

  .notes p {
    margin: 0;
  }

  @media (max-width: 767px) {
    .roles {
      grid-template-columns: 1fr;
    }

    .role {
      padding-inline: 0;
      padding-block: var(--space-md);
    }

    .role + .role {
      border-left: 0;
      border-top: 1px solid var(--color-hack-mist);
    }
  }
</style>
