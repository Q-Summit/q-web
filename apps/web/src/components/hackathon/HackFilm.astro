---
// "A glimpse into past Q-Hack events": a neutral, logo-free laptop on the
// violet ground. Its display already shows the gallery: a curved film band
// wound around a tilted cylinder (after the Shader studio's film carousel),
// with the active photo in front and its neighbors bending away in
// perspective. Scrolling in, the view closes in on the display and the
// same band grows into the large view; it is the one gallery throughout,
// never swapped for another.
//
// The band is plain CSS 3D (perspective, rotateY, translateZ): no 3D
// library, no canvas (DESIGN.md MOTION-4). It is pointer, touch and
// keyboard operable: click or tap a frame to bring it forward, use the
// arrow buttons, the dots, the arrow keys, or a horizontal swipe. Swipes
// use touch-action: pan-y, so vertical page scrolling is never captured.
// Scrolling only drives the short intro (zoom, a slight turn and tilt);
// once a photo is chosen, nothing moves it again.
//
// One continuous band: every frame is cut into a few narrow facets on the
// cylinder, so the band bends in small steps instead of folding at each
// frame, and frames meet edge to edge. Light comes from the front: each
// facet darkens with its angle away from the viewer, the receding ends
// fade out (and, on wide screens, soften slightly), and a soft pool of
// light lies under the band. A change of photo only turns the cylinder.
//
// Sharpness: Chrome rasterizes layers under a perspective at one pixel per
// CSS pixel, ignoring the zoom and the screen's pixel density, and then
// stretches them (measured: half the sharpness of the same file shown
// flat). So the band is laid out K times larger than it appears (K = the
// zoom times the device pixel ratio plus a little, at most 4) and scaled down by 1/K:
// its layers then rasterize at the pixel size they reach in the large
// view.
//
// Images: the band starts with color placeholders (no image data in git).
// When the section approaches, the script loads the active photo at the
// width it will really be shown at, the direct neighbors at a medium
// width, and the outer frames small; every other variant only on demand.
// Without the script there is a still photo in the display and a plain
// grid of all photos below (DESIGN.md MOTION-2). Reduced motion keeps the
// gallery operable, without the zoom or any transition.
import {
  photoSrcset,
  photoUrl,
  PHOTO_WIDTHS,
  type PastPhoto,
} from "../../assets/media/hackathon";
import "./hack-light.css";

interface Props {
  heading: string;
  photos: PastPhoto[];
}

const { heading, photos } = Astro.props;
const [first] = photos;

// A closed band needs a few frames; with few photos the band carries each
// photo twice, so the cylinder is full and the neighbors stay close.
const hasBand = photos.length >= 3;
const repeat = photos.length <= 6 ? 2 : 1;
const slots = hasBand
  ? Array.from({ length: photos.length * repeat }, (_, i) => ({
      i,
      photo: photos[i % photos.length],
    }))
  : [];
// Facets per frame: four keep the bend at 9 degrees per step with ten
// frames, which reads as a curve, at 80 small layers in all.
const FACETS = 4;
const facets = Array.from({ length: FACETS }, (_, j) => j);

// Everything the script needs to pick a variant, as data on the view.
const galleryData = JSON.stringify({
  widths: PHOTO_WIDTHS,
  photos: photos.map((p) => ({
    urls: PHOTO_WIDTHS.map((w) => photoUrl(p, w)),
    caption: p.caption,
    alt: p.alt,
  })),
});
---

{
  first && (
    <section
      class="film"
      aria-labelledby="film-heading"
      data-hack-film
      data-hack-ground-zone
    >
      <div class="film-track">
        <div class="film-stage">
          <div class="film-head" data-reveal="rise">
            <h2 id="film-heading">{heading}</h2>
            <p>
              Photos from earlier Q-Hack events, not from the Hack Day itself.
            </p>
          </div>

          <div class="laptop" data-film-laptop>
            <div class="laptop-lid">
              <div class="laptop-bezel">
                <span class="laptop-camera" aria-hidden="true" />
                <div class="laptop-screen" data-film-screen>
                  {/* Still photo and grid exist for the no-script case only;
                    in <noscript> a browser with scripts never fetches them. */}
                  <noscript>
                    <img
                      class="screen-poster"
                      src={photoUrl(first, 768)}
                      srcset={photoSrcset(first)}
                      sizes="(max-width: 767px) 90vw, 56rem"
                      width={first.width}
                      height={first.height}
                      alt={first.alt}
                      loading="lazy"
                      decoding="async"
                      style={`object-position:${first.focus}`}
                      data-film-poster
                    />
                  </noscript>
                  {hasBand && (
                    <div
                      class="band-view"
                      role="group"
                      aria-roledescription="carousel"
                      aria-label="Photos from earlier Q-Hack events"
                      aria-describedby="film-help"
                      tabindex="0"
                      data-film-view
                      data-gallery={galleryData}
                      style={`--n:${slots.length};--facets:${FACETS}`}
                      hidden
                    >
                      <div class="band-mask">
                        <span class="band-floor" aria-hidden="true" />
                        <div class="band-space">
                          <div class="band-tilt">
                            <div class="band" data-film-band>
                              {slots.map(({ i, photo }) => (
                                <div
                                  class:list={[
                                    "slot",
                                    { "is-active": i === 0 },
                                  ]}
                                  data-slot={i}
                                  aria-hidden="true"
                                  style={[
                                    `--i:${i}`,
                                    `--tint-a:${photo.tint[0]}`,
                                    `--tint-b:${photo.tint[1]}`,
                                  ].join(";")}
                                >
                                  {facets.map((j) => (
                                    <div class="facet" style={`--j:${j}`}>
                                      <div class="facet-face">
                                        <div class="facet-frame">
                                          <div class="slot-photo">
                                            <img
                                              alt=""
                                              width={photo.width}
                                              height={photo.height}
                                              decoding="async"
                                              style={`object-position:${photo.focus}`}
                                            />
                                          </div>
                                          <p class="slot-caption">
                                            <span class="slot-badge">
                                              Previous Q-Hack
                                            </span>
                                            {photo.caption}
                                          </p>
                                        </div>
                                      </div>
                                      <div class="facet-back" />
                                    </div>
                                  ))}
                                </div>
                              ))}
                            </div>
                          </div>
                        </div>
                        <span class="band-shade" aria-hidden="true" />
                        <span class="band-soft is-start" aria-hidden="true" />
                        <span class="band-soft is-end" aria-hidden="true" />
                      </div>
                      <p id="film-help" class="u-visually-hidden">
                        Use the arrow keys, the buttons or swipe to switch
                        photos.
                      </p>
                      <p
                        class="u-visually-hidden"
                        aria-live="polite"
                        data-film-status
                      />
                    </div>
                  )}
                </div>
                <span class="screen-glare" aria-hidden="true" />
              </div>
            </div>
            <div class="laptop-hinge" aria-hidden="true" />
            <div class="laptop-base" aria-hidden="true" />
            <div class="laptop-shadow" aria-hidden="true" />
          </div>

          {hasBand && (
            <div class="film-controls" data-film-controls hidden>
              <button
                type="button"
                class="film-arrow"
                aria-label="Previous photo"
                data-film-prev
              >
                <svg
                  viewBox="0 0 24 24"
                  width="22"
                  height="22"
                  aria-hidden="true"
                >
                  <path d="M15 5l-7 7 7 7" />
                </svg>
              </button>
              <ol class="film-dots">
                {photos.map((photo, index) => (
                  <li>
                    <button
                      type="button"
                      class="film-dot"
                      aria-label={`Photo ${index + 1} of ${photos.length}: ${photo.caption}`}
                      aria-current={index === 0 ? "true" : undefined}
                      data-film-dot={index}
                    />
                  </li>
                ))}
              </ol>
              <button
                type="button"
                class="film-arrow"
                aria-label="Next photo"
                data-film-next
              >
                <svg
                  viewBox="0 0 24 24"
                  width="22"
                  height="22"
                  aria-hidden="true"
                >
                  <path d="M9 5l7 7-7 7" />
                </svg>
              </button>
            </div>
          )}
        </div>
      </div>

      <noscript>
        <ul class="film-grid">
          {photos.slice(1).map((photo) => (
            <li data-reveal="photo">
              <img
                src={photoUrl(photo, 768)}
                srcset={photoSrcset(photo)}
                sizes="(max-width: 767px) 90vw, 29rem"
                width={photo.width}
                height={photo.height}
                alt={photo.alt}
                loading="lazy"
                decoding="async"
                style={`object-position:${photo.focus}`}
              />
              <p class="grid-caption">
                <span class="slot-badge">Previous Q-Hack</span>
                {photo.caption}
              </p>
            </li>
          ))}
        </ul>
      </noscript>
    </section>
  )
}

<style>
  /* Campaign sequence on the violet ground (DESIGN.md HACK-1 deviating
     from LAYOUT-3 and TYPE-1). The laptop is drawn from neutral tokens with
     no brand; its shadow and reflections are light and material, not
     elevation (DEPTH-1). Top padding leaves room for the seam out of the
     white surface (--hack-seam, set on the page shell). */
  .film {
    --z: 0;
    /* Backdrop of the gallery, on the display and on the stage. */
    --film-backdrop:
      radial-gradient(
        ellipse 46% 40% at 50% 47%,
        color-mix(in srgb, var(--color-hack-haze) 26%, transparent),
        color-mix(in srgb, var(--color-hack-haze) 10%, transparent) 50%,
        transparent
      ),
      radial-gradient(
        farthest-corner at 50% 47%,
        var(--color-hack-mid),
        var(--color-hack-violet) 26%,
        var(--color-hack-deep) 62%,
        var(--color-hack-ink)
      );
    position: relative;
    padding-block: calc(var(--hack-seam, 14rem) * 0.55)
      clamp(var(--space-lg), 6vh, 4rem);
    color: var(--color-text-inverse);
  }

  .film-stage {
    position: relative;
    isolation: isolate;
    display: grid;
    justify-items: center;
    align-content: center;
    gap: clamp(var(--space-sm), 3vh, var(--space-lg));
    padding-inline: var(--padding-global);
  }

  .film-head {
    display: grid;
    gap: var(--space-2xs);
    max-width: 44rem;
    text-align: center;
  }

  .film-head h2 {
    margin: 0;
    color: var(--color-text-inverse);
    font-size: clamp(1.9rem, 4.2vw, 3.25rem);
    font-weight: var(--heading-weight-home);
    line-height: 1.05;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }

  .film-head p {
    margin: 0;
    color: color-mix(in srgb, var(--color-white) 82%, transparent);
  }

  /* ---- The laptop. Proportions after a current 14 to 16 inch notebook:
     16:10 display, thin even bezels, a slim aluminum rim, a thin base that
     is a little wider than the lid. Sized by width and height so the whole
     device, the heading and the controls fit one screen. */
  .laptop {
    position: relative;
    width: min(
      58rem,
      100%,
      calc((100svh - var(--hack-nav, 4rem) - 16rem) * 1.45)
    );
    transform-origin: var(--ox, 50%) var(--oy, 40%);
    transform: translate(
        calc(var(--dx, 0px) * var(--z)),
        calc(var(--dy, 0px) * var(--z))
      )
      scale(calc(1 + (var(--s, 1) - 1) * var(--z)));
  }

  .laptop-lid {
    position: relative;
    padding: 0.38%;
    border-radius: var(--radius-hack-lid);
  }

  /* Rim and bezel are painted on pseudo layers, so they can dissolve as
     the display takes over without fading the photos with them. */
  .laptop-lid::before,
  .laptop-bezel::before {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
    opacity: calc(1 - var(--z) * 1.5);
    pointer-events: none;
  }

  /* Aluminum rim: cool silver with a lilac cast from the room light and
     a fine specular line along the top edge. */
  .laptop-lid::before {
    background:
      linear-gradient(
        to bottom,
        color-mix(in srgb, var(--color-white) 80%, transparent),
        transparent 1.4%
      ),
      linear-gradient(
        160deg,
        color-mix(in srgb, var(--color-hack-haze) 35%, transparent),
        transparent 40%
      ),
      linear-gradient(
        to bottom,
        var(--color-neutral-lighter),
        var(--color-neutral-light) 12%,
        var(--color-neutral) 60%,
        var(--color-neutral-dark)
      );
  }

  .laptop-bezel {
    position: relative;
    padding: 1.9% 1.55% 2.3%;
    border-radius: var(--radius-hack-bezel);
  }

  .laptop-bezel::before {
    background: linear-gradient(
      to bottom,
      var(--color-neutral-darker),
      var(--color-black) 30%
    );
  }

  .laptop-camera {
    position: absolute;
    top: 0.75%;
    left: 50%;
    z-index: 1;
    width: 0.42%;
    aspect-ratio: 1;
    translate: -50% 0;
    border-radius: var(--radius-circle);
    background-color: var(--color-neutral-dark);
    opacity: calc(1 - var(--z) * 1.6);
  }

  .laptop-screen {
    position: relative;
    isolation: isolate;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    border-radius: calc(var(--radius-button) * (1 - var(--z)));
  }

  /* The display lights the band from behind: a soft light center behind
     the gallery in the lighter Hack violet, deepening to ink at the
     edges. As the view closes in it hands over to the same light on the
     stage (below), so the large view has no display edge. */
  .laptop-screen::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--film-backdrop);
    opacity: min(1, calc((1 - var(--z)) / 0.4));
    pointer-events: none;
  }

  /* Glass reflection over the whole cover glass (bezel and display): a
     faint diagonal sheen that fades as the view closes in, so the photos
     stay clean in the large view. */
  .screen-glare {
    position: absolute;
    inset: 0;
    z-index: 2;
    border-radius: inherit;
    background:
      linear-gradient(
        118deg,
        color-mix(in srgb, var(--color-white) 13%, transparent) 0%,
        color-mix(in srgb, var(--color-white) 4%, transparent) 26%,
        transparent 42%
      ),
      linear-gradient(
        to bottom,
        color-mix(in srgb, var(--color-white) 6%, transparent),
        transparent 8%
      );
    opacity: calc(1 - var(--z));
    pointer-events: none;
  }

  .laptop-hinge {
    position: relative;
    width: 94%;
    height: 0;
    margin-inline: auto;
    padding-bottom: 0.85%;
    border-radius: 0 0 var(--radius-button) var(--radius-button);
    background: linear-gradient(
      to bottom,
      var(--color-black),
      var(--color-neutral-darker)
    );
    opacity: calc(1 - var(--z) * 1.6);
  }

  .laptop-base {
    position: relative;
    width: 107%;
    height: 0;
    margin-left: -3.5%;
    padding-bottom: 1.5%;
    border-radius: var(--radius-hack-base);
    background: linear-gradient(
      to bottom,
      var(--color-neutral-lightest),
      var(--color-neutral-lighter) 22%,
      var(--color-neutral-light) 60%,
      var(--color-neutral)
    );
    opacity: calc(1 - var(--z) * 1.6);
  }

  /* Front thumb scoop. */
  .laptop-base::before {
    content: "";
    position: absolute;
    top: 0;
    left: 50%;
    width: 13%;
    height: 45%;
    translate: -50% 0;
    border-radius: 0 0 var(--radius-button) var(--radius-button);
    background: linear-gradient(
      to bottom,
      var(--color-neutral),
      var(--color-neutral-light)
    );
  }

  /* Soft contact shadow on the ground. */
  .laptop-shadow {
    position: absolute;
    left: 2%;
    right: 2%;
    bottom: -2.4%;
    height: 4.5%;
    z-index: -1;
    border-radius: var(--radius-circle);
    background: radial-gradient(
      closest-side,
      color-mix(in srgb, var(--color-hack-ink) 80%, transparent),
      color-mix(in srgb, var(--color-hack-ink) 30%, transparent) 60%,
      transparent
    );
    opacity: calc(1 - var(--z) * 1.6);
    pointer-events: none;
  }

  /* Still photo for the no-script case; the script removes it. */
  .screen-poster {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* ---- The curved band (CSS 3D). Sizes come from the script in band
     space (--fw, --fh, --r, --perspective in px, K times the visible size,
     see the component comment); the fallbacks only keep a static render
     sane. --fw-css and --fh-css are the visible sizes. */
  .band-view {
    position: absolute;
    inset: 0;
    touch-action: pan-y;
    user-select: none;
    -webkit-user-select: none;
    -webkit-tap-highlight-color: transparent;
    cursor: grab;
    --step: calc(360deg / var(--n));
    --tilt-x: calc(-9deg - (1 - var(--zi, 1)) * 8deg);
    --tilt-z: -5deg;
    --intro: calc((1 - var(--zi, 1)) * 14deg);
    --band-top: calc(47% + (1 - var(--zi, 1)) * 6%);
  }

  .band-view[hidden] {
    display: none;
  }

  .band-view:focus-visible {
    outline-offset: -6px;
  }

  /* The receding ends fade out towards both sides on an eased ramp, so
     the band never meets the edge of the display, and the far side of
     the cylinder fades before the top edge. On its own layer below the
     focus ring, which must not fade. */
  .band-mask {
    position: absolute;
    inset: 0;
    /* A clip a hair inside the edge: the mask alone leaves the last,
       partly covered pixel column of the 3D layers unmasked. */
    clip-path: inset(0 2px);
    -webkit-mask-image:
      linear-gradient(
        to right,
        transparent 1.5%,
        color-mix(in srgb, var(--color-black) 16%, transparent) 6%,
        color-mix(in srgb, var(--color-black) 50%, transparent) 10.5%,
        color-mix(in srgb, var(--color-black) 84%, transparent) 15%,
        var(--color-black) 20%,
        var(--color-black) 80%,
        color-mix(in srgb, var(--color-black) 84%, transparent) 85%,
        color-mix(in srgb, var(--color-black) 50%, transparent) 89.5%,
        color-mix(in srgb, var(--color-black) 16%, transparent) 94%,
        transparent 98.5%
      ),
      linear-gradient(
        to bottom,
        transparent,
        color-mix(in srgb, var(--color-black) 50%, transparent) 5%,
        var(--color-black) 12%,
        var(--color-black) 92%,
        transparent
      );
    -webkit-mask-composite: source-in;
    mask-image:
      linear-gradient(
        to right,
        transparent 1.5%,
        color-mix(in srgb, var(--color-black) 16%, transparent) 6%,
        color-mix(in srgb, var(--color-black) 50%, transparent) 10.5%,
        color-mix(in srgb, var(--color-black) 84%, transparent) 15%,
        var(--color-black) 20%,
        var(--color-black) 80%,
        color-mix(in srgb, var(--color-black) 84%, transparent) 85%,
        color-mix(in srgb, var(--color-black) 50%, transparent) 89.5%,
        color-mix(in srgb, var(--color-black) 16%, transparent) 94%,
        transparent 98.5%
      ),
      linear-gradient(
        to bottom,
        transparent,
        color-mix(in srgb, var(--color-black) 50%, transparent) 5%,
        var(--color-black) 12%,
        var(--color-black) 92%,
        transparent
      );
    mask-composite: intersect;
  }

  /* Soft pool of light under the band, so it floats over a lit floor. A
     still gradient (no filter), following the band's tilt. */
  .band-floor {
    position: absolute;
    left: 50%;
    top: calc(var(--band-top) + var(--fh-css, 14rem) * 0.62);
    width: min(78%, calc(var(--fw-css, 18rem) * 2.6));
    height: calc(var(--fh-css, 14rem) * 0.55);
    transform: translate(-50%, -50%) rotate(var(--tilt-z));
    border-radius: var(--radius-circle);
    background: radial-gradient(
      closest-side,
      color-mix(in srgb, var(--color-hack-haze) 30%, transparent),
      color-mix(in srgb, var(--color-hack-haze) 16%, transparent) 35%,
      color-mix(in srgb, var(--color-hack-glow) 7%, transparent) 65%,
      transparent
    );
    pointer-events: none;
  }

  /* The band turn, set on .band only. Not inherited: as an inherited
     property every change would restyle every element of the band. */
  @property --active {
    syntax: "<number>";
    inherits: false;
    initial-value: 0;
  }

  /* Band space: laid out K times larger, shown at 1/K (sharpness, see the
     component comment). It takes no pointer events: hit-testing 80 3D
     layers on every mouse move is costly, so the script finds the frame
     under a click from the band geometry instead. */
  .band-space {
    pointer-events: none;
    position: absolute;
    left: 0;
    top: 0;
    width: calc(100% * var(--k, 1));
    height: calc(100% * var(--k, 1));
    transform: scale(calc(1 / var(--k, 1)));
    transform-origin: 0 0;
    perspective: var(--perspective, 70rem);
    perspective-origin: 50% 45%;
  }

  .band-tilt,
  .band {
    position: absolute;
    left: 50%;
    top: var(--band-top);
    width: 0;
    height: 0;
    transform-style: preserve-3d;
  }

  /* The first translate lifts the cylinder by what the tilt lowers the
     front frame (r * sin(tilt)), so the active photo stays just above the
     middle of the display at every tilt during the intro. */
  .band-tilt {
    transform: translateY(calc(var(--r, 30rem) * sin(var(--tilt-x))))
      translateZ(calc(var(--r, 30rem) * -1)) rotateX(var(--tilt-x))
      rotateZ(var(--tilt-z)) rotateY(var(--intro));
  }

  .band {
    left: 0;
    top: 0;
    transform: rotateY(calc(var(--active, 0) * var(--step) * -1));
  }

  /* A frame: a turn of the cylinder, holding its facets. */
  .slot {
    position: absolute;
    left: 0;
    top: 0;
    width: 0;
    height: 0;
    transform-style: preserve-3d;
    transform: rotateY(calc(var(--i) * var(--step)));
  }

  /* A facet: one narrow, flat slice of the frame on the cylinder wall.
     It is a hair wider than its slice so neighbors overlap instead of
     leaving an anti-aliased seam. */
  .facet {
    --slice: calc(var(--fw, 18rem) / var(--facets));
    --seam: calc(var(--k, 1) * 0.75px);
    --phi: calc(
      (var(--j) - (var(--facets) - 1) / 2) * var(--step) / var(--facets)
    );
    position: absolute;
    left: calc(var(--slice) * -0.5 - var(--seam));
    top: calc(var(--fh, 14rem) * -0.5);
    width: calc(var(--slice) + var(--seam) * 2);
    height: var(--fh, 14rem);
    transform-style: preserve-3d;
    transform: rotateY(var(--phi)) translateZ(var(--r, 30rem));
  }

  .facet-face,
  .facet-back {
    position: absolute;
    inset: 0;
    overflow: hidden;
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
  }

  /* The whole frame, shifted so this facet shows its own slice: the photo
     between two sprocket bands on dark film, with a thin film line
     between neighboring photos. */
  .facet-frame {
    position: absolute;
    top: 0;
    left: calc(var(--slice) * var(--j) * -1 + var(--seam));
    width: var(--fw, 18rem);
    height: 100%;
