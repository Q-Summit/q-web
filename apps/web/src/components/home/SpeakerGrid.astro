---
// Speaker highlights on the home page (DESIGN.md HOME-1): a grid of
// portrait cards. A card is a tile of pale glass with three parts that
// never cover a face: a band at the top with the tag that says what the
// person is to Q-Summit (frosted glass, at the right), the portrait set
// into the tile below it, cut off straight at its lower edge, and under it
// a white foot that begins just above the name: the name stands on a slab
// of clear glass in the manner of the glass Q, on white.
//
//   alumni   past speakers, badged with alumniLabel ("Past Speaker"), so
//            nobody reads them as booked for the next edition. The prop
//            names are historical: these are not Q alumni (former team
//            members), and the badge must not call them that
//   lineup   the next edition's lineup, badged with its year; the cards are
//            the published "current" speakers of that year, so publishing a
//            speaker in the CMS is all it takes to fill a slot. While the
//            edition has none, the page may pass earlier speakers in their
//            place, with their own badge (index.astro)
//
// Open lineup slots render only when `placeholders` is on (local review):
// they are marked placeholder cards, never a name or a face. With it off,
// open slots simply do not exist, and without any lineup speaker the row
// is gone, so a live build never shows an unfinished lineup.
import { Picture } from "../../lib/astro-assets";
import type { PageLink, Speaker } from "../../lib/content";
import { photoSrc } from "../../lib/media-filename";
import { resolveContentImage } from "../../lib/images";
import IconArrowRight from "../icons/IconArrowRight.astro";
import "./home-theme.css";

interface Props {
  eyebrow?: string;
  heading: string;
  cta: PageLink | undefined;
  /** Past speakers, in display order. */
  alumni: Speaker[];
  alumniLabel?: string;
  /** Published speakers of the next edition. */
  lineup?: Speaker[];
  lineupLabel?: string;
  /** How many lineup cards the row holds. */
  lineupSlots?: number;
  /** Fill open lineup slots with marked placeholder cards. */
  placeholders?: boolean;
  placeholderName?: string;
  placeholderRole?: string;
}

const {
  eyebrow,
  heading,
  cta,
  alumni,
  alumniLabel,
  lineup = [],
  lineupLabel,
  lineupSlots = 0,
  placeholders = false,
  placeholderName = "",
  placeholderRole = "",
} = Astro.props;

type Card =
  | {
      kind: "speaker";
      speaker: Speaker;
      badge?: string;
      tone: "alumni" | "lineup";
    }
  | { kind: "placeholder"; badge?: string };

const lineupCards: Card[] = lineup
  .slice(0, lineupSlots || lineup.length)
  .map((speaker) => ({
    kind: "speaker",
    speaker,
    badge: lineupLabel,
    tone: "lineup",
  }));
if (placeholders) {
  while (lineupCards.length < lineupSlots) {
    lineupCards.push({ kind: "placeholder", badge: lineupLabel });
  }
}

const cards: Card[] = [
  ...alumni.map((speaker): Card => ({
    kind: "speaker",
    speaker,
    badge: alumniLabel,
    tone: "alumni",
  })),
  ...lineupCards,
];

// Two rows: past speakers four across, the lineup row as many across as
// it has cards (up to five), so a row of five is not left with one card
// alone on a second line.
const indexed = cards.map((card, i) => ({ card, i }));

// A name as first name and the rest, so a narrow card can set the two on
// lines of their own (every caption then has the same two name lines).
function nameParts(name: string): [string, string] {
  const at = name.trim().indexOf(" ");
  return at < 0 ? [name.trim(), ""] : [name.slice(0, at), name.slice(at + 1)];
}
const rows = [
  { cols: 4, cards: indexed.slice(0, alumni.length) },
  {
    cols: Math.min(5, Math.max(4, lineupCards.length)),
    cards: indexed.slice(alumni.length),
  },
].filter((row) => row.cards.length > 0);

const images = await Promise.all(
  cards.map((card) =>
    card.kind === "speaker"
      ? resolveContentImage(
          card.speaker.photoFilename,
          `home speaker ${card.speaker.name}`,
        )
      : null,
  ),
);
---

{
  cards.length > 0 && (
    <section class="h-section h-speakers" aria-labelledby="home-speakers-title">
      <div class="h-shell">
        <div class="h-head">
          <div>
            {eyebrow && (
              <p class="h-eyebrow" data-lp="previousSpeakers.eyebrow">
                {eyebrow}
              </p>
            )}
            <h2
              id="home-speakers-title"
              class="h-title"
              data-lp="previousSpeakers.heading"
              data-h-reveal
            >
              {heading}
            </h2>
          </div>
          {cta && (
            <a
              class="h-more"
              href={cta.href}
              data-lp="previousSpeakers.cta"
              data-lp-href="previousSpeakers.cta.href"
            >
              <span data-lp-label>{cta.label}</span>
              <IconArrowRight />
            </a>
          )}
        </div>

        {rows.map((row) => (
          <ul class="h-speaker-grid" style={`--cols: ${row.cols}`}>
            {row.cards.map(({ card, i }) => (
              <li
                class:list={[
                  "h-speaker",
                  card.kind === "placeholder" && "is-placeholder",
                  card.kind === "speaker" && `is-${card.tone}`,
                ]}
                style={`--i: ${i % row.cols}`}
                data-h-reveal
              >
                <div class="h-speaker-top">
                  {card.badge && <p class="h-speaker-badge">{card.badge}</p>}
                </div>
                <div class="h-speaker-photo">
                  {card.kind === "placeholder" ? (
                    <span class="h-speaker-blank" aria-hidden="true" />
                  ) : images[i] ? (
                    <Picture
                      src={images[i]!}
                      alt={`Portrait of ${card.speaker.name}`}
                      widths={[320, 480, 640]}
                      sizes="(max-width: 599px) 46vw, (max-width: 1023px) 30vw, 18rem"
                      formats={["avif", "webp"]}
                      fallbackFormat="jpg"
                      quality={80}
                      loading="lazy"
                    />
                  ) : (
                    <img
                      src={photoSrc(card.speaker.photoFilename)}
                      alt={`Portrait of ${card.speaker.name}`}
                      width="640"
                      height="800"
                      loading="lazy"
                      decoding="async"
                    />
                  )}
                </div>
                <div class="h-speaker-foot">
                  <div class="h-speaker-caption">
                    <h3>
                      {card.kind === "speaker" ? (
                        <>
                          <span>{nameParts(card.speaker.name)[0]}</span>{" "}
                          <span>{nameParts(card.speaker.name)[1]}</span>
                        </>
                      ) : (
                        placeholderName
                      )}
                    </h3>
                    <p>
                      {card.kind === "speaker"
                        ? card.speaker.roleLine
                        : placeholderRole}
                    </p>
                  </div>
                </div>
              </li>
            ))}
          </ul>
        ))}
      </div>
    </section>
  )
}

<style>
  /* DESIGN.md HOME-1 */
  .h-speaker-grid {
    display: grid;
    grid-template-columns: repeat(var(--cols, 4), minmax(0, 1fr));
    gap: var(--space-sm);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .h-speaker-grid + .h-speaker-grid {
    margin-top: var(--space-sm);
  }

  /* The card: a tile of pale glass. Tag band, portrait, name slab, one
     under the other, so nothing is ever laid over a face. */
  .h-speaker {
    position: relative;
    isolation: isolate;
    display: flex;
    flex-direction: column;
    min-width: 0;
    padding: var(--space-2xs);
    border-radius: var(--radius-ticket-card);
    /* The type of tag and caption is sized against the card's width. */
    container-type: inline-size;
    background:
      radial-gradient(
        80% 50% at 15% 0%,
        color-mix(in srgb, var(--color-white) 90%, transparent),
        transparent 70%
      ),
      linear-gradient(
        175deg,
        color-mix(in srgb, var(--color-white) 78%, var(--color-ticket-ice)),
        color-mix(in srgb, var(--color-white) 45%, var(--color-ticket-ice))
      );
    box-shadow:
      inset 0 0 0 1px color-mix(in srgb, var(--color-white) 70%, transparent),
      inset 0 1px 1px var(--color-white),
      0 18px 36px -26px color-mix(in srgb, var(--color-navy) 55%, transparent);
  }

  /* The band above the portrait: only the tag, at the right. */
  .h-speaker-top {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    min-height: 1.75rem;
    margin-bottom: var(--space-2xs);
  }

  /* Tag: says what the person is to Q-Summit. Frosted glass, the material
     the name used to sit on: white over a wash of ice blue, a hairline
     rim, light along its top, cyan in its lower edge, navy type. */
  .h-speaker-badge {
    max-width: 100%;
    margin: 0;
    padding: 0.35rem 0.7rem;
    overflow: hidden;
    border-radius: var(--radius-ticket-pill);
    background:
      linear-gradient(
        170deg,
        color-mix(in srgb, var(--color-white) 92%, transparent) 0%,
        color-mix(in srgb, var(--color-white) 62%, transparent) 100%
      ),
      color-mix(in srgb, var(--color-ticket-ice) 70%, transparent);
    box-shadow:
      inset 0 0 0 1px color-mix(in srgb, var(--color-white) 75%, transparent),
      inset 0 1px 1px var(--color-white),
      inset 0 -6px 8px -6px var(--color-ticket-cyan),
      0 6px 12px -8px color-mix(in srgb, var(--color-navy) 55%, transparent),
      0 1px 2px color-mix(in srgb, var(--color-navy) 16%, transparent);
    color: var(--color-navy);
    font-size: min(var(--text-size-tiny), 7.2cqi);
    font-weight: var(--font-weight-extrabold);
    letter-spacing: 0.1em;
    line-height: 1.2;
    text-overflow: ellipsis;
    text-transform: uppercase;
    white-space: nowrap;
  }

  /* The portrait: an inlay in the tile, with the tile's inner radius at
     the top and a straight cut at the bottom, where the white foot begins.
     Light pools behind it while it loads or when a slot has no photo. */
  .h-speaker-photo {
    position: relative;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border-radius: var(--radius-ticket-panel) var(--radius-ticket-panel) 0 0;
    background: linear-gradient(
      170deg,
      var(--color-ticket-ice),
      color-mix(in srgb, var(--color-ticket-sky) 45%, var(--color-ticket-ice))
    );
  }

  /* The foot: a plain white bar under the portrait, as wide as it, from
     just above the name to the tile's lower inlay edge. A hard edge
     against the photo, no fade and no glow. */
  .h-speaker-foot {
    padding-top: var(--space-2xs);
    border-radius: 0 0 var(--radius-ticket-panel) var(--radius-ticket-panel);
    background: var(--color-white);
  }

  .h-speaker-photo :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 20%;
    transition: transform var(--duration-reveal) var(--ease-buttery);
  }

  @media (hover: hover) {
    .h-speaker:hover .h-speaker-photo :global(img) {
      transform: scale(1.04);
    }
  }

  /*
   * Caption: a slab of clear glass in the manner of the glass Q, on the
   * white foot. Almost no fill; the slab reads from what thick clear glass
   * does at its edges: a crisp rim, a thin blue line and a faint cyan
   * glow in the lower and right edge, a soft ice tint and a shadow under
   * it. The same size on every card: one line for the name (two on a
   * narrow card), two for the role.
   */
  .h-speaker-caption {
    position: relative;
    padding: var(--space-xs);
    border-radius: var(--radius-ticket-panel);
    background:
      radial-gradient(
        90% 120% at 0% 0%,
        color-mix(in srgb, var(--color-white) 55%, transparent),
        transparent 55%
      ),
      radial-gradient(
        70% 110% at 100% 100%,
        color-mix(in srgb, var(--color-ticket-sky) 16%, transparent),
        transparent 60%
      ),
      linear-gradient(
        160deg,
        color-mix(in srgb, var(--color-white) 26%, transparent) 0%,
        color-mix(in srgb, var(--color-white) 10%, transparent) 50%,
        color-mix(in srgb, var(--color-ticket-ice) 22%, transparent) 100%
      ),
      /* On the white foot the glass needs a tint of its own to read. */
      color-mix(in srgb, var(--color-ticket-ice) 30%, transparent);
    box-shadow:
      inset 0 0 0 1px color-mix(in srgb, var(--color-white) 92%, transparent),
      inset 0 2px 2px var(--color-white),
      inset 2px 0 3px -1px
        color-mix(in srgb, var(--color-white) 90%, transparent),
      inset 0 -1px 1px
        color-mix(in srgb, var(--color-ticket-sky) 60%, transparent),
      inset -1px 0 1px
        color-mix(in srgb, var(--color-ticket-sky) 45%, transparent),
      inset 0 0 0 5px color-mix(in srgb, var(--color-white) 22%, transparent),
      inset 0 -10px 14px -12px
        color-mix(in srgb, var(--color-ticket-sky) 55%, transparent),
      inset 0 0 12px color-mix(in srgb, var(--color-white) 65%, transparent),
      0 1px 0 color-mix(in srgb, var(--color-ticket-sky) 35%, transparent),
      0 10px 18px -14px color-mix(in srgb, var(--color-navy) 45%, transparent);
  }

  /* The reflections of the glass Q: a bright streak just inside the upper
     left edge, and a blue one inside the lower right. Each is a ring
     along the rim, kept only in its corner by a mask. */
  .h-speaker-caption::before,
  .h-speaker-caption::after {
    content: "";
    position: absolute;
    inset: 3px;
    border-radius: var(--radius-ticket-button);
    pointer-events: none;
  }

  .h-speaker-caption::before {
    border: 2px solid color-mix(in srgb, var(--color-white) 95%, transparent);
    -webkit-mask: linear-gradient(
      125deg,
      var(--color-black) 0%,
      var(--color-black) 22%,
      transparent 46%
    );
    mask: linear-gradient(
      125deg,
      var(--color-black) 0%,
      var(--color-black) 22%,
      transparent 46%
    );
  }

  .h-speaker-caption::after {
    border: 2px solid
      color-mix(in srgb, var(--color-ticket-sky) 55%, transparent);
    -webkit-mask: linear-gradient(
      305deg,
      var(--color-black) 0%,
      var(--color-black) 16%,
      transparent 40%
    );
    mask: linear-gradient(
      305deg,
      var(--color-black) 0%,
      var(--color-black) 16%,
      transparent 40%
    );
  }

  .h-speaker-caption h3,
  .h-speaker-caption p {
    position: relative;
  }

  /* The name never wraps on its own, so every caption has the same
     height. Its size follows the card's width, so a long name fits on one
     line on a wide card; a narrow card (below) sets first name and family
     name on two lines for everyone. A name longer than any today would end
     in an ellipsis (it stays complete in the portrait's alt text). */
  .h-speaker-caption h3 {
    margin: 0;
    overflow: hidden;
    color: var(--color-navy);
    font-size: min(var(--text-size-large), 6.4cqi);
    font-weight: var(--font-weight-extrabold);
    letter-spacing: -0.02em;
    line-height: 1.15;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  /* Always two lines high, never more. */
  .h-speaker-caption p {
    display: -webkit-box;
    min-height: calc(2 * 1.3em);
    margin: 0.2rem 0 0;
    overflow: hidden;
    color: color-mix(in srgb, var(--color-navy) 88%, transparent);
    font-size: var(--text-size-small);
    line-height: 1.3;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    line-clamp: 2;
  }

  @container (max-width: 17.5rem) {
    .h-speaker-caption h3 {
      font-size: min(var(--text-size-large), 9cqi);
    }

    .h-speaker-caption h3 span {
      display: block;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .h-speaker-caption p {
      font-size: min(var(--text-size-small), 8.2cqi);
    }
  }

  /* An open lineup slot: clearly not a person. A dashed rim, a neutral
     head-and-shoulders outline, and the placeholder wording from content. */
  .h-speaker.is-placeholder {
    box-shadow: none;
    outline: 2px dashed
      color-mix(in srgb, var(--color-ticket-sky) 55%, transparent);
    outline-offset: -2px;
  }

  .h-speaker-blank {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(
        circle at 50% 34%,
        color-mix(in srgb, var(--color-ticket-sky) 30%, transparent) 0 13%,
        transparent 13.5%
      ),
      radial-gradient(
        ellipse 34% 26% at 50% 78%,
        color-mix(in srgb, var(--color-ticket-sky) 30%, transparent) 0 99%,
        transparent 100%
      );
  }

  .h-speaker.is-placeholder .h-speaker-caption h3 {
    font-size: var(--text-size-regular);
  }

  @media (max-width: 1023px) {
    .h-speaker-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (max-width: 599px) {
    .h-speaker-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-xs);
    }

    .h-speaker-top {
      min-height: 1.5rem;
    }

    .h-speaker-badge {
      padding: 0.3rem 0.55rem;
      letter-spacing: 0.06em;
    }

    .h-speaker-caption {
      padding: var(--space-2xs);
    }

    .h-speaker-caption p {
      font-size: min(var(--text-size-tiny), 8.2cqi);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .h-speaker-photo :global(img) {
      transition: none;
    }

    .h-speaker:hover .h-speaker-photo :global(img) {
      transform: none;
    }
  }
</style>
