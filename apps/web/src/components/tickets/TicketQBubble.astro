---
// The Q in a ticket card and in a ticket summary (DESIGN.md TICKETS-1): the
// glass Q of the home ground (home/GlassQ.astro), the Q mark rendered in 3D
// as thick clear glass from the brand file's own outline, so both pages
// carry the same object and the drawing is never redrawn. The cards use a
// 400 px copy of that render (public/home/q-glass-s.webp): a card shows the
// Q at a third of its width, so the full size would only cost decode time
// and texture memory. It only floats, turns a few
// degrees and breathes evenly: it is never stretched or skewed. Decorative:
// empty alt, aria-hidden, no pointer events. Placement and size come from
// the caller's modifier class in ticket-theme.css (is-card, is-summary).
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<img
  class:list={["t-qb", className]}
  src="/home/q-glass-s.webp"
  alt=""
  aria-hidden="true"
  width="400"
  height="400"
  decoding="async"
/>
