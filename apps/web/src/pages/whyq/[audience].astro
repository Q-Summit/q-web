---
// /whyq/students/, /whyq/startups/, /whyq/corporates/, /whyq/investors/:
// one page per audience, the targets of the "Why Q?" submenu and of the
// homepage's audience picker. Together they are "Why Q?": there is no
// overview page (/whyq/ redirects to the picker on the homepage,
// astro.config.mjs).
//
// Each page follows the team's page template in structure and wording
// (hero, key figures, activities, one highlight, the audience's ticket, a
// short FAQ) and is drawn in the 2027 homepage's system (DESIGN.md WHYQ-1,
// HOME-1): its navy night, type, liquid glass and reveals; the ticket card
// is the ticket page's. The registry of routes lives in
// lib/whyq-audiences.ts and the pages' copy in lib/whyq-pages.ts; the
// page's name and the breadcrumb's first step come from the site-settings
// nav, and tickets, prices and the sale phase from page-tickets, the
// source of /ticket-categories/.
import Base from "../../layouts/Base.astro";
import AudienceHero from "../../components/whyq/AudienceHero.astro";
import AudienceStats from "../../components/whyq/AudienceStats.astro";
import AudienceActivities from "../../components/whyq/AudienceActivities.astro";
import AudienceHighlight from "../../components/whyq/AudienceHighlight.astro";
import AudienceTicket from "../../components/whyq/AudienceTicket.astro";
import AudienceFaq from "../../components/whyq/AudienceFaq.astro";
import { euro, salePriceLabel } from "../../components/tickets/ticket-model";
import {
  getPageContent,
  getPartners,
  getSiteSettings,
} from "../../lib/content";
import logoManifest from "../../components/partner/logo-manifest.json";
import {
  resolvePartnerLogoDisplay,
  type PartnerLogoMeta,
} from "../../lib/partner-logos";
import type { WhyqLogo } from "../../components/whyq/AudienceHighlight.astro";
import type { Faq, TicketOffer } from "../../lib/content";
import { EVENTS } from "../../lib/analytics/events";
import {
  WHYQ_AUDIENCE_PAGES,
  whyqAudienceNames,
} from "../../lib/whyq-audiences";
import {
  WHYQ_PAGE_COPY,
  WHYQ_SHARED,
  fillTicketTokens,
} from "../../lib/whyq-pages";
import JsonLd from "../../components/seo/JsonLd.astro";
import { breadcrumbLd } from "../../lib/seo";

export function getStaticPaths() {
  return WHYQ_AUDIENCE_PAGES.map(({ slug, audienceId }) => ({
    params: { audience: slug },
    props: { slug, audienceId },
  }));
}

const { slug } = Astro.props as { slug: string };
const copy = WHYQ_PAGE_COPY[slug];
if (!copy) {
  throw new Error(
    `[whyq] no page copy for "${slug}". Add it to WHYQ_PAGE_COPY in src/lib/whyq-pages.ts.`,
  );
}

const [{ whyq, ticketCategories, contact }, { nav }, partners] =
  await Promise.all([getPageContent(), getSiteSettings(), getPartners()]);

const { label, parentLabel } = whyqAudienceNames(slug, nav);
// A nav without a "Why Q?" item still gets a name from content.
const section = parentLabel ?? whyq.heading;

// The breadcrumb trail Google shows instead of the bare URL.
const crumbs = breadcrumbLd(Astro.site, [
  { name: "Home", path: "/" },
  { name: label, path: `/whyq/${slug}/` },
]);

const { phases } = ticketCategories;

// The audience's tickets, in the order the page names them. A ticket an
// editor removed must not fail the build: the section shows what is left,
// or is left out.
const tickets = copy.ticket.keys
  .map((key) => ticketCategories.offer.tickets.find((t) => t.key === key))
  .filter((t): t is TicketOffer => t !== undefined);

const escapeHtml = (value: string) =>
  value.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");

// An answer that quotes a price takes it from the offer; one whose ticket
// is gone is dropped rather than printed with a hole in it.
// The day the Early Bird price ends ("November 22"), from the sale phases
// of page-tickets: the "early-bird" phase, else the phase on sale. An
// answer that names it is left out while no phase has an end date.
const earlyBird =
  phases?.items.find((item) => item.key === "early-bird") ??
  phases?.items.find((item) => item.key === phases.activeKey);
const saleEnd =
  earlyBird?.endsAt && !Number.isNaN(Date.parse(earlyBird.endsAt))
    ? new Intl.DateTimeFormat("en-US", {
        month: "long",
        day: "numeric",
        timeZone: "Europe/Berlin",
      }).format(new Date(earlyBird.endsAt))
    : undefined;

const faqs: Faq[] = copy.faq.items.flatMap((item) => {
  if (item.answer.includes("{saleEnd}") && !saleEnd) return [];
  const answer = fillTicketTokens(
    item.answer.replaceAll("{saleEnd}", saleEnd ?? ""),
    ticketCategories.offer.tickets,
    euro,
  );
  return answer === undefined
    ? []
    : [
        {
          question: item.question,
          answerHtml: `<p>${escapeHtml(answer)}</p>`,
          page: "index" as const,
          topic: "",
        },
      ];
});

// "Still have a question? Write to ...": the contact page's general
// address (its reach-out entry for contacting us), else the contact page.
const contactEmail =
  contact.reachOut.items.find(
    (item) => item.email && /contact/i.test(item.details.join(" ")),
  )?.email ?? contact.reachOut.items.find((item) => item.email)?.email;
const faqMore = contactEmail
  ? {
      text: WHYQ_SHARED.faqMore.text,
      linkLabel: contactEmail,
      href: `mailto:${contactEmail}`,
    }
  : WHYQ_SHARED.faqMore;

// Logos for the companies the highlight names, from the partners
// collection, matched as the homepage's strip matches them (exact, case
// and punctuation aside; "&" reads as "and"). A name without a logo stays
// a name.
const normalizeName = (name: string) =>
  name
    .toLowerCase()
    .replace(/&/g, "and")
    .replace(/[^a-z0-9]/g, "");
const highlightNames =
  copy.highlight.kind === "logos" || copy.highlight.kind === "qube"
    ? copy.highlight.names
    : [];
const logos: Record<string, WhyqLogo> = {};
for (const name of highlightNames) {
  const partner = partners.find(
    (entry) => normalizeName(entry.name) === normalizeName(name),
  );
  const logo = partner
    ? resolvePartnerLogoDisplay(
        partner,
        logoManifest as Record<string, PartnerLogoMeta>,
        "[whyq] highlight logos",
      )
    : null;
  if (logo) logos[name] = logo;
}
---

<Base
  title={`${label} | ${section}`}
  description={copy.metaDescription}
  pageEvent={{
    name: EVENTS.whyq_audience_viewed,
    props: { audience: slug },
  }}
>
  <Fragment slot="jsonld">
    <JsonLd data={crumbs} />
  </Fragment>
  <script is:inline>
    document.documentElement.classList.add("h-js");
  </script>
  <div class="h-home whyq-page">
    <AudienceHero
      parentLabel={section}
      parentHref="/#why-attend"
      crumb={copy.crumb}
      heading={copy.hero.heading}
      intro={copy.hero.intro}
      ctaLabel={copy.hero.ctaLabel}
      ctaHref="#ticket"
      jumpLabel={WHYQ_SHARED.jumpLabel}
      jumpHref="#activities"
      eventLine={WHYQ_SHARED.eventLine}
      audience={slug}
    />
    <AudienceStats heading={`${copy.crumb} in numbers`} stats={copy.stats} />
    <AudienceActivities
      id="activities"
      eyebrow={WHYQ_SHARED.activitiesEyebrow}
      heading={copy.activities.heading}
      intro={copy.activities.intro}
      activities={copy.activities.items}
    />
    <AudienceHighlight
      id="highlight"
      highlight={copy.highlight}
      logos={logos}
    />
    {
      tickets.length > 0 && (
        <AudienceTicket
          id="ticket"
          eyebrow={WHYQ_SHARED.ticketEyebrow}
          copy={copy.ticket}
          tickets={tickets}
          offer={ticketCategories.offer}
          included={ticketCategories.included}
          phases={phases}
          priceLabel={salePriceLabel(phases)}
          allTicketsLabel={WHYQ_SHARED.allTicketsLabel}
          ticketsHref={WHYQ_SHARED.ticketsHref}
          audience={slug}
        />
      )
    }
    <AudienceFaq
      id="faq"
      eyebrow={WHYQ_SHARED.faqEyebrow}
      heading={copy.faq.heading}
      faqs={faqs}
      more={faqMore}
    />
    <div class="h-page-fade" aria-hidden="true"></div>
  </div>
</Base>

<script>
  import { initWhyq } from "../../components/whyq/whyq.client";

  initWhyq();
</script>
