---
// "Get to Know Our Previous Partners": large partner photos, each one a
// real button that opens that partner's quote as a white speech bubble
// rising above the photo (DESIGN.md PARTNER-1). Only one bubble is open at
// a time; Escape, a click elsewhere or the same photo again closes it.
//
// Progressive enhancement: the markup is a plain grid of photos with every
// quote standing under its photo. testimonials.client.ts reveals the photo
// buttons and turns the quotes into bubbles. A missing photo shows the
// person's initials (ui/PersonPhoto).
//
// Rendered inside the page's own section and container: this component
// adds only the grid, not a section shell (DESIGN.md LAYOUT-1/LAYOUT-3).
// Each person is a pane of the page's glass (partner-theme.css, in
// the home page's finish); the quote mark is the home page's round clear
// glass (as the speaker arrows), the bubble white with navy type.
import PersonPhoto from "../ui/PersonPhoto.astro";
import "./partner-theme.css";
import type { PartnerTestimonial } from "../../lib/content";

interface Props {
  testimonials: PartnerTestimonial[];
}

const { testimonials } = Astro.props;

// Attribution comes as "Name, Company"; keep any extra commas in the company.
const items = testimonials.map(({ quote, attribution, photoFilename }, i) => {
  const [name = "", ...companyParts] = attribution.split(", ");
  return {
    id: `partner-quote-${i + 1}`,
    quote,
    name,
    company: companyParts.join(", "),
    photoFilename,
  };
});
---

{
  items.length > 0 && (
    <ul class="voices" data-voices>
      {items.map(({ id, quote, name, company, photoFilename }) => (
        <li class="voice p-glass" data-voice>
          <div class="voice-photo">
            <PersonPhoto
              name={name}
              filename={photoFilename}
              widths={[320, 480, 640]}
              sizes="(min-width: 1100px) 18rem, (min-width: 768px) 30vw, 45vw"
            />
            <button
              type="button"
              class="voice-trigger"
              aria-expanded="false"
              aria-controls={id}
              data-voice-trigger
              hidden
            >
              <span class="u-visually-hidden">Quote from {name}</span>
              <span class="voice-badge" aria-hidden="true">
                &ldquo;
              </span>
            </button>
          </div>
          <div class="voice-caption">
            <p class="voice-name">{name}</p>
            {company && <p class="voice-company">{company}</p>}
          </div>
          <div class="voice-quote" id={id} data-voice-quote>
            <blockquote>
              <p>&ldquo;{quote}&rdquo;</p>
            </blockquote>
          </div>
        </li>
      ))}
    </ul>
  )
}

<script>
  import { initVoices } from "./testimonials.client";
  initVoices();
</script>

<style>
  /* PARTNER-1: the lower half of the partner page speaks in the home
     page's voice (partner-theme.css); depth is glass light, not a
     --shadow-* step (DEPTH-1). */
  .voices {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-md) var(--space-sm);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 768px) {
    .voices {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: var(--space-lg) var(--space-md);
    }
  }

  @media (min-width: 1100px) {
    .voices {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  .voice {
    display: flex;
    flex-direction: column;
    padding: var(--space-2xs);
  }

  /* A person without a photo (or a file that is missing locally) shows
     initials on a field of ice light instead of a grey box. */
  .voice-photo {
    --person-photo-ground: linear-gradient(
      170deg,
      color-mix(in srgb, var(--color-ticket-ice) 55%, var(--color-white)),
      color-mix(in srgb, var(--color-ticket-sky) 42%, var(--color-ticket-ice))
    );
    position: relative;
    aspect-ratio: 4 / 5;
    border-radius: var(--radius-ticket-panel);
  }

  /* The whole photo is the click target; the badge in its corner says it
     holds a quote. */
  .voice-trigger {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: flex-end;
    justify-content: flex-end;
    padding: var(--space-sm);
    background: none;
    border: 0;
    border-radius: inherit;
    cursor: pointer;
  }

  /* The white ring of the glass on the dark ground (PARTNER-1). */
  .voice-trigger:focus-visible {
    outline: 2px solid var(--color-white);
    outline-offset: 3px;
  }

  /* The home page's round clear glass (the speaker arrows' .h-glass-btn,
     restated here as PARTNER-1 asks): see-through, a bright rim, a soft
     blur of the photo behind it, no glow. */
  .voice-badge {
    position: relative;
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    padding-top: 0.4rem;
    color: var(--color-white);
    background: linear-gradient(
      180deg,
      color-mix(in srgb, var(--color-white) 18%, transparent),
      color-mix(in srgb, var(--color-white) 6%, transparent)
    );
    border-radius: var(--radius-circle);
    box-shadow:
      inset 0 1px 1px color-mix(in srgb, var(--color-white) 75%, transparent),
      inset 0 -1px 1px color-mix(in srgb, var(--color-white) 20%, transparent),
      inset 0 0 0 1px color-mix(in srgb, var(--color-white) 35%, transparent);
    -webkit-backdrop-filter: blur(10px) saturate(150%) brightness(0.8);
    backdrop-filter: blur(10px) saturate(150%) brightness(0.8);
    text-shadow: 0 1px 2px
      color-mix(in srgb, var(--color-black) 45%, transparent);
    font-size: var(--heading-h5-size);
    font-weight: var(--font-weight-extrabold);
    line-height: 1;
    transition: transform var(--duration-hover) var(--ease-snappy);
  }

  @media (hover: hover) {
    .voice-trigger:hover .voice-badge {
      transform: scale(1.08);
    }
  }

  .voice-trigger[aria-expanded="true"] .voice-badge {
    transform: scale(1.08);
  }

  .voice-caption {
    padding: var(--space-sm) var(--space-xs) var(--space-xs);
  }

  .voice-name {
    margin: 0;
    color: var(--color-white);
    font-size: var(--text-size-medium);
    font-weight: var(--font-weight-extrabold);
    letter-spacing: -0.01em;
    line-height: 1.25;
  }

  .voice-company {
    margin: 0.2rem 0 0;
    color: color-mix(in srgb, var(--color-ticket-ice) 82%, transparent);
    font-size: var(--text-size-small);
  }

  .voice-quote {
    padding: 0 var(--space-xs) var(--space-xs);
  }

  .voice-quote blockquote {
    margin: 0;
  }

  .voice-quote p {
    margin: 0;
    color: var(--color-white);
    font-size: var(--text-size-medium);
    font-weight: var(--font-weight-semibold);
    line-height: 1.45;
  }

  /* ---- Enhanced: the quote is a white speech bubble with navy type.
     It rises above the person's card, its tail pointing down at the
     photo; the script scrolls the page so it is in view. ---- */

  .voices[data-enhanced] .voice-quote {
    --bubble-lift: translateY(0.25rem) scale(0.96);
    position: absolute;
    bottom: calc(100% + var(--space-xs));
    left: 0;
    z-index: 2;
    width: min(22rem, calc(100vw - 2 * var(--space-md)));
    margin: 0;
    padding: var(--space-md);
    color: var(--color-navy);
    background-color: var(--color-white);
    border-radius: var(--radius-ticket-panel);
    box-shadow: 0 22px 44px -24px
      color-mix(in srgb, var(--color-black) 55%, transparent);
    transform-origin: 2.25rem bottom;
    transition:
      opacity var(--duration-open) var(--ease-snappy),
      transform var(--duration-open) var(--ease-snappy),
      display var(--duration-open) allow-discrete;
  }

  .voices[data-enhanced] .voice-quote[data-edge="end"] {
    right: 0;
    left: auto;
    transform-origin: calc(100% - 2.25rem) bottom;
  }

  .voices[data-enhanced] .voice-quote::before {
    content: "";
    position: absolute;
    bottom: calc(-1 * var(--space-2xs));
    left: 1.75rem;
    width: 1rem;
    height: 1rem;
    background-color: var(--color-white);
    border-radius: var(--radius-button);
    transform: rotate(45deg);
  }

  .voices[data-enhanced] .voice-quote[data-edge="end"]::before {
    right: 1.75rem;
    left: auto;
  }

  .voices[data-enhanced] .voice-quote p {
    color: inherit;
  }

  .voices[data-enhanced] .voice-quote[hidden] {
    display: none;
    opacity: 0;
    transform: var(--bubble-lift);
    transition-duration: var(--duration-close);
  }

  @starting-style {
    .voices[data-enhanced] .voice-quote:not([hidden]) {
      opacity: 0;
      transform: var(--bubble-lift);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .voice-badge,
    .voices[data-enhanced] .voice-quote {
      transition: none;
    }

    .voice-trigger:hover .voice-badge,
    .voice-trigger[aria-expanded="true"] .voice-badge {
      transform: none;
    }
  }
</style>
