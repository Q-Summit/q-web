---
// Envelope mail glyph (Material Symbols "mail", Apache 2.0), inlined as a
// build-time constant so there is no runtime or CDN dependency. Same
// construction as the other icons here: one fill=currentColor path on the
// 24 grid, aria-hidden because the parent link carries the accessible name.
const path =
  "M20 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4-8 5-8-5V6l8 5 8-5v2z";
---

<svg
  viewBox="0 0 24 24"
  fill="currentColor"
  aria-hidden="true"
  focusable="false"
>
  <path d={path}></path>
</svg>
