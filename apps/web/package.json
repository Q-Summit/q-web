{
  "name": "web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Q-Summit website: Astro static site (see ADR-0001).",
  "scripts": {
    "dev": "astro dev",
    "dev:cms": "CONTENT_SOURCE=cms CMS_URL=http://localhost:3000 PUBLIC_CMS_URL=http://localhost:3000 astro dev",
    "build": "astro build",
    "build:fixture": "CONTENT_SOURCE=json WEB_CONTENT_DIR=test/fixtures/ci-content astro build",
    "build:cms": "CONTENT_SOURCE=cms CMS_URL=http://localhost:3000 PUBLIC_CMS_URL=http://localhost:3000 astro build",
    "preview": "astro preview",
    "check": "astro check && tsc --noEmit -p worker/tsconfig.json && tsc --noEmit -p test/tsconfig.json && tsc --noEmit -p test/tsconfig.node.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.3",
    "@fontsource-variable/montserrat": "^5.2.0",
    "@payloadcms/live-preview": "3.86.0",
    "astro": "^7.0.0",
    "hls.js": "^1.6.16"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@astrojs/ts-plugin": "^1.10.10",
    "@cloudflare/vitest-pool-workers": "^0.18.6",
    "@types/node": "^22.18.0",
    "sharp": "^0.35.3",
    "simple-icons": "^16.26.0",
    "typescript": "^5.9.0",
    "vitest": "^4.1.10",
    "wrangler": "^4.112.0"
  }
}
