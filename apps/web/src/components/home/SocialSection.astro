---
// LinkedIn and Instagram on the home page (DESIGN.md HOME-1): one pane of
// glass with the copy in the middle, the LinkedIn mark at the left and the
// Instagram mark at the right, each a link to the profile from Site
// Settings, and a projection screen for posts below.
//
// The marks are glass objects like the glass Q of the page ground: each
// brand glyph rendered in 3D as thick clear glass from its official
// outline, with the Q's material and light (small WebPs with alpha under
// public/home/), each on a square of deep blue light so the clear glass
// reads. They stand upright; hover lifts one, a press pushes it in.
//
// The screen is where posts will be shown, under a cone of light: four
// frames laid out like the grid of an Instagram profile, portrait tiles
// with square corners and one even, narrow gap between them, and no frame
// or housing around the grid. The
// frames show the newest four posts, the newest at the far left
// (lib/social-posts.ts: editors add each new post at the end of
// home.social.posts, every older one moves a place right and the oldest
// drops out by itself). Frames without a post stay empty:
// decorative, hidden from assistive tech, no invented post, no feed
// script, no third-party request. A filled frame is a plain link with the
// post image served from our own media.
import type { HomeSocial } from "../../lib/content";
import { photoSrc } from "../../lib/media-filename";
import { HOME_POST_FRAMES, latestPosts } from "../../lib/social-posts";
import "./home-theme.css";

interface Props {
  social: HomeSocial;
  /** Profile URLs from Site Settings; a mark without a URL is not shown. */
  linkedinHref?: string;
  instagramHref?: string;
}

const { social, linkedinHref, instagramHref } = Astro.props;

const marks = [
  {
    key: "linkedin",
    href: linkedinHref,
    label: social.linkedinLabel,
    image: "/home/glass-linkedin.webp",
  },
  {
    key: "instagram",
    href: instagramHref,
    label: social.instagramLabel,
    image: "/home/glass-instagram.webp",
  },
] as const;
const [linkedin, instagram] = marks;

const posts = latestPosts(social.posts);
const frames = Array.from(
  { length: HOME_POST_FRAMES },
  (_, i) => posts[i] ?? null,
);
---

<section class="h-section h-social" aria-labelledby="home-social-title">
  <div class="h-shell">
    <div class="h-social-pane h-glass">
      <div class="h-social-top">
        {
          [linkedin, instagram].map(
            (mark) =>
              mark.href && (
                <a
                  class:list={["h-social-mark", `is-${mark.key}`]}
                  href={mark.href}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  <span class="h-social-object" data-glass-press>
                    <img
                      src={mark.image}
                      alt=""
                      width="512"
                      height="512"
                      loading="lazy"
                      decoding="async"
                    />
                  </span>
                  <span class="h-social-label">
                    {mark.label}
                    <span class="u-visually-hidden"> (opens in a new tab)</span>
                  </span>
                </a>
              ),
          )
        }
        <div class="h-social-copy">
          <p class="h-eyebrow" data-lp="social.eyebrow">{social.eyebrow}</p>
          <h2
            id="home-social-title"
            class="h-title"
            data-lp="social.heading"
            data-h-reveal
          >
            {social.heading}
          </h2>
          <p class="h-intro" data-lp="social.intro" data-h-reveal>
            {social.intro}
          </p>
        </div>
      </div>

      <div class="h-screen" aria-hidden={posts.length === 0}>
        <span class="h-screen-beam" aria-hidden="true"></span>
        <ul class="h-screen-surface">
          {
            frames.map((post) => (
              <li class="h-screen-frame">
                {post && (
                  <a
                    href={post.href}
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label={`${post.imageAlt || "Post"} on ${
                      post.platform === "linkedin" ? "LinkedIn" : "Instagram"
                    } (opens in a new tab)`}
                  >
                    <img
                      src={photoSrc(post.imageFile)}
                      alt=""
                      width="640"
                      height="800"
                      loading="lazy"
                      decoding="async"
                    />
                  </a>
                )}
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  /* DESIGN.md HOME-1 */
  .h-social-pane {
    padding: clamp(var(--space-md), 4vw, var(--space-xl));
  }

  /* LinkedIn, copy, Instagram: the copy is last in source order (the two
     marks are generated together) and placed in the middle column. */
  .h-social-top {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: var(--space-lg);
  }

  .h-social-mark.is-linkedin {
    grid-column: 1;
    grid-row: 1;
  }

  .h-social-copy {
    grid-column: 2;
    grid-row: 1;
    text-align: center;
  }

  .h-social-mark.is-instagram {
    grid-column: 3;
    grid-row: 1;
  }

  .h-social-copy .h-intro {
    margin-inline: auto;
  }

  /* A mark: the glass object and its label, one link. */
  .h-social-mark {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-sm);
    color: var(--color-navy);
    text-decoration: none;
    -webkit-tap-highlight-color: transparent;
  }

  /*
   * The glass object: a 3D render of the glyph, upright, on a square of
   * deep blue light, as glass marks are usually shown: clear glass needs
   * a saturated ground to read, and the pale page gives it none. The
   * square glows a little at its middle, where the glass sits, and has
   * the same hairline rim as the panes.
   */
  .h-social-object {
    position: relative;
    display: grid;
    place-items: center;
    width: clamp(6.5rem, 12vw, 9rem);
    aspect-ratio: 1;
    border-radius: var(--radius-ticket-tile);
    background:
      radial-gradient(
        70% 70% at 50% 46%,
        color-mix(in srgb, var(--color-ticket-sky) 90%, transparent),
        transparent 75%
      ),
      linear-gradient(
        150deg,
        var(--color-ticket-deep),
        var(--color-navy) 55%,
        var(--color-ticket-midnight)
      );
    box-shadow:
      inset 0 0 0 1px color-mix(in srgb, var(--color-white) 30%, transparent),
      inset 0 1px 1px color-mix(in srgb, var(--color-white) 60%, transparent),
      0 18px 28px -18px color-mix(in srgb, var(--color-navy) 70%, transparent),
      0 0 26px -10px
        color-mix(in srgb, var(--color-ticket-cyan) 60%, transparent);
    transition: transform var(--duration-glass-release) var(--ease-glass-spring);
  }

  .h-social-object img {
    display: block;
    width: 86%;
    height: 86%;
  }

  .h-social-label {
    font-size: var(--text-size-tiny);
    font-weight: var(--font-weight-extrabold);
    letter-spacing: 0.1em;
    text-align: center;
    text-transform: uppercase;
  }

  @media (hover: hover) {
    .h-social-mark:hover .h-social-object {
      transform: translateY(-5px) scale(1.05);
    }
  }

  .h-social-mark:focus-visible {
    outline: 2px solid var(--color-navy);
    outline-offset: 6px;
    border-radius: var(--radius-ticket-panel);
  }

  .h-social-mark:active .h-social-object,
  .h-social-object.is-pressed {
    transform: scale(0.94);
    transition-duration: var(--duration-glass-press);
  }

  /*
   * The post grid, lit from above its middle. The frames are the tiles of
   * a profile grid.
   */
  .h-screen {
    --h-post-gap: 0.25rem;

    position: relative;
    margin-top: clamp(var(--space-lg), 5vw, var(--space-xl));
    padding-top: var(--space-md);
  }

  /* The cone of light falling onto the screen. */
  .h-screen-beam {
    position: absolute;
    top: calc(-1 * var(--space-lg));
    left: 0;
    right: 0;
    height: calc(var(--space-lg) + var(--space-md) + 40%);
    background: linear-gradient(
      180deg,
      color-mix(in srgb, var(--color-white) 70%, transparent),
      color-mix(in srgb, var(--color-white) 14%, transparent) 60%,
      transparent
    );
    clip-path: polygon(47% 0, 53% 0, 100% 100%, 0 100%);
    pointer-events: none;
  }

  .h-screen-surface {
    position: relative;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    /* A profile grid: the same narrow gap between all tiles, nothing
       around them (no bar above, no bar below, no rounded housing), so
       the pane shows through the gaps. */
    gap: var(--h-post-gap);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* One tile of the grid: an empty, evenly lit field of the screen until
     a post fills it. */
  .h-screen-frame {
    /* The portrait format of a profile grid. */
    aspect-ratio: 4 / 5;
    background:
      radial-gradient(120% 90% at 50% 0%, var(--color-white), transparent 80%),
      color-mix(in srgb, var(--color-white) 78%, var(--color-ticket-ice));
  }

  .h-screen-frame a,
  .h-screen-frame img {
    display: block;
    width: 100%;
    height: 100%;
  }

  .h-screen-frame img {
    object-fit: cover;
  }

  @media (max-width: 767px) {
    .h-social-top {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-md) var(--space-sm);
    }

    .h-social-copy {
      grid-column: 1 / -1;
      grid-row: 1;
    }

    .h-social-mark.is-linkedin {
      grid-column: 1;
      grid-row: 2;
    }

    .h-social-mark.is-instagram {
      grid-column: 2;
      grid-row: 2;
    }

    .h-screen-surface {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .h-social-object {
      transition: none;
    }

    .h-social-mark:hover .h-social-object,
    .h-social-mark:active .h-social-object,
    .h-social-object.is-pressed {
      transform: none;
    }
  }
</style>
