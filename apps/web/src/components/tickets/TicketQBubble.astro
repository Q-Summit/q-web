---
// A Q bubble (DESIGN.md TICKETS-1): the original Q mark as a liquid glass
// object. The outline is the brand file itself (public/icon-512.png, whose
// counter is transparent) used as a mask, so the drawing is never redrawn.
// Inside it, light flows; two crescents cut from the same mask, offset by a
// pixel or two, light its rim top left and make it glow bottom right; a
// soft halo sits behind. The Q itself only floats, turns a few degrees and
// breathes evenly: it is never stretched or skewed. Decorative, aria-hidden.
// Placement and size come from the caller's modifier class in
// ticket-theme.css (is-card, is-card-sm, is-summary, is-ground-1..3).
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<span class:list={["t-qb", className]} aria-hidden="true">
  <span class="t-qb-halo"></span>
  <span class="t-qb-glass"><span class="t-qb-flow"></span></span>
  <span class="t-qb-rim is-light"></span>
  <span class="t-qb-rim is-glow"></span>
</span>
