node_modules/

# Secrets and per-environment config. Never commit credentials.
# Committed examples document required variables; filled sheets stay local.
.env
.env.*
!.env.example
!.env.remote.example
!.env.vercel.example
!.env.workers.example
.dev.vars
.dev.vars.*

# Build and framework output.
dist/
.astro/

# Visual regression (VRT) transient output. The committed baselines under
# apps/web/tests/visual/__screenshots__/ are the tracked source of truth and
# are NOT ignored; everything a run produces is.
apps/web/dist-vrt/
apps/web/playwright-report/
apps/web/test-results/
apps/web/vrt-results.json
# Scratch files a VRT run writes to the repo root (comment body + AUTO baseline
# manifests); consumed by the workflow, never committed.
/vrt-comment.md
/vrt-wrote-baselines.txt
/vrt-deleted-baselines.txt
# pnpm's content-addressable store. The vrt:docker scripts point it inside the
# gitignored node_modules; this catches any stray in-repo store (e.g. an old
# docker run) so a 1 GB cache can never be staged.
.pnpm-store/

# Media binaries never live in git. Local copies seed CMS / CF preview;
# production serves the same keys from R2 via the Worker `/media/*` route.
# Content packages carry filenames only; agents propose drafts against CMS.
apps/web/public/media/
apps/web/src/assets/media/*
!apps/web/src/assets/media/*.ts

# Local CMS uploads (development only; production media lives in R2).
apps/cms/media/
.next/
.vercel/
.wrangler/

# Local database dumps written by scripts/ops/mirror-db.mjs (Neon mirror,
# humans only): real production content (speaker/team/contact PII). Never
# commit these.
scripts/backups/

# Chrome-for-Testing (ensure-chrome / lighthouse). Report *outputs* are
# local-only; the folder keeps a committed README + AGENT.example.md so
# agents know the contract without a prior lighthouse run.
.browsers/
.lighthouse/*
!.lighthouse/README.md
!.lighthouse/AGENT.example.md

# Content package transfer artifacts (make package / make pull). Keep the
# committed examples/ tree; never commit live exports with prod media/PII.
scripts/content-packages/*
!scripts/content-packages/examples/
!scripts/content-packages/examples/**

# Local, per-machine state. Never commit personal tool settings.
# .vscode/extensions.json (shared recommendations) is the one exception.
.vscode/*
!.vscode/extensions.json
.claude/settings.local.json
# Agent worktrees: a second checkout of this repo, created per task and thrown
# away. Its contents belong to that branch, never to this one.
.claude/worktrees/
.DS_Store
Thumbs.db

# Emergency-restored content snapshot (go-live.md); real content never ships in git.
apps/web/content/
