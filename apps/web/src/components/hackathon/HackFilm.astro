<script>
  // Gallery and zoom for HackFilm (see the component comment). Geometry is
  // measured, not guessed; images are chosen by the size they will really
  // be shown at; scroll only drives the intro.
  interface GalleryData {
    widths: number[];
    photos: { urls: string[]; caption: string; alt: string }[];
  }

  const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
  const ease = (x: number) => x * x * (3 - 2 * x);
  const clamp01 = (x: number) => Math.min(1, Math.max(0, x));
  const mod = (a: number, n: number) => ((a % n) + n) % n;

  for (const film of document.querySelectorAll<HTMLElement>(
    "[data-hack-film]",
  )) {
    const track = film.querySelector<HTMLElement>(".film-track");
    const stage = film.querySelector<HTMLElement>(".film-stage");
    const laptop = film.querySelector<HTMLElement>("[data-film-laptop]");
    const screen = film.querySelector<HTMLElement>("[data-film-screen]");
    const view = film.querySelector<HTMLElement>("[data-film-view]");
    const space = film.querySelector<HTMLElement>(".band-space");
    const band = film.querySelector<HTMLElement>("[data-film-band]");
    const controls = film.querySelector<HTMLElement>("[data-film-controls]");
    const status = film.querySelector<HTMLElement>("[data-film-status]");
    if (!track || !stage || !laptop || !screen || !view || !space || !band) {
      continue;
    }

    const data = JSON.parse(view.dataset.gallery ?? "{}") as GalleryData;
    const slots = [...band.querySelectorAll<HTMLElement>("[data-slot]")];
    const dots = [
      ...film.querySelectorAll<HTMLButtonElement>("[data-film-dot]"),
    ];
    const N = slots.length;
    const P = data.photos.length;
    const S = Number(getComputedStyle(view).getPropertyValue("--facets")) || 1;
    if (!N || !P) continue;

    // Enhance: the band takes over the display (the still photo and the
    // grid sit in <noscript>, so they were never fetched).
    film.setAttribute("data-enhanced", "");
    view.hidden = false;
    if (controls) controls.hidden = false;

    const narrow = () => window.innerWidth < 768;
    const motion = () => !reduceMotion.matches;
    let active = 0;
    let zoomScale = 1;
    let fwCss = 0;

    // ---- Band geometry, in band space (K times the visible size, see the
    // component comment): frame width, cylinder radius, perspective. The
    // facets of all frames close the cylinder edge to edge.
    const layoutBand = () => {
      // A little above 1:1, which keeps the bend from softening the photo.
      const k = Math.min(
        4,
        Math.max(1, zoomScale * (window.devicePixelRatio || 1) * 1.15),
      );
      fwCss = view.clientWidth * (narrow() ? 0.72 : 0.44);
      const fw = fwCss * k;
      const fh = fw * (2 / 3) + fw * 0.15;
      const r = fw / S / (2 * Math.sin(Math.PI / (N * S)));
      view.style.setProperty("--fw-css", `${fwCss.toFixed(1)}px`);
      view.style.setProperty("--fh-css", `${(fh / k).toFixed(1)}px`);
      space.style.setProperty("--k", k.toFixed(3));
      space.style.setProperty("--fw", `${fw.toFixed(1)}px`);
      space.style.setProperty("--fh", `${fh.toFixed(1)}px`);
      space.style.setProperty("--r", `${r.toFixed(1)}px`);
      space.style.setProperty(
        "--perspective",
        `${(r * (narrow() ? 3.6 : 2.4)).toFixed(0)}px`,
      );
    };

    // ---- Images: the width each frame will really be shown at.
    const loadedWidth = new Map<number, number>();
    // The active photo never shows a file smaller than its pixel size in
    // the large view; neighbors may be a little smaller (they turn away).
    const pick = (needPx: number, slack = 1) =>
      data.widths.find((w) => w >= needPx * slack) ??
      data.widths[data.widths.length - 1];
    const needFor = (factor: number) =>
      (fwCss || 300) * zoomScale * (window.devicePixelRatio || 1) * factor;
    const ensure = (photo: number, width: number) => {
      if ((loadedWidth.get(photo) ?? 0) >= width) return;
      loadedWidth.set(photo, width);
      const url = data.photos[photo].urls[data.widths.indexOf(width)];
      for (const slot of slots) {
        if (Number(slot.dataset.slot) % P !== photo) continue;
        // One image per facet, all the same file (fetched and decoded once).
        for (const img of slot.querySelectorAll("img")) {
          img.addEventListener("load", () => img.classList.add("is-loaded"), {
            once: true,
          });
          img.src = url;
        }
      }
    };
    let primed = false;
    const loadAround = () => {
      if (!primed) return;
      const photoAt = (k: number) => mod(k, N) % P;
      ensure(photoAt(active), pick(needFor(1)));
      ensure(photoAt(active - 1), pick(needFor(0.75), 0.85));
      ensure(photoAt(active + 1), pick(needFor(0.75), 0.85));
      // The outer frames are visible but small and angled: smallest width.
      ensure(photoAt(active - 2), data.widths[0]);
      ensure(photoAt(active + 2), data.widths[0]);
    };

    // ---- Selection.
    const select = (k: number, announce = true) => {
      active = k;
      band.style.setProperty("--active", String(k));
      for (const slot of slots) {
        slot.classList.toggle(
          "is-active",
          mod(Number(slot.dataset.slot) - k, N) === 0,
        );
      }
      const photo = mod(k, N) % P;
      dots.forEach((dot, i) =>
        dot.setAttribute("aria-current", String(i === photo)),
      );
      if (announce && status) {
        const p = data.photos[photo];
        status.textContent = `Photo ${photo + 1} of ${P}: ${p.caption}. ${p.alt}`;
      }
      loadAround();
    };
    const step = (delta: number) => select(active + delta);
    const toPhoto = (photo: number) => {
      // The nearest slot that shows this photo, the short way round.
      let best = active;
      let bestDist = Infinity;
      for (let delta = -N + 1; delta < N; delta++) {
        if (mod(active + delta, N) % P !== photo) continue;
        if (Math.abs(delta) < bestDist) {
          bestDist = Math.abs(delta);
          best = active + delta;
        }
      }
      select(best);
    };

    film
      .querySelector("[data-film-prev]")
      ?.addEventListener("click", () => step(-1));
    film
      .querySelector("[data-film-next]")
      ?.addEventListener("click", () => step(1));
    dots.forEach((dot) =>
      dot.addEventListener("click", () => toPhoto(Number(dot.dataset.filmDot))),
    );

    view.addEventListener("keydown", (event) => {
      const keys: Record<string, () => void> = {
        ArrowLeft: () => step(-1),
        ArrowRight: () => step(1),
        Home: () => toPhoto(0),
        End: () => toPhoto(P - 1),
      };
      const run = keys[event.key];
      if (run) {
        event.preventDefault();
        run();
      }
    });

    // Tap or click a frame; a horizontal swipe switches. Vertical moves stay
    // with the browser (touch-action: pan-y), so page scrolling is free.
    let down: { x: number; y: number } | null = null;
    let swiped = false;
    view.addEventListener("pointerdown", (event) => {
      down = { x: event.clientX, y: event.clientY };
      swiped = false;
    });
    view.addEventListener("pointerup", (event) => {
      if (!down) return;
      const dx = event.clientX - down.x;
      const dy = event.clientY - down.y;
      down = null;
      if (Math.abs(dx) > 40 && Math.abs(dx) > Math.abs(dy) * 1.3) {
        swiped = true;
        step(dx < 0 ? 1 : -1);
      }
    });
    view.addEventListener("pointercancel", () => {
      down = null;
    });
    // The frame under a click, from the band geometry: each frame's
    // projected center across the view (cylinder radius and lens in band
    // space, divided by K); the nearest one facing the viewer wins.
    const frameAt = (clientX: number) => {
      const rect = view.getBoundingClientRect();
      const visual = rect.width / Math.max(view.clientWidth, 1);
      const x = (clientX - rect.left) / visual - view.clientWidth / 2;
      const k = parseFloat(space.style.getPropertyValue("--k")) || 1;
      const r = (parseFloat(space.style.getPropertyValue("--r")) || 0) / k;
      const lens =
        (parseFloat(space.style.getPropertyValue("--perspective")) || 1) / k;
      const zi = parseFloat(view.style.getPropertyValue("--zi")) || 1;
      const intro = ((1 - zi) * (narrow() ? 10 : 14) * Math.PI) / 180;
      let best = 0;
      let bestGap = Infinity;
      for (let d = -Math.floor(N / 2); d <= Math.floor(N / 2); d++) {
        const angle = (d * 2 * Math.PI) / N + intro;
        if (Math.cos(angle) < 0.15) continue;
        const depth = r * (Math.cos(angle) - 1);
        const center = (r * Math.sin(angle) * lens) / (lens - depth);
        const gap = Math.abs(center - x);
        if (gap < bestGap) {
          bestGap = gap;
          best = d;
        }
      }
      return best;
    };

    view.addEventListener("click", (event) => {
      if (swiped) {
        swiped = false;
        return;
      }
      const delta = frameAt(event.clientX);
      if (delta !== 0) select(active + delta);
    });

    // ---- Zoom into the display.
    // Phones (flow mode): the laptop's own geometry at rest, relative to
    // the stage top, so the zoom can wait until the whole laptop is in view.
    const flow = { center: 0, bottom: 0 };
    const measure = () => {
      film.style.setProperty("--z", "0");
      const s = stage.getBoundingClientRect();
      const l = laptop.getBoundingClientRect();
      const sc = screen.getBoundingClientRect();
      const pinned = film.dataset.zoom === "pinned";
      const scale = pinned
        ? Math.min(s.width / sc.width, s.height / sc.height)
        : Math.min(s.width / sc.width, 1.18);
      zoomScale = scale;
      film.style.setProperty("--ox", `${sc.left + sc.width / 2 - l.left}px`);
      film.style.setProperty("--oy", `${sc.top + sc.height / 2 - l.top}px`);
      film.style.setProperty(
        "--dx",
        pinned ? `${s.left + s.width / 2 - (sc.left + sc.width / 2)}px` : "0px",
      );
      film.style.setProperty(
        "--dy",
        pinned ? `${s.top + s.height / 2 - (sc.top + sc.height / 2)}px` : "0px",
      );
      film.style.setProperty("--s", scale.toFixed(4));
      flow.center = sc.top + sc.height / 2 - s.top;
      flow.bottom = l.bottom - s.top;
    };

    const applyZ = (z: number) => {
      film.style.setProperty("--z", z.toFixed(4));
      view.style.setProperty("--zi", (motion() ? z : 1).toFixed(4));
    };

    let frame = 0;
    const update = () => {
      frame = 0;
      if (!motion()) return;
      if (film.dataset.zoom === "pinned") {
        const rect = track.getBoundingClientRect();
        const pinTop = parseFloat(getComputedStyle(stage).top) || 0;
        const range = Math.max(1, rect.height - stage.offsetHeight);
        applyZ(ease(clamp01((pinTop - rect.top) / range / 0.8)));
      } else {
        // Phones: no pinning, three stretches of plain scrolling. The whole
        // laptop first comes into the usable view (below the fixed header,
        // above the browser bars: the visual viewport), stays whole for a
        // short stretch with the band in its display, then the zoom runs
        // and ends with the gallery a little above the middle. Positions
        // are the display's center, from the stage (never transformed).
        const view0 =
          document.getElementById("site-header")?.getBoundingClientRect()
            .bottom ?? 0;
        const view1 = window.visualViewport?.height ?? window.innerHeight;
        const usable = Math.max(1, view1 - Math.max(0, view0));
        const center = stage.getBoundingClientRect().top + flow.center;
        // Display center when the laptop's bottom edge is just in view.
        const whole = view1 - 16 - (flow.bottom - flow.center);
        const end = Math.max(0, view0) + usable * 0.36;
        const minZoom = usable * 0.25;
        const hold = Math.min(
          usable * 0.14,
          Math.max(0, whole - end - minZoom),
        );
        const start = whole - hold;
        const stop = Math.min(end, start - minZoom);
        applyZ(ease(clamp01((start - center) / (start - stop))));
      }
    };
    const schedule = () => {
      if (!frame) frame = requestAnimationFrame(update);
    };

    const setup = () => {
      if (motion()) {
        film.dataset.zoom = narrow() ? "flow" : "pinned";
      } else {
        delete film.dataset.zoom;
      }
      // Measure first: the band space scale depends on the zoom.
      measure();
      layoutBand();
      if (motion()) {
        update();
      } else {
        // Still layouts: the laptop at rest on wide screens; on phones the
        // display already fills the width, so photos are large enough.
        applyZ(narrow() ? 1 : 0);
      }
      loadAround();
    };

    let listening = false;
    new IntersectionObserver(
      (entries) => {
        const near = entries.some((entry) => entry.isIntersecting);
        if (near && !primed) {
          primed = true;
          loadAround();
        }
        if (near && !listening) {
          window.addEventListener("scroll", schedule, { passive: true });
          listening = true;
        } else if (!near && listening) {
          window.removeEventListener("scroll", schedule);
          listening = false;
        }
        schedule();
      },
      { rootMargin: "800px 0px 800px 0px" },
    ).observe(film);

    window.addEventListener("resize", setup);
    window.addEventListener("load", setup, { once: true });
    reduceMotion.addEventListener("change", setup);
    select(0, false);
    setup();
  }
</script>
