---
// /speaker: the 2027 speaker page (DESIGN.md SPEAKER-1), on the deep night
// from the site header down to the footer. In order: the hot topics of the
// next edition (hot-topics list), the intro (page-speaker heading and intro),
// the speakers on the main stage (speakers list), and the pill announcing
// the next line-up. Until that line-up is out the stage shows the homepage's
// speakers; STAGE_SOURCE and STAGE_EDITION in lib/speaker-page.ts switch it
// to the edition (shared with the LLM corpus in lib/llms.ts).
import Base from "../layouts/Base.astro";
import { getHotTopics, getPageContent, getSpeakers } from "../lib/content";
import { isFixtureMediaSentinel } from "../lib/media-filename";
import {
  speakerPageCopy,
  isStageShot,
  stageEdition,
  stageLabel,
  stagePhotoFilename,
  stageRole,
  stageSpeakers,
} from "../lib/speaker-page";
import HotTopics from "../components/speaker/HotTopics.astro";
import SpeakerStage from "../components/speaker/SpeakerStage.astro";
import type { StageSpeaker } from "../components/speaker/SpeakerStage.astro";

/** Placeholder speakers while the list is still empty, in `astro dev` only. */
const DEV_PLACEHOLDERS = 20;

const [{ speaker: page, home }, speakers, topics] = await Promise.all([
  getPageContent(),
  getSpeakers(),
  getHotTopics(),
]);

const photoUrl = (filename: string) =>
  filename && !isFixtureMediaSentinel(filename)
    ? `/media/${filename}`
    : undefined;

const edition = stageEdition();
let stage: StageSpeaker[] = stageSpeakers(home.previousSpeakers, speakers).map(
  (s) => {
    const photo = photoUrl(stagePhotoFilename(s));
    return {
      name: s.name,
      role: stageRole(s),
      ...(s.talkTitle ? { talkTitle: s.talkTitle } : {}),
      ...(s.quote ? { quote: s.quote } : {}),
      ...(photo ? { photo, photoLook: isStageShot(s) } : {}),
    };
  },
);

// Until the real line-up is in the CMS, `astro dev` fills the stage with
// numbered placeholders so layout and navigation can be tested. A build
// never ships them: an empty list leaves the stage out.
if (stage.length === 0 && import.meta.env.DEV) {
  stage = Array.from({ length: DEV_PLACEHOLDERS }, (_, i) => {
    const n = String(i + 1).padStart(2, "0");
    return {
      name: `Speaker Name ${n}`,
      role: "CEO · Company",
      talkTitle: "Talk title placeholder",
      quote: "A short quote from the talk goes here.",
    };
  });
}

// Editable in the CMS (page-speaker); empty fields keep the built-in wording.
const copy = speakerPageCopy(page);
---

<Base
  title={page.title}
  description={page.metaDescription}
  livePreviewGlobal="page-speaker"
>
  <div class="sp-page">
    {
      topics.length > 0 && (
        <HotTopics
          topics={topics}
          label={copy.hotTopicsLabel}
          heading={copy.hotTopicsHeading}
          intro={copy.hotTopicsIntro}
        />
      )
    }

    <header class="sp-intro">
      <p class="sp-label">{stageLabel()}</p>
      <h1 class="sp-title" data-lp="heading">{page.heading}</h1>
      <p class="sp-lead" data-lp="intro">{page.intro}</p>
    </header>

    <SpeakerStage speakers={stage} edition={edition} />

    <p class="sp-pill" data-lp="lineupPill">{copy.lineupPill}</p>
  </div>
</Base>

<style>
  /* DESIGN.md SPEAKER-1: the page shell skips .section/.container
     (LAYOUT-1, LAYOUT-3), stands on the speaker night instead of
     .section.is-dark (COLOR-2) and pulls itself up under the fixed site
     header, so the page is dark from its first pixel. */
  .sp-page {
    margin-top: calc(var(--site-header-height) * -1);
    padding-top: var(--site-header-height);
    background: var(--color-speaker-night);
    color: var(--color-white);
  }

  /* The page melts into the footer's white through the long fade of the
     other 2027 pages (home-theme.css .h-page-fade, partner-theme.css
     .p-ground::after, restated here): its lightness rises along one
     smoothstep curve in OKLab, first the deep blue growing out of the
     night, then a mid blue and a pale sky into the white. Its length
     follows the window's height, so the page never ends on an edge. */
  .sp-page::after {
    --fade-blue: color-mix(
      in oklab,
      var(--color-ticket-sky) 50%,
      var(--color-ticket-deep)
    );
    --fade-pale: color-mix(
      in oklab,
      var(--color-ticket-sky) 42%,
      var(--color-ticket-ice)
    );

    content: "";
    display: block;
    height: clamp(22rem, 58vh, 46rem);
    margin-top: clamp(var(--space-md), 4vw, var(--space-xl));
    background: linear-gradient(
      in oklab 180deg,
      transparent 0%,
      color-mix(in oklab, var(--color-ticket-deep) 3%, transparent) 5%,
      color-mix(in oklab, var(--color-ticket-deep) 13%, transparent) 10%,
      color-mix(in oklab, var(--color-ticket-deep) 29%, transparent) 15%,
      color-mix(in oklab, var(--color-ticket-deep) 49%, transparent) 20%,
      color-mix(in oklab, var(--color-ticket-deep) 73%, transparent) 25%,
      color-mix(in oklab, var(--fade-blue) 2%, var(--color-ticket-deep)) 30%,
      color-mix(in oklab, var(--fade-blue) 46%, var(--color-ticket-deep)) 35%,
      color-mix(in oklab, var(--fade-blue) 94%, var(--color-ticket-deep)) 40%,
      color-mix(in oklab, var(--fade-pale) 18%, var(--fade-blue)) 45%,
      color-mix(in oklab, var(--fade-pale) 38%, var(--fade-blue)) 50%,
      color-mix(in oklab, var(--fade-pale) 59%, var(--fade-blue)) 55%,
      color-mix(in oklab, var(--fade-pale) 79%, var(--fade-blue)) 60%,
      color-mix(in oklab, var(--fade-pale) 98%, var(--fade-blue)) 65%,
      color-mix(in oklab, var(--color-ticket-ice) 38%, var(--fade-pale)) 70%,
      color-mix(in oklab, var(--color-ticket-ice) 76%, var(--fade-pale)) 75%,
      color-mix(in oklab, var(--color-white) 12%, var(--color-ticket-ice)) 80%,
      color-mix(in oklab, var(--color-white) 49%, var(--color-ticket-ice)) 85%,
      color-mix(in oklab, var(--color-white) 76%, var(--color-ticket-ice)) 90%,
      color-mix(in oklab, var(--color-white) 94%, var(--color-ticket-ice)) 95%,
      var(--color-white) 100%
    );
    pointer-events: none;
  }

  /* The fade reaches the footer's white, so the footer drops its hairline
     on this page only, as on the home, ticket and partner pages. */
  :global(body:has(.sp-page) .site-footer) {
    border-top-color: transparent;
  }

  :global(body:has(.sp-page)) {
    background: var(--color-speaker-night);
  }

  .sp-intro {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-xs);
    max-width: 48rem;
    margin: 0 auto;
    padding: clamp(var(--space-xl), 6vw, 5rem) var(--padding-global)
      var(--space-md);
    text-align: center;
  }

  .sp-label {
    margin: 0;
    color: var(--color-ticket-ice);
    font-size: var(--text-size-small);
    font-weight: var(--font-weight-extrabold);
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .sp-title {
    margin: 0;
    color: var(--color-white);
    font-size: clamp(2.25rem, 5.5vw, 4rem);
    font-weight: var(--font-weight-extrabold);
    letter-spacing: -0.03em;
    line-height: 1.05;
    text-wrap: balance;
  }

  .sp-lead {
    margin: 0;
    color: color-mix(in srgb, var(--color-white) 78%, transparent);
    font-size: var(--text-size-medium);
    line-height: 1.6;
  }

  .sp-pill {
    width: fit-content;
    margin: clamp(var(--space-md), 4vw, var(--space-xl)) auto 0;
    padding: var(--space-2xs) var(--space-md);
    border: 1px solid
      color-mix(in srgb, var(--color-ticket-ice) 45%, transparent);
    border-radius: var(--radius-pill);
    background: color-mix(in srgb, var(--color-navy) 45%, transparent);
    color: var(--color-ticket-ice);
    font-size: var(--text-size-small);
    font-weight: var(--font-weight-extrabold);
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }
</style>
