---
// Choosing a ticket (DESIGN.md TICKETS-1): the page's one ticket picker.
// At the left, the five tickets as a vertical list (a tab list, like the
// homepage's "Why Q?" rows): each row its name, who it is for, the regular
// price struck through and the price on sale now, the row picked marked
// in ice on a lens of glass with an arrow. At the right, exactly one
// ticket card, the one picked: printed light (white with soft icy blue
// light and the pass's fine grain under the type), its name, price, the
// day the sale price ends, its requirement, the buy button in icy liquid
// glass and every benefit with its status. Every price and status comes
// from ticket-model, the same functions the compare view uses; every buy
// button opens the one shop URL from the content.
//
// Progressive enhancement: the static HTML shows the list and all five
// cards one under another, so without JavaScript every ticket is readable
// and buyable. tickets.client.ts turns the list into tabs (click, arrow
// keys, Home, End) and shows one card at a time; the cards then share one
// cell, as tall as the tallest, so switching never moves the page.
import "./ticket-theme.css";
import type { TicketCategoriesContent } from "../../lib/content";
import { EVENTS } from "../../lib/analytics/events";
import IconArrowRight from "../icons/IconArrowRight.astro";
import TicketStatus from "./TicketStatus.astro";
import {
  euro,
  fillLabel,
  isDiscounted,
  isPositive,
  savings,
  statusLabel,
  statusOf,
} from "./ticket-model";

interface Props {
  offer: TicketCategoriesContent["offer"];
  included: TicketCategoriesContent["included"];
  phases?: TicketCategoriesContent["phases"];
  /** Screen-reader name of the sale price, from the active phase. */
  priceLabel?: string;
}

const {
  offer,
  included,
  phases,
  priceLabel = "Early Bird price",
} = Astro.props;
const first = offer.tickets[0]?.key;
// Running row index across groups, for the staggered entrance (--i).
const rowStart = included.groups.map((_, gi) =>
  included.groups.slice(0, gi).reduce((n, g) => n + g.rows.length, 0),
);
// The phase on sale names the sale price column and, with its end in the
// content, the day it ends ("Early Bird until 22.11.", German time).
const active = phases?.items.find((item) => item.key === phases.activeKey);
const saleName = active?.label ?? "Now";
const until =
  active?.endsAt && !Number.isNaN(Date.parse(active.endsAt))
    ? new Intl.DateTimeFormat("de-DE", {
        day: "2-digit",
        month: "2-digit",
        timeZone: "Europe/Berlin",
      }).format(new Date(active.endsAt))
    : undefined;
const saleNote = active
  ? `${active.label}${until ? ` until ${until}` : ""}`
  : undefined;
// With no ticket below its regular price (between two phases), the list
// has one price column and no struck prices.
const anyDiscount = offer.tickets.some(isDiscounted);
---

<section
  class="t-included t-anchor"
  id="included"
  aria-labelledby="included-title"
  data-ticket-included
>
  <div class="t-shell">
    <div class="t-included-head">
      <h2
        id="included-title"
        class="t-section-title"
        data-lp="included.heading"
      >
        {included.heading}
      </h2>
      <p class="t-section-intro" data-lp="included.intro">
        {included.intro}
      </p>
    </div>

    <div class="t-pick">
      <div class:list={["t-choices", { "is-single-price": !anyDiscount }]}>
        <div class="t-choice-cols" aria-hidden="true">
          <span>Ticket</span>
          {anyDiscount && <span>Regular</span>}
          <span>{anyDiscount ? saleName : "Price"}</span>
        </div>
        <div
          class="t-choice-list"
          role="tablist"
          aria-orientation="vertical"
          aria-label={included.heading}
          data-tablist
        >
          <span class="t-tab-lens" aria-hidden="true" data-tab-lens></span>
          {
            offer.tickets.map((ticket) => (
              <button
                type="button"
                class="t-choice"
                role="tab"
                id={`tab-${ticket.key}`}
                aria-controls={`included-${ticket.key}`}
                aria-selected={ticket.key === first ? "true" : "false"}
                tabindex={ticket.key === first ? 0 : -1}
                data-tab={ticket.key}
              >
                <span class="t-choice-text">
                  <span class="t-choice-name">{ticket.name}</span>
                  <span class="t-choice-desc">{ticket.description}</span>
                </span>
                {anyDiscount && (
                  <span class="t-choice-was">
                    {isDiscounted(ticket) && (
                      <>
                        <span class="u-visually-hidden">Regular price </span>
                        <s>{euro(ticket.regularPrice)}</s>
                      </>
                    )}
                  </span>
                )}
                <span class="t-choice-now">
                  <span class="u-visually-hidden">{priceLabel} </span>
                  {euro(ticket.price)}
                </span>
                <svg
                  class="t-choice-arrow"
                  viewBox="0 0 24 24"
                  aria-hidden="true"
                  focusable="false"
                >
                  <path
                    d="M9 5l7 7-7 7"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.4"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
              </button>
            ))
          }
        </div>
        {
          offer.footnote && (
            <p class="t-choice-foot" data-lp="offer.footnote">
              {offer.footnote}
            </p>
          )
        }
      </div>

      <div class="t-panels" data-ticket-motion>
        {
          offer.tickets.map((ticket) => {
            const saved = savings(ticket);
            return (
              <div
                class="t-panel t-anchor"
                id={`included-${ticket.key}`}
                role="tabpanel"
                aria-labelledby={`tab-${ticket.key}`}
                tabindex="0"
                data-panel={ticket.key}
              >
                <article class="t-detail t-light" aria-label={ticket.name}>
                  <div class="t-detail-top">
                    <div class="t-detail-id">
                      <h3 class="t-detail-name">{ticket.name}</h3>
                      <p class="t-detail-desc">{ticket.description}</p>
                    </div>
                    <div class="t-detail-price">
                      <p class="t-detail-now">
                        <span class="u-visually-hidden">{priceLabel} </span>
                        {euro(ticket.price)}
                      </p>
                      {saved > 0 && (
                        <p class="t-detail-was">
                          {saleNote && <span>{saleNote}</span>}
                          <span>
                            <span class="u-visually-hidden">
                              Regular price{" "}
                            </span>
                            <s>{euro(ticket.regularPrice)}</s>
                          </span>
                          <span class="t-detail-save">
                            {offer.saveLabel} {euro(saved)}
                          </span>
                        </p>
                      )}
                    </div>
                  </div>
                  <p
                    class:list={["t-detail-note", { "is-empty": !ticket.note }]}
                    aria-hidden={ticket.note ? undefined : "true"}
                  >
                    {ticket.note ?? " "}
                  </p>
                  <a
                    class="t-btn h-ice is-block t-detail-buy"
                    href={offer.purchaseHref}
                    target="_blank"
                    rel="noopener noreferrer"
                    data-ticket-buy
                    data-ph-event={EVENTS.ticket_purchase_initiated}
                    data-ph-prop-tier-name={ticket.name}
                    data-ph-prop-tier-price={euro(ticket.price)}
                  >
                    {fillLabel(included.ticketBuyLabel, {
                      ticket: ticket.name,
                    })}
                    <span class="t-btn-arrow" aria-hidden="true">
                      <IconArrowRight />
                    </span>
                  </a>

                  <div class="t-benefits">
                    {included.groups.map((group, gi) => (
                      <section class="t-group">
                        <h4 class="t-group-title">{group.heading}</h4>
                        <ul class="t-rows" role="list">
                          {group.rows.map((row, ri) => {
                            const status = statusOf(group, row, ticket.key);
                            return (
                              <li
                                class="t-row"
                                data-tone={status}
                                style={`--i: ${rowStart[gi] + ri}`}
                              >
                                <TicketStatus
                                  positive={isPositive(status)}
                                  label={statusLabel(status, included)}
                                />
                                <span class="t-row-label">{row.label}</span>
                              </li>
                            );
                          })}
                        </ul>
                      </section>
                    ))}
                  </div>
                </article>
              </div>
            );
          })
        }
      </div>
    </div>
  </div>
</section>

<style>
  /* DESIGN.md TICKETS-1: the picker list and the light ticket card. */
  .t-included {
    padding-block: clamp(var(--space-xl), 8vw, 6rem)
      clamp(var(--space-lg), 5vw, 3.5rem);
  }

  .t-included-head {
    margin-bottom: clamp(var(--space-md), 3vw, var(--space-xl));
  }

  /* The list at the left, the card at the right (the card's column a
     little wider); on narrow screens one under the other. */
  .t-pick {
    display: grid;
    grid-template-columns: minmax(0, 0.92fr) minmax(0, 1.08fr);
    gap: clamp(var(--space-md), 4vw, 4rem);
    align-items: start;
  }

  /* The list stays in view beside a long card. */
  .t-choices {
    position: sticky;
    top: calc(var(--site-header-height, 4.5rem) + var(--space-md));
  }

  /* One grid for the column labels and every row, so names, prices and
     arrows line up down the list. */
  .t-choice-cols,
  .t-choice {
    display: grid;
    grid-template-columns:
      minmax(0, 1fr) minmax(3.75rem, auto) minmax(5.5rem, auto)
      1.25rem;
    column-gap: clamp(var(--space-xs), 1.8vw, var(--space-md));
    align-items: center;
    padding-inline: clamp(var(--space-sm), 1.6vw, var(--space-md));
  }

  /* One price column while nothing is discounted. */
  .is-single-price .t-choice-cols,
  .is-single-price .t-choice {
    grid-template-columns: minmax(0, 1fr) minmax(5.5rem, auto) 1.25rem;
  }

  .t-choice-cols {
    padding-bottom: var(--space-2xs);
    color: color-mix(in srgb, var(--color-white) 62%, transparent);
    font-size: var(--text-size-tiny);
    font-weight: var(--font-weight-extrabold);
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .t-choice-cols > span:nth-child(2),
  .t-choice-cols > span:nth-child(3) {
    text-align: right;
  }

  .t-choice-list {
    position: relative;
    display: grid;
    gap: 0.25rem;
    border-top: 1px solid;
    border-image: linear-gradient(
        90deg,
        transparent,
        color-mix(in srgb, var(--color-white) 18%, transparent) 15%,
        color-mix(in srgb, var(--color-white) 18%, transparent) 85%,
        transparent
      )
      1;
    padding-top: 0.35rem;
  }

  /* The lens: a light glass surface under the row picked, gliding to the
     next one (tickets.client.ts places it; position by transform). */
  .t-tab-lens {
    position: absolute;
    top: 0;
    left: 0;
    z-index: 0;
    width: var(--lens-w, 0);
    height: var(--lens-h, 0);
    border-radius: var(--radius-ticket-panel);
    background: linear-gradient(
      180deg,
      color-mix(in srgb, var(--color-ticket-ice) 22%, transparent),
      color-mix(in srgb, var(--color-ticket-ice) 9%, transparent)
    );
    box-shadow:
      inset 0 1px 1px color-mix(in srgb, var(--color-white) 55%, transparent),
      inset 0 0 0 1px
        color-mix(in srgb, var(--color-ticket-ice) 28%, transparent),
      0 14px 28px -18px var(--color-ticket-midnight);
    opacity: 0;
    pointer-events: none;
    translate: var(--lens-x, 0) var(--lens-y, 0);
    transition:
      translate var(--duration-open) var(--ease-emphasized),
      opacity var(--duration-ticket-color) var(--ease-snappy);
  }

  [data-lens-ready] > .t-tab-lens {
    opacity: 1;
  }

  [data-lens-instant] > .t-tab-lens {
    transition: none;
  }

  .t-choice {
    position: relative;
    z-index: 1;
    width: 100%;
    min-height: 4.75rem;
    padding-block: var(--space-xs);
    border: 0;
    border-radius: var(--radius-ticket-panel);
    background: transparent;
    color: var(--color-white);
    font: inherit;
    text-align: left;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
    transition: background-color var(--duration-ticket-color) var(--ease-snappy);
  }

  .t-choice-text {
    display: grid;
    gap: 0.2rem;
    min-width: 0;
  }

  .t-choice-name {
    font-size: clamp(1.25rem, 2vw, 1.6rem);
    font-weight: var(--font-weight-extrabold);
    letter-spacing: -0.025em;
    line-height: 1.1;
    transition: color var(--duration-ticket-color) var(--ease-snappy);
  }

  .t-choice-desc {
    color: color-mix(in srgb, var(--color-white) 70%, transparent);
    font-size: var(--text-size-small);
    line-height: 1.35;
  }

  .t-choice-was {
    color: color-mix(in srgb, var(--color-white) 58%, transparent);
    font-size: var(--text-size-small);
    font-variant-numeric: tabular-nums;
    font-weight: var(--font-weight-medium);
    text-align: right;
  }

  .t-choice-now {
    font-size: clamp(1.4rem, 2.3vw, 1.9rem);
    font-variant-numeric: tabular-nums;
    font-weight: var(--font-weight-extrabold);
    letter-spacing: -0.03em;
    line-height: 1;
    text-align: right;
    transition: color var(--duration-ticket-color) var(--ease-snappy);
  }

  .t-choice-arrow {
    width: 1.25rem;
    height: 1.25rem;
    opacity: 0.4;
    transition:
      opacity var(--duration-ticket-color) var(--ease-snappy),
      translate var(--duration-hover) var(--ease-snappy);
  }

  @media (hover: hover) {
    .t-choice:hover {
      background: color-mix(in srgb, var(--color-white) 6%, transparent);
    }

    .t-choice:hover .t-choice-arrow {
      opacity: 0.8;
      translate: 2px 0;
    }
  }

  .t-choice:focus-visible {
    outline: 2px solid var(--color-ticket-ice);
    outline-offset: 2px;
  }

  /* The row picked: name and price in ice, the arrow bright. */
  .t-choice[aria-selected="true"] .t-choice-name,
  .t-choice[aria-selected="true"] .t-choice-now {
    color: var(--color-ticket-ice);
  }

  .t-choice[aria-selected="true"] .t-choice-arrow {
    opacity: 1;
  }

  /* Before the lens is placed (and without JavaScript), the picked row
     still reads as picked. */
  .t-choice-list:not([data-lens-ready]) .t-choice[aria-selected="true"] {
    background: color-mix(in srgb, var(--color-ticket-ice) 12%, transparent);
  }

  .t-choice-foot {
    margin: var(--space-sm) 0 0;
    padding-inline: clamp(var(--space-sm), 1.6vw, var(--space-md));
    color: color-mix(in srgb, var(--color-white) 62%, transparent);
    font-size: var(--text-size-tiny);
    line-height: 1.5;
  }

  /* The cards: one under another without the script; with it they share
     one cell (as tall as the tallest) and only the picked one shows. */
  .t-panels {
    display: grid;
    gap: var(--space-xl);
  }

  [data-tabs-ready] .t-panels > .t-panel {
    grid-area: 1 / 1;
  }

  [data-tabs-ready] .t-panels > .t-panel[hidden] {
    display: block;
    visibility: hidden;
  }

  .t-panel {
    border-radius: var(--radius-ticket-card);
  }

  .t-panel:focus-visible {
    outline: 2px solid var(--color-ticket-ice);
    outline-offset: 6px;
  }

  /* ---- the light ticket card ---- */
  .t-detail {
    display: grid;
    gap: var(--space-sm);
    padding: clamp(var(--space-md), 3vw, 2.5rem);
    border-radius: var(--radius-ticket-card);
  }

  .t-detail-top {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-sm) var(--space-lg);
  }

  .t-detail-name {
    margin: 0;
    color: var(--color-navy);
    font-size: clamp(1.9rem, 3.4vw, 2.75rem);
    font-weight: var(--font-weight-extrabold);
    letter-spacing: -0.04em;
    line-height: 1.02;
  }

  .t-detail-desc {
    /* Always two lines high, so every ticket's card is the same size. */
    min-height: calc(2 * 1.45em);
    margin: var(--space-2xs) 0 0;
    color: color-mix(in srgb, var(--color-navy) 74%, transparent);
    font-size: var(--text-size-small);
    line-height: 1.45;
  }

  .t-detail-price {
    display: grid;
    justify-items: end;
    gap: 0.35rem;
    text-align: right;
  }

  .t-detail-now {
    margin: 0;
    color: var(--color-navy);
    font-size: clamp(2.75rem, 5vw, 3.75rem);
    font-variant-numeric: tabular-nums;
    font-weight: var(--font-weight-extrabold);
    letter-spacing: -0.05em;
    line-height: 0.95;
  }

  .t-detail-was {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 0.25rem var(--space-xs);
    margin: 0;
    color: color-mix(in srgb, var(--color-navy) 72%, transparent);
    font-size: var(--text-size-small);
    font-weight: var(--font-weight-semibold);
  }

  .t-detail-was s {
    font-weight: var(--font-weight-medium);
  }

  .t-detail-save {
    padding: 0.1rem 0.55rem;
    border-radius: var(--radius-ticket-pill);
    background: var(--color-navy);
    color: var(--color-ticket-ice);
    font-size: var(--text-size-tiny);
    font-weight: var(--font-weight-extrabold);
    letter-spacing: 0.04em;
  }

  .t-detail-note {
    margin: 0;
    color: var(--color-ticket-q27);
    font-size: var(--text-size-small);
    font-weight: var(--font-weight-semibold);
  }

  /* A card without a requirement keeps its line, so every card is the
     same size. */
  .t-detail-note.is-empty {
    visibility: hidden;
  }

  .t-detail-buy {
    margin-top: var(--space-2xs);
  }

  /* The benefits: the groups flow down two balanced columns on a wide
     card (a group never splits), hairline rows, each a status mark (a
     navy check, a quiet dash) and its label; the status words are read
     out (TicketStatus) but not printed, the marks differ in shape, never
     by color alone. */
  .t-benefits {
    column-count: 2;
    column-gap: clamp(var(--space-md), 3vw, var(--space-xl));
    margin-top: var(--space-sm);
    padding-top: var(--space-md);
    border-top: 1px solid color-mix(in srgb, var(--color-navy) 12%, transparent);
  }

  .t-group {
    break-inside: avoid;
    padding-bottom: var(--space-md);
  }

  .t-group-title {
    margin: 0 0 0.35rem;
    color: var(--color-ticket-q27);
    font-size: var(--text-size-tiny);
    font-weight: var(--font-weight-extrabold);
    letter-spacing: 0.12em;
    line-height: 1.3;
    text-transform: uppercase;
  }

  .t-rows {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .t-row {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: start;
    gap: var(--space-xs);
    padding-block: 0.45rem;
    border-top: 1px solid color-mix(in srgb, var(--color-navy) 8%, transparent);
    color: var(--color-navy);
    font-size: var(--text-size-small);
    line-height: 1.4;
  }

  .t-row:first-child {
    border-top: 0;
  }

  .t-row :global(.t-status) {
    padding-top: 0.05rem;
  }

  .t-row :global([data-status-label]) {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .t-row :global(.t-status-icon) {
    width: 1.25rem;
    height: 1.25rem;
    background: var(--color-navy);
    color: var(--color-white);
  }

  .t-row :global(.t-status[data-positive="false"] .t-status-icon) {
    background: transparent;
    box-shadow: inset 0 0 0 1px
      color-mix(in srgb, var(--color-navy) 30%, transparent);
    color: color-mix(in srgb, var(--color-navy) 50%, transparent);
  }

  .t-row[data-tone="not-included"] .t-row-label,
  .t-row[data-tone="not-required"] .t-row-label {
    color: color-mix(in srgb, var(--color-navy) 52%, transparent);
  }

  /*
   * Switching tickets (DESIGN.md MOTION-6): the card picked comes in from
   * the list's side (tickets.client.ts, Web Animations, interruptible),
   * then the rows follow in a quick cascade (--i) while each status mark
   * pops into place. Transform and opacity only, under half a second; the
   * fill is backwards only, so nothing is left on a layer of its own.
   */
  @media (prefers-reduced-motion: no-preference) {
    [data-tabs-ready] .t-panel:not([hidden]) .t-row {
      animation: t-row-in var(--duration-ticket-enter) var(--ease-emphasized)
        backwards;
      animation-delay: calc(var(--i, 0) * var(--duration-ticket-stagger));
    }

    [data-tabs-ready] .t-panel:not([hidden]) .t-row :global(.t-status-icon) {
      animation: t-icon-pop var(--duration-ticket-enter) var(--ease-emphasized)
        backwards;
      animation-delay: calc(
        var(--i, 0) * var(--duration-ticket-stagger) +
          var(--duration-ticket-press)
      );
    }
  }

  @keyframes t-row-in {
    from {
      opacity: 0;
      transform: translateX(-10px);
    }
  }

  @keyframes t-icon-pop {
    0% {
      opacity: 0;
      transform: scale(0.4);
    }

    60% {
      opacity: 1;
      transform: scale(1.12);
    }

    100% {
      opacity: 1;
      transform: scale(1);
    }
  }

  /* Tablets and phones: the list over the card, the list no longer
     sticky. */
  @media (max-width: 959px) {
    .t-pick {
      grid-template-columns: minmax(0, 1fr);
    }

    .t-choices {
      position: static;
    }
  }

  @media (max-width: 599px) {
    .t-benefits {
      column-count: 1;
    }

    .t-choice-cols,
    .t-choice {
      grid-template-columns: minmax(0, 1fr) auto auto 1rem;
      column-gap: var(--space-xs);
      padding-inline: var(--space-xs);
    }

    .is-single-price .t-choice-cols,
    .is-single-price .t-choice {
      grid-template-columns: minmax(0, 1fr) auto 1rem;
    }

    .t-choice {
      min-height: 4.25rem;
    }

    .t-choice-desc {
      font-size: var(--text-size-tiny);
    }

    .t-detail-top {
      align-items: flex-start;
    }

    .t-detail-price {
      justify-items: start;
      text-align: left;
    }

    .t-detail-was {
