---
/**
 * Shared FAQ accordion for program + hackathon (not home: home keeps its
 * own layout). Native details/summary; FAQPage JSON-LD from visible Q&A.
 *
 * headerAlign: "left" matches live program FAQ; "center" uses SectionHeader
 * (hackathon).
 */
import type { Faq } from "../../lib/content";
import { buildFaqPageJsonLd } from "../../lib/faq-json-ld";
import JsonLd from "../seo/JsonLd.astro";
import Section from "./Section.astro";
import Container from "./Container.astro";
import SectionHeader from "./SectionHeader.astro";
import IconChevron from "../icons/IconChevron.astro";

interface Props {
  heading: string;
  intro?: string;
  faqs: Faq[];
  headerAlign?: "left" | "center";
  headingId?: string;
}

const {
  heading,
  intro,
  faqs,
  headerAlign = "left",
  headingId = "faq-heading",
} = Astro.props;

const faqLd = buildFaqPageJsonLd(faqs);
---

{faqs.length > 0 && <JsonLd data={faqLd} />}
<Section aria-labelledby={headingId}>
  <Container>
    {
      headerAlign === "center" ? (
        <SectionHeader>
          <h2 id={headingId}>{heading}</h2>
          {intro && <p class="faq-intro">{intro}</p>}
        </SectionHeader>
      ) : (
        <div class="faq-header">
          <h2 id={headingId}>{heading}</h2>
          {intro && <p class="faq-intro">{intro}</p>}
        </div>
      )
    }

    <div class="faq-list">
      {
        faqs.map((faq) => (
          <details class="faq-item">
            <summary class="u-accordion-summary">
              <span class="question">{faq.question}</span>
              <span class="chevron" aria-hidden="true">
                <IconChevron />
              </span>
            </summary>
            <div class="answer" set:html={faq.answerHtml} />
          </details>
        ))
      }
    </div>
  </Container>
</Section>

<style>
  .faq-header {
    max-width: var(--container-small);
    margin-bottom: 5rem;
  }

  .faq-header h2 {
    margin-bottom: var(--space-sm);
  }

  .faq-intro {
    margin: 0;
    font-size: var(--text-size-medium);
  }

  .faq-list {
    border-bottom: 1px solid var(--color-neutral-lighter);
  }

  /* Box, marker reset and padding come from .u-accordion-summary
     (global.css, DESIGN.md COMP-3); only this accordion's hairline is local. */
  .faq-item summary {
    border-top: 1px solid var(--color-neutral-lighter);
  }

  .question {
    font-size: var(--text-size-medium);
    font-weight: var(--heading-weight);
  }

  .chevron {
    display: flex;
    flex-shrink: 0;
    align-self: flex-start;
    width: 2rem;
    transition: transform var(--duration-icon) var(--ease-snappy);
  }

  /* :global, because the svg is rendered by IconChevron and so carries that
     component's scope, not this one's. */
  .chevron :global(svg) {
    width: 100%;
    height: auto;
  }

  .faq-item[open] .chevron {
    transform: rotate(180deg);
  }

  .answer {
    max-width: var(--container-small);
    padding-bottom: var(--space-md);
  }

  .answer :global(p) {
    margin: 0 0 var(--space-sm);
  }

  .answer :global(p:last-child) {
    margin-bottom: 0;
  }

  @media (max-width: 767px) {
    .faq-header {
      margin-bottom: var(--space-xl);
    }

    .faq-item summary {
      padding-block: var(--space-sm);
    }

    .chevron {
      width: 1.75rem;
    }
  }
</style>
