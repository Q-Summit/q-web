---
// Compare tickets (DESIGN.md TICKETS-1): two pickers, two columns, one row
// per benefit, laid out like a product spec sheet in the Q27 CI: navy ink,
// ice glass and hairline rows, with the same buy buttons as the cards.
//
// The static HTML is the first ticket against Start-Up (the 2027 PDF's
// default pair), complete without JavaScript; the pickers stay disabled
// until tickets.client.ts takes over and re-fills both columns from the
// embedded ticket model (ticket-model.clientData) on every change. A
// ticket already shown in one column is disabled in the other picker, so
// the two columns never silently show the same ticket.
import "./ticket-theme.css";
import type { TicketCategoriesContent } from "../../lib/content";
import { EVENTS } from "../../lib/analytics/events";
import IconArrowRight from "../icons/IconArrowRight.astro";
import IconCheck from "../icons/IconCheck.astro";
import IconChevron from "../icons/IconChevron.astro";
import TicketStatus from "./TicketStatus.astro";
import {
  clientData,
  euro,
  salePriceLabel,
  isPositive,
  statusLabel,
  statusOf,
} from "./ticket-model";

interface Props {
  page: TicketCategoriesContent;
}

const { page } = Astro.props;
const priceLabel = salePriceLabel(page.phases);
const { offer, included, compare } = page;
const tickets = offer.tickets;
const firstTicket = tickets[0];
const secondTicket =
  tickets.find((t) => t.key === "start-up" && t.key !== firstTicket.key) ??
  tickets[1];
const columns = [
  { ticket: firstTicket, label: compare.firstLabel },
  { ticket: secondTicket, label: compare.secondLabel },
];

// JSON inside <script>: escape "<" so no value can close the element.
const payload = JSON.stringify(clientData(page)).replace(/</g, "\\u003c");
---

<section
  class="t-compare t-anchor"
  id="compare"
  aria-labelledby="compare-title"
  data-ticket-compare
>
  <script
    type="application/json"
    is:inline
    data-ticket-data
    set:html={payload}
  />
  <div class="t-shell">
    <div class="t-sheet">
      <div class="t-cmp-pickers">
        <header class="t-compare-head">
          <h2
            id="compare-title"
            class="t-compare-title"
            data-lp="compare.heading"
          >
            {compare.heading}
          </h2>
          <p class="t-compare-intro" data-lp="compare.intro">
            {compare.intro}
          </p>
        </header>
        {
          columns.map(({ ticket, label }, col) => (
            <div class="t-cmp-col" data-col={col}>
              <span class="t-cmp-label" id={`cmp-label-${col}`}>
                {label}
              </span>
              <div class="t-select" data-picker={col} data-value={ticket.key}>
                <button
                  type="button"
                  class="t-select-field"
                  id={`cmp-select-${col}`}
                  aria-haspopup="listbox"
                  aria-expanded="false"
                  aria-controls={`cmp-list-${col}`}
                  aria-labelledby={`cmp-label-${col} cmp-select-${col}`}
                  data-picker-field
                  data-glass-press
                  disabled
                >
                  <span class="glass-light" aria-hidden="true" />
                  <span data-picker-value>{ticket.name}</span>
                  <span class="t-select-chevron" aria-hidden="true">
                    <IconChevron size={20} />
                  </span>
                </button>
                <ul
                  class="t-select-list"
                  id={`cmp-list-${col}`}
                  role="listbox"
                  aria-labelledby={`cmp-label-${col}`}
                  tabindex="-1"
                  data-picker-list
                  hidden
                >
                  {tickets.map((t, i) => (
                    <li
                      class="t-select-option"
                      style={`--i: ${i}`}
                      id={`cmp-opt-${col}-${t.key}`}
                      role="option"
                      data-value={t.key}
                      aria-selected={t.key === ticket.key ? "true" : "false"}
                      aria-disabled={
                        t.key === columns[1 - col].ticket.key
                          ? "true"
                          : undefined
                      }
                    >
                      <span>{t.name}</span>
                      <span class="t-select-check" aria-hidden="true">
                        <IconCheck size={16} />
                      </span>
                    </li>
                  ))}
                </ul>
              </div>
              <div class="t-cmp-ticket" data-swap={col}>
                <p class="t-cmp-price">
                  <span class="u-visually-hidden">{priceLabel} </span>
                  <span data-f="price">{euro(ticket.price)}</span>
                  <span class="u-visually-hidden"> Regular price </span>
                  <s data-f="regular">{euro(ticket.regularPrice)}</s>
                </p>
                <p class="t-cmp-desc" data-f="description">
                  {ticket.description}
                </p>
                <a
                  class="t-btn is-block"
                  href={offer.purchaseHref}
                  target="_blank"
                  rel="noopener noreferrer"
                  data-ticket-buy
                  data-f="buy"
                  data-ph-event={EVENTS.ticket_purchase_initiated}
                  data-ph-prop-tier-name={ticket.name}
                  data-ph-prop-tier-price={euro(ticket.price)}
                >
                  {offer.buyLabel}
                  <span class="u-visually-hidden" data-f="buy-name">
                    : {ticket.name}
                  </span>
                  <span class="t-btn-arrow" aria-hidden="true">
                    <IconArrowRight />
                  </span>
                </a>
              </div>
            </div>
          ))
        }
      </div>

      <div class="t-cmp-table" role="table" aria-labelledby="compare-title">
        <div class="t-cmp-names" role="rowgroup">
          <div class="t-cmp-name-row" role="row">
            <span class="t-cmp-name-cell is-corner" role="columnheader">
              <span class="u-visually-hidden">Benefit</span>
            </span>
            {
              columns.map(({ ticket }, col) => (
                <span
                  class="t-cmp-name-cell"
                  role="columnheader"
                  data-col={col}
                  data-f="name"
                >
                  {ticket.name}
                </span>
              ))
            }
          </div>
        </div>

        {
          included.groups.map((group, gi) => (
            <div class="t-cmp-group" role="rowgroup">
              <div class="t-cmp-group-row" role="row">
                <span class="t-cmp-group-cell" role="cell" aria-colspan="3">
                  <h3 class="t-cmp-group-title">{group.heading}</h3>
                </span>
              </div>
              {group.rows.map((row, ri) => (
                <div class="t-cmp-row" role="row">
                  <span class="t-cmp-row-label" role="rowheader">
                    {row.label}
                  </span>
                  {columns.map(({ ticket }, col) => {
                    const status = statusOf(group, row, ticket.key);
                    return (
                      <span
                        class="t-cmp-cell"
                        role="cell"
                        data-col={col}
                        data-cell={`${gi}.${ri}`}
                      >
                        <TicketStatus
                          positive={isPositive(status)}
                          label={statusLabel(status, included)}
                        />
                      </span>
                    );
                  })}
                </div>
              ))}
            </div>
          ))
        }
      </div>

      <p class="t-footnote" data-lp="offer.footnote">{offer.footnote}</p>
    </div>
  </div>
</section>

<style>
  /*
   * DESIGN.md TICKETS-1: the compare view. An ice band and a white glass
   * sheet, navy ink, hairline rows instead of boxes; glass kept quieter
   * than the cards so the comparison reads at a glance.
   */
  .t-compare {
    padding-block: clamp(2.5rem, 6vw, 4.5rem) clamp(4rem, 9vw, 7rem);
    background: linear-gradient(
      180deg,
      transparent 0,
      color-mix(in srgb, var(--color-ticket-ice) 35%, transparent) 9rem,
      color-mix(in srgb, var(--color-ticket-ice) 45%, transparent) 100%
    );
  }

  .t-sheet {
    padding: clamp(1.25rem, 4vw, var(--space-xl));
    border-radius: var(--radius-ticket-card);
    position: relative;
    isolation: isolate;
    /* A large liquid glass sheet, in the home Buy Now's material: clear at
       the top where the pickers sit, so the page light glows through,
       and a little denser further down so the rows read on a calm
       surface. Depth from light only: a lit top edge, a caustic cyan glow
       inside the lower edge, a specular rim (::after) and a soft shadow.
       The fill lives on ::before and has no backdrop blur (only the soft
       page light lies behind the sheet, and a blur this large was
       recomputed on every frame). The sheet itself must never get a
       backdrop-filter: it would become a backdrop root, and the sticky
       names inside it could then not blur the rows passing under them. */
    box-shadow:
      inset 0 1px 1px var(--color-white),
      inset 0 24px 40px -30px
        color-mix(in srgb, var(--color-white) 90%, transparent),
      inset 0 -40px 60px -50px
        color-mix(in srgb, var(--color-ticket-cyan) 70%, transparent),
      0 30px 60px -40px color-mix(in srgb, var(--color-navy) 35%, transparent);
    color: var(--color-navy);
  }

  .t-sheet::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    border-radius: inherit;
    background: linear-gradient(
      180deg,
      color-mix(in srgb, var(--color-white) 30%, transparent) 0,
      color-mix(in srgb, var(--color-white) 44%, transparent) 20rem,
      color-mix(in srgb, var(--color-white) 50%, transparent) 100%
    );
    pointer-events: none;
  }

  /* Wide screens: the opener sits in the label column, left of the
     pickers, like a spec sheet's title cell (LAYOUT-4 deviation, as
     TICKETS-1 allows). */
  .t-compare-head {
    align-self: start;
    padding-bottom: var(--space-sm);
  }

  .t-compare-title {
    margin: 0;
    color: var(--color-navy);
    font-size: clamp(2rem, 4.6vw, 3.25rem);
    font-weight: var(--font-weight-extrabold);
    letter-spacing: -0.035em;
    line-height: 1.05;
  }

  .t-compare-intro {
    margin: var(--space-xs) 0 0;
    color: color-mix(in srgb, var(--color-navy) 72%, transparent);
    font-size: var(--text-size-medium);
  }

  /* Three columns on wide screens: labels, first ticket, second ticket. */
  .t-cmp-pickers,
  .t-cmp-name-row,
  .t-cmp-row {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr) minmax(0, 1fr);
    column-gap: clamp(var(--space-sm), 3vw, 2.5rem);
  }

  .t-cmp-pickers {
    align-items: stretch;
    padding-bottom: var(--space-md);
  }

  .t-cmp-col {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
    min-width: 0;
  }

  .t-cmp-label {
    color: color-mix(in srgb, var(--color-navy) 72%, transparent);
    font-size: var(--text-size-tiny);
    font-weight: var(--font-weight-semibold);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  /*
   * Glass picker: a button that opens a listbox (WAI-ARIA select-only
   * pattern, tickets.client.ts), replacing the native select, whose open
   * list differed per browser: it flipped upward near the screen edge and,
   * on some phones, could not be closed without picking. This one always
   * opens downward (the page eases down first when the list would not fit),
   * closes on a second tap, a tap outside or Escape and keeps the previous
   * pick, and works the same on touch, mouse and keyboard.
   */
  .t-select {
    position: relative;
  }

  /* The sheet's specular rim, as on every glass part (ticket-theme.css). */
  .t-sheet::after {
    content: "";
    position: absolute;
    inset: 0;
    padding: 1px;
    border-radius: inherit;
    background: linear-gradient(
      150deg,
      color-mix(in srgb, var(--color-white) 95%, transparent) 0%,
      color-mix(in srgb, var(--color-white) 25%, transparent) 22%,
      transparent 45% 70%,
      color-mix(in srgb, var(--color-ticket-cyan) 60%, transparent) 88%,
      color-mix(in srgb, var(--color-white) 85%, transparent) 100%
    );
    pointer-events: none;
    -webkit-mask:
      linear-gradient(var(--color-black) 0 0) content-box,
      linear-gradient(var(--color-black) 0 0);
    -webkit-mask-composite: xor;
    mask:
      linear-gradient(var(--color-black) 0 0) content-box exclude,
      linear-gradient(var(--color-black) 0 0);
  }

  .t-select.is-open {
    z-index: 4;
  }

  .t-select-field {
    display: flex;
    align-items: center;
    width: 100%;
    min-height: 3rem;
    padding: 0.6rem 2.6rem 0.6rem 1.1rem;
    border: 0;
    position: relative;
    isolation: isolate;
    border-radius: var(--radius-ticket-button);
    /* Clear glass in the home Buy Now's material, on a light ground: a thin
       white fill over a light blur, a lit top edge, a caustic cyan glow
       inside the lower edge and a soft lift; navy ink. Pressing gives a
       little and lights up from the touch point (MOTION-6). */
    background: linear-gradient(
      180deg,
      color-mix(in srgb, var(--color-white) 55%, transparent) 0%,
      color-mix(in srgb, var(--color-white) 22%, transparent) 100%
    );
    box-shadow:
      inset 0 1px 1px var(--color-white),
      inset 0 0 0 1px color-mix(in srgb, var(--color-white) 55%, transparent),
      inset 0 -12px 18px -14px
        color-mix(in srgb, var(--color-ticket-cyan) 85%, transparent),
      0 0 0 1px color-mix(in srgb, var(--color-navy) 7%, transparent),
      0 10px 24px -14px color-mix(in srgb, var(--color-navy) 38%, transparent);
    color: var(--color-navy);
    -webkit-backdrop-filter: blur(8px) saturate(160%);
    backdrop-filter: blur(8px) saturate(160%);
    font: inherit;
    font-size: var(--text-size-medium);
    font-weight: var(--font-weight-extrabold);
    letter-spacing: -0.01em;
    text-align: start;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
    touch-action: manipulation;
    transition:
      box-shadow var(--duration-ticket-color) var(--ease-snappy),
      transform var(--duration-glass-release) var(--ease-glass-spring);
  }

  .t-select-field.is-pressed {
    transform: scale(0.98, 0.95);
    transition-duration:
      var(--duration-ticket-color), var(--duration-glass-press);
  }

  .t-select-field > [data-picker-value] {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .t-select-field:disabled {
    cursor: default;
  }

  .t-select-field:active,
  .t-select.is-open .t-select-field {
    box-shadow:
      inset 0 2px 5px color-mix(in srgb, var(--color-navy) 12%, transparent),
      0 0 0 1px color-mix(in srgb, var(--color-navy) 14%, transparent);
  }

  .t-select-chevron {
    position: absolute;
    top: 50%;
    right: 0.9rem;
    display: inline-flex;
    color: color-mix(in srgb, var(--color-navy) 72%, transparent);
    pointer-events: none;
    transform: translateY(-50%);
    transition: transform var(--duration-glass-unfold) var(--ease-emphasized);
  }

  .t-select.is-open .t-select-chevron {
    transform: translateY(-50%) rotate(180deg);
  }

  /*
   * The open list is glass and nothing else: one flat frosted tone, dense
   * and strongly blurred so nothing behind it shows through, a lit rim and
   * a faint lower edge. Always below the field.
   *
   * It unfolds out of the field (MOTION-6): it starts as a field-height
   * strip tucked under the field, clipped to that strip, and opens down
   * while it springs to full size and its shadow deepens; then the options
   * follow a few frames apart. Closing runs the same way back into the
   * field, faster, the options leaving first, and only fades at the very
   * end. Both directions are transitions on data-state, so a quick second
   * tap reverses mid-way, and the list is hidden only after the fold.
   * Scale is on the list alone, never on the compare columns.
   */
  .t-select-list {
    position: absolute;
    top: calc(100% + var(--space-2xs));
    right: 0;
    left: 0;
    z-index: 1;
    margin: 0;
    padding: 0.35rem;
    border-radius: var(--radius-ticket-panel);
    background: color-mix(in srgb, var(--color-white) 90%, transparent);
    box-shadow:
      inset 0 1px 1px var(--color-white),
      inset 0 0 0 1px color-mix(in srgb, var(--color-white) 70%, transparent),
      inset 0 -1px 1px color-mix(in srgb, var(--color-navy) 8%, transparent),
      0 0 0 1px color-mix(in srgb, var(--color-navy) 7%, transparent),
      0 26px 50px -22px color-mix(in srgb, var(--color-navy) 32%, transparent);
    list-style: none;
    clip-path: inset(0 0 calc(100% - 3rem) 0 round var(--radius-ticket-panel));
    opacity: 0;
    transform: translateY(calc(-1 * var(--space-sm))) scale(0.97, 0.9);
    transform-origin: top center;
    -webkit-backdrop-filter: blur(30px);
    backdrop-filter: blur(30px);
    transition:
      clip-path var(--duration-glass-fold) var(--ease-emphasized),
      transform var(--duration-glass-fold) var(--ease-emphasized),
      opacity calc(var(--duration-glass-fold) * 0.5) var(--ease-snappy)
        calc(var(--duration-glass-fold) * 0.5);
  }

  .t-select-list[data-state="open"] {
    clip-path: inset(0 round var(--radius-ticket-panel));
    opacity: 1;
    transform: none;
    transition:
      clip-path var(--duration-glass-unfold) var(--ease-emphasized),
      transform var(--duration-glass-unfold) var(--ease-glass-spring),
      opacity var(--duration-hover) var(--ease-snappy);
  }

  .t-select-list > .t-select-option {
    opacity: 0;
    transform: translateY(calc(-1 * var(--space-2xs)));
    transition:
      opacity var(--duration-glass-fold) var(--ease-snappy),
      transform var(--duration-glass-fold) var(--ease-snappy),
      background-color var(--duration-hover) var(--ease-snappy);
  }

  .t-select-list[data-state="open"] > .t-select-option {
    opacity: 1;
    transform: none;
    transition-duration:
      var(--duration-glass-unfold), var(--duration-glass-unfold),
      var(--duration-hover);
    transition-timing-function:
      var(--ease-emphasized), var(--ease-emphasized), var(--ease-snappy);
    transition-delay:
      calc(var(--duration-glass-stagger) * (var(--i, 0) + 2)),
      calc(var(--duration-glass-stagger) * (var(--i, 0) + 2)),
      calc(var(--duration-glass-stagger) * 0);
  }

  .t-select-list:focus {
    outline: none;
  }

  .t-select-option {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
    min-height: 2.75rem;
    padding: var(--space-2xs) var(--space-xs);
    border-radius: var(--radius-ticket-button);
    color: var(--color-navy);
    font-size: var(--text-size-regular);
    font-weight: var(--font-weight-semibold);
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
  }

  .t-select-check {
    display: inline-flex;
    margin-inline-start: auto;
    color: var(--color-navy);
    opacity: 0;
  }

  /* The picked ticket: a raised glass chip and a check, never a color. */
  .t-select-option[aria-selected="true"] {
    background-color: var(--color-white);
    box-shadow:
      inset 0 1px 1px var(--color-white),
      0 0 0 1px color-mix(in srgb, var(--color-navy) 8%, transparent),
      0 4px 10px -6px color-mix(in srgb, var(--color-navy) 30%, transparent);
    font-weight: var(--font-weight-extrabold);
  }

  .t-select-option[aria-selected="true"] .t-select-check {
    opacity: 1;
  }

  /* The keyboard's current option (aria-activedescendant): a quieter chip
     plus the focus ring while the list has keyboard focus. */
  .t-select-option.is-active:not([aria-selected="true"]) {
    background-color: color-mix(
      in srgb,
      var(--color-neutral-lightest) 80%,
      transparent
    );
    box-shadow: inset 0 1px 1px var(--color-white);
  }

  .t-select-list:focus-visible .t-select-option.is-active {
    outline: 2px solid var(--color-focus);
    outline-offset: -2px;
  }

  @media (hover: hover) {
    .t-select-option:not([aria-disabled="true"]):hover {
      background-color: color-mix(
        in srgb,
        var(--color-neutral-lightest) 80%,
        transparent
      );
    }

    .t-select-option[aria-selected="true"]:hover {
      background-color: var(--color-white);
    }
  }

  /* The ticket already shown in the other column. */
  .t-select-option[aria-disabled="true"] {
    color: color-mix(in srgb, var(--color-navy) 35%, transparent);
    cursor: not-allowed;
  }

  .t-cmp-ticket {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: var(--space-2xs);
    padding-top: var(--space-2xs);
  }

  /* Both buy buttons on one line, whatever the descriptions' length. */
  .t-cmp-ticket .t-btn {
    margin-top: auto;
  }

  /* A changed column settles in with a short fade; nothing moves. */
  @media (prefers-reduced-motion: no-preference) {
    .t-cmp-ticket.is-swapping,
    .t-cmp-cell.is-swapping,
    .t-cmp-name-cell.is-swapping {
      animation: t-cmp-swap var(--duration-ticket-swap) var(--ease-snappy);
    }
  }

  @keyframes t-cmp-swap {
    from {
      opacity: 0.25;
    }
  }

  .t-cmp-price {
    display: flex;
    align-items: baseline;
    gap: var(--space-2xs);
    margin: 0;
  }

  .t-cmp-price [data-f="price"] {
    color: var(--color-navy);
    font-size: clamp(2rem, 4vw, 2.6rem);
    font-weight: var(--font-weight-extrabold);
    letter-spacing: -0.04em;
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }

  .t-cmp-price s {
    color: color-mix(in srgb, var(--color-navy) 72%, transparent);
    font-size: var(--text-size-regular);
    font-weight: var(--font-weight-medium);
  }

  .t-cmp-desc {
    min-height: 2.9em;
    margin: 0 0 0.35rem;
    color: color-mix(in srgb, var(--color-navy) 72%, transparent);
    font-size: var(--text-size-small);
    line-height: 1.45;
  }

  /*
   * The compact name row: the only sticky part, so long lists keep each
   * column's ticket in view without a tall header covering the rows. It
   * stays inside the table and parks under the fixed header.
   */
  .t-cmp-names {
    position: sticky;
    /* Parks just under the floating site header (DESIGN.md COMP-6). */
    top: calc(var(--site-header-height, 4.5rem) + var(--space-2xs));
    z-index: 2;
    margin-inline: calc(-1 * clamp(var(--space-2xs), 1.5vw, var(--space-sm)));
    padding-inline: clamp(var(--space-2xs), 1.5vw, var(--space-sm));
    border-radius: var(--radius-ticket-panel);
    /* Transparent glass, like the hero's Compare tickets button and the
       discount timeline: barely any fill and no saturation boost, so the
       page shows through as it is. Rows pass under this bar, so its blur
       is a little stronger than the button's: just enough that their text
       never reads as a second line next to the names. The lit top edge, a
       fine caustic cyan line inside the lower edge, the bright rim
       (::after) and a soft cyan halo carry the glass; a soft shadow lifts
       it. */
    background: linear-gradient(
      180deg,
      color-mix(in srgb, var(--color-white) 16%, transparent),
      color-mix(in srgb, var(--color-white) 4%, transparent)
    );
    box-shadow:
      inset 0 1px 1px color-mix(in srgb, var(--color-white) 95%, transparent),
