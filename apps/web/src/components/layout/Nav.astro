---
// Site navigation. Link targets keep the live site's URL paths so existing
// inbound links keep working at cutover. Matches the live nav exactly: 7
// items, home reachable via the logo only (no Home/Tickets/Contact entries).
//
// Sticky on all viewports. Below 768px: hamburger + slide-down panel
// (progressive enhancement via nav-menu.client.ts). Desktop: horizontal list.
import { logoSrc } from "../../assets/media/brand";
import { getSiteSettings } from "../../lib/content";
import { normalizeInternalHref } from "../../lib/href";
import IconClose from "../icons/IconClose.astro";
import IconMenu from "../icons/IconMenu.astro";

const { nav } = await getSiteSettings();

// link.href comes from getSiteSettings() already run through
// normalizeInternalHref (astro.config.mjs pins trailingSlash: "always"), so
// this side has to go through the same normalization or the comparison below
// never matches (e.g. "/whyq" !== "/whyq/").
const currentPath = normalizeInternalHref(Astro.url.pathname);

// Exact match plus section prefix so sub-routes keep their parent highlighted
// (job detail pages under /job-listings/). Hrefs are trailing-slashed, so the
// prefix test cannot cross-match sibling paths ("/job" vs "/jobs").
const isCurrent = (href: string): boolean =>
  currentPath === href ||
  (href !== "/" && href.startsWith("/") && currentPath.startsWith(href));
---

<header class="site-header">
  <div class="container nav-inner">
    <a class="brand" href="/">
      <img
        src={logoSrc}
        alt="Q-Summit home"
        width={40}
        height={40}
        loading="eager"
        decoding="async"
      />
    </a>
    <button
      type="button"
      class="nav-toggle"
      aria-expanded="false"
      aria-controls="site-nav"
      aria-label="Menu"
    >
      <span class="nav-toggle__icon nav-toggle__icon--menu">
        <IconMenu />
      </span>
      <span class="nav-toggle__icon nav-toggle__icon--close">
        <IconClose />
      </span>
    </button>
    <nav id="site-nav" aria-label="Main">
      <ul>
        {
          nav.map((link) => (
            <li>
              <a
                href={link.href}
                aria-current={isCurrent(link.href) ? "page" : undefined}
                data-astro-prefetch="hover"
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<script>
  import { initNavMenu } from "./nav-menu.client";

  document
    .querySelectorAll<HTMLElement>(".site-header:not([data-js])")
    .forEach((header) => {
      header.setAttribute("data-js", "true");
      initNavMenu(header);
    });
</script>

<style is:global>
  /* Scroll lock while the mobile drawer is open (class toggled in
     nav-menu.client.ts). Global so it can reach <html>. */
  html.is-nav-open {
    overflow: hidden;
  }
</style>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background-color: var(--color-background);
    border-bottom: 1px solid var(--color-neutral-lighter);
    view-transition-name: site-header;
  }

  .nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-md);
    padding-block: var(--space-md);
  }

  .brand {
    display: inline-block;
    line-height: 0;
  }

  .nav-toggle {
    display: none;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    margin: 0;
    padding: 0;
    border: none;
    background: transparent;
    color: var(--color-text);
    cursor: pointer;
    border-radius: var(--radius-button-small);
  }

  .nav-toggle:focus-visible {
    outline: 2px solid var(--color-focus);
    outline-offset: 2px;
  }

  .nav-toggle__icon {
    display: flex;
    width: 1.5rem;
    height: 1.5rem;
  }

  .nav-toggle__icon :global(svg) {
    width: 100%;
    height: 100%;
  }

  .nav-toggle__icon--close {
    display: none;
  }

  .site-header[data-open] .nav-toggle__icon--menu {
    display: none;
  }

  .site-header[data-open] .nav-toggle__icon--close {
    display: flex;
  }

  nav ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs) 1.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  nav a {
    color: var(--color-text);
    text-decoration: none;
    font-size: var(--text-size-regular);
    font-weight: var(--font-weight-medium);
  }

  nav a[aria-current="page"] {
    color: var(--color-primary);
  }

  @media (hover: hover) {
    nav a:hover {
      color: var(--color-primary);
    }
  }

  /* Mobile: hamburger + full-width panel under the bar. */
  @media (max-width: 767px) {
    .nav-toggle {
      display: inline-flex;
      margin-left: auto;
    }

    nav {
      display: none;
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      z-index: 1;
      background-color: var(--color-background);
      border-bottom: 1px solid var(--color-neutral-lighter);
      /* Match .container horizontal inset; panel itself is full-bleed. */
      padding: var(--space-sm) var(--padding-global) var(--space-md);
      max-height: min(70vh, calc(100dvh - 4.5rem));
      overflow-y: auto;
    }

    .site-header[data-open] nav {
      display: block;
    }

    nav ul {
      flex-direction: column;
      flex-wrap: nowrap;
      gap: 0;
    }

    nav a {
      display: flex;
      align-items: center;
      min-height: 2.75rem;
      padding-block: 0.625rem;
    }
  }

  @media (min-width: 768px) {
    .nav-toggle {
      display: none;
    }

    nav {
      display: block;
    }
  }
</style>
