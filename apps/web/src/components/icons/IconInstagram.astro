---
// Official Instagram camera glyph from simple-icons (CC0-1.0), never the
// wordmark and never recolored to orange. The path is inlined at Astro
// build time, so there is no runtime or CDN dependency. Single
// nonzero-winding path, fill=currentColor; the parent link carries the
// accessible name (aria-hidden here).
import { siInstagram } from "simple-icons";
---

<svg
  viewBox="0 0 24 24"
  fill="currentColor"
  aria-hidden="true"
  focusable="false"
>
  <path d={siInstagram.path}></path>
</svg>
