---
// /past-teams: the team history page ported from the live Webflow site.
// Same hero as /our-team, then the Current Team / History toggle and both
// team panels (see components/team/TeamPanels.astro): rendering both
// datasets on both team routes is what lets the toggle switch instantly,
// client-side, instead of a full page navigation.
import Base from "../layouts/Base.astro";
import {
  getPageContent,
  getPastTeamPhotos,
  getSiteSettings,
  getTeam,
} from "../lib/content";
import { groupDivisions, groupPastYears } from "../lib/team";
import TeamHero from "../components/team/TeamHero.astro";
import { teamHeroSources } from "../lib/team-media";
import TeamPanels from "../components/team/TeamPanels.astro";
import "../components/ui/navy-glass.css";

const [{ ourTeam, pastTeams }, { siteTitle }, team, pastTeamPhotos] =
  await Promise.all([
    getPageContent(),
    getSiteSettings(),
    getTeam(),
    getPastTeamPhotos(),
  ]);

const divisions = groupDivisions(team);
const pastYears = await groupPastYears(pastTeamPhotos);

// Preload the team hero: it is the LCP element on this route, so the
// browser fetches the same srcset TeamHero.astro renders before it parses
// the page.
const hero = teamHeroSources(ourTeam.heroImage);
---

<Base
  title={pastTeams.title}
  description={pastTeams.metaDescription}
  preloadImage={hero.srcset ? undefined : hero.src}
  preloadImageSrcset={hero.srcset}
  preloadImageSizes="100vw"
  livePreviewGlobal="page-past-teams"
>
  <div class="n-page">
    <div class="n-ground" aria-hidden="true"></div>
    <TeamHero
      title={pastTeams.heading}
      lpTitle="heading"
      photo={ourTeam.heroImage}
    />
    <TeamPanels
      active="past"
      divisions={divisions}
      pastYears={pastYears}
      pastIntro={pastTeams.intro}
      labels={{
        currentTab: ourTeam.tabLabel,
        pastTab: pastTeams.tabLabel,
        divisionHeading: ourTeam.divisionHeading,
        yearHeading: pastTeams.yearHeading,
        photoAlt: pastTeams.photoAlt,
      }}
      currentTitle={`${siteTitle} | ${ourTeam.title}`}
      pastTitle={`${siteTitle} | ${pastTeams.title}`}
    />
    <div class="h-page-fade" aria-hidden="true"></div>
  </div>
</Base>
