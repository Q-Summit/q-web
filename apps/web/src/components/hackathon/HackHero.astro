---
// Q-Hack x Hacktoberfest 2026 hero, on the living violet ground
// (HackGround). Balanced around one action: the official co-brand logos,
// a compact display headline, the event facts line, and the apply link,
// sized from the viewport height so the button sits above the fold on
// common laptop screens (1280x720 and up).
//
// Logos are the official files, unmodified (Q-Hack lockup from the CI
// package, Hacktoberfest 2026 from hacktoberfest.com/brand), with clear
// space of at least the Hacktoberfest H height around them. On load a short
// pass of light runs behind them; the marks themselves never change.
//
// The MLH trust badge stays, recreated locally (no third-party request).
import type { PageLink } from "../../lib/content";
import {
  hacktoberfestLogoWhite,
  qHackLogoWhite,
} from "../../assets/media/hackathon";
import HackApply from "./HackApply.astro";
import "./hack-light.css";

interface Props {
  headline: string;
  tagline?: string;
  cta: PageLink | undefined;
}

const { headline, tagline, cta } = Astro.props;

const mlhHref =
  "https://mlh.io/na?utm_source=na-hackathon&utm_medium=TrustBadge&utm_campaign=2026-season&utm_content=blue";
---

<header class="hero" data-hack-ground-zone>
  <a
    class="mlh-badge"
    href={mlhHref}
    target="_blank"
    rel="noopener noreferrer"
    aria-label="Major League Hacking, official 2026 season (opens in a new tab)"
  >
    <span class="mlh-badge-mark">MLH</span>
    <span class="mlh-badge-caption">Official<br />2026 Season</span>
  </a>

  <div class="container hero-content" data-reveal="rise" data-reveal-now>
    <p class="co-brand">
      <span class="co-brand-logo is-qhack" data-reveal="logo">
        <img
          src={qHackLogoWhite.src}
          width={qHackLogoWhite.width}
          height={qHackLogoWhite.height}
          alt="Q-Hack, University of Mannheim"
          fetchpriority="high"
          decoding="async"
        />
      </span>
      <span class="co-brand-x" aria-hidden="true">×</span>
      <span class="u-visually-hidden">and</span>
      <span class="co-brand-logo is-hacktoberfest" data-reveal="logo">
        <img
          src={hacktoberfestLogoWhite.src}
          width={hacktoberfestLogoWhite.width}
          height={hacktoberfestLogoWhite.height}
          alt="Hacktoberfest 2026"
          decoding="async"
        />
      </span>
    </p>

    <h1 data-lp="hero.headline">{headline}</h1>

    {
      tagline && (
        <p class="hero-tagline" data-lp="hero.tagline">
          {tagline}
        </p>
      )
    }

    {
      cta && (
        <div class="hero-apply">
          <HackApply cta={cta} placement="hero" />
        </div>
      )
    }
  </div>
</header>

<style>
  /* Campaign masthead (DESIGN.md HACK-1): transparent over the ground, no
     .section rhythm, a display headline above the h1 scale. Height and
     type scale with the viewport height so the apply link stays above
     the fold. */
  .hero {
    position: relative;
    display: flex;
    align-items: center;
    min-height: calc(100svh - var(--hack-nav, 4rem));
    padding-block: clamp(2.5rem, 7svh, 5rem)
      clamp(var(--space-lg), 6svh, 4.5rem);
    color: var(--color-text-inverse);
  }

  .hero-content {
    position: relative;
    display: grid;
    justify-items: center;
    text-align: center;
  }

  /* Co-brand row. Gaps are at least the Hacktoberfest H height (the
     logo's cap height is nearly its full height), per its brand kit. */
  .co-brand {
    --mark-h: clamp(1.45rem, min(2.4vw, 3.6svh), 2.35rem);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: var(--mark-h) calc(var(--mark-h) * 1.15);
    margin: 0 0 clamp(var(--space-md), 5svh, var(--space-xl));
  }

  .co-brand-logo {
    display: block;
    padding: calc(var(--mark-h) * 0.25);
    --hack-sweep-color: var(--color-hack-haze);
  }

  .co-brand-logo img {
    display: block;
    width: auto;
  }

  .co-brand-logo.is-qhack img {
    height: calc(var(--mark-h) * 1.75);
  }

  .co-brand-logo.is-hacktoberfest img {
    height: var(--mark-h);
  }

  .co-brand-x {
    font-size: var(--text-size-large);
    font-weight: var(--font-weight-light);
    opacity: 0.85;
  }

  /* The campaign's compact display headline (DESIGN.md HACK-1 deviating
     from TYPE-1), sized by width and height so two lines always fit. */
  .hero h1 {
    max-width: 16ch;
    margin: 0;
    color: var(--color-text-inverse);
    font-size: clamp(2.4rem, min(7.2vw, 10.5svh), 6.5rem);
    font-weight: var(--heading-weight-home);
    line-height: 0.95;
    letter-spacing: -0.02em;
    text-transform: uppercase;
    text-wrap: balance;
  }

  .hero-tagline {
    max-width: 46rem;
    margin: clamp(var(--space-sm), 2.6svh, var(--space-md)) 0 0;
    font-size: var(--text-size-large);
    font-weight: var(--font-weight-medium);
    color: color-mix(in srgb, var(--color-white) 90%, transparent);
    text-wrap: balance;
  }

  .hero-apply {
    width: 100%;
    margin-top: clamp(var(--space-md), 4.5svh, var(--space-xl));
  }

  /* MLH trust badge, white on the violet ground. */
  .mlh-badge {
    position: absolute;
    top: 0;
    right: var(--padding-global);
    z-index: 3;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    width: clamp(3.75rem, 7vw, 4.75rem);
    aspect-ratio: 5 / 6;
    padding: var(--space-2xs) 0.4rem var(--space-xs);
    background-color: var(--color-white);
    color: var(--color-hack-ink);
    text-align: center;
    text-decoration: none;
    clip-path: polygon(0 0, 100% 0, 100% 78%, 50% 100%, 0 78%);
  }

  .mlh-badge-mark {
    font-size: var(--text-size-regular);
    font-weight: var(--font-weight-extrabold);
    letter-spacing: 0.03em;
  }

  .mlh-badge-caption {
    margin-top: 0.25rem;
    /* Deliberate deviation from DESIGN.md TYPE-2: the caption is engraved
       into a 4.75rem clipped badge, and the smallest scale step
       (--text-size-tiny, 0.75rem) is 50% larger and overflows the shape.
       The live MLH badge sets this optically, not from the body scale. */
    font-size: 0.5rem;
    font-weight: var(--font-weight-semibold);
    line-height: 1.3;
    text-transform: uppercase;
    letter-spacing: 0.03em;
  }

  @media (max-width: 767px) {
    .hero {
      min-height: auto;
      padding-block: 5.5rem 3.5rem;
    }

    .co-brand {
      --mark-h: clamp(1.15rem, 5.2vw, 1.6rem);
      flex-direction: column;
      gap: calc(var(--mark-h) * 0.45);
    }

    .co-brand-x {
      font-size: var(--text-size-regular);
    }

    .hero h1 {
      font-size: clamp(2.3rem, 11.5vw, 3.6rem);
    }

    .hero-tagline {
      font-size: var(--text-size-medium);
    }
  }
</style>
