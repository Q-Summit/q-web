---
// Official YouTube brand mark from simple-icons (CC0-1.0). The path is
// inlined at Astro build time, so there is no runtime or CDN dependency.
// Single nonzero-winding path, fill=currentColor; the parent link carries
// the accessible name (aria-hidden here).
import { siYoutube } from "simple-icons";
---

<svg
  viewBox="0 0 24 24"
  fill="currentColor"
  aria-hidden="true"
  focusable="false"
>
  <path d={siYoutube.path}></path>
</svg>
